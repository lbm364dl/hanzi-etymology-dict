{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "existing_key",
          "kind",
          "title",
          "details",
          "verification",
          "evidence"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "existing_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "ocr",
              "factual",
              "readability",
              "pipeline",
              "clarification"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
