{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "repair_observations"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "disposition",
          "reason",
          "affected_paths"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "pending",
              "unresolved_identity_not_used",
              "applied_repair_scan_matches_corpus"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "affected_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "repair_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "observed_literal",
          "pixel_reason"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "observed_literal": {
            "type": "string",
            "minLength": 1
          },
          "pixel_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
