{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "identity_observations",
    "transcription_observations"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "disposition",
          "reason",
          "affected_paths"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "ziyuan-2012:75C5:cb48ac5062a1",
              "ziyuan-2012:75C5:9356cb410dd2"
            ]
          },
          "disposition": {
            "enum": [
              "pending",
              "unresolved_identity_not_used",
              "verified_transcription_matches_corpus"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "affected_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^article(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[\\d+\\])+$"
            }
          }
        }
      }
    },
    "identity_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "independent_support",
          "claim_paths",
          "support_reason",
          "whole_candidate_reviewed",
          "reviewed_article_hash",
          "reviewed_dossier_hash"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "ziyuan-2012:75C5:9356cb410dd2"
            ]
          },
          "independent_support": {
            "type": "boolean"
          },
          "whole_candidate_reviewed": {
            "type": "boolean"
          },
          "reviewed_article_hash": {
            "type": "string",
            "enum": [
              "0f58a42adfe4e92710f70b2d41822de5b3c3bef08bed60ffc4689bbcb25e1d69"
            ]
          },
          "reviewed_dossier_hash": {
            "type": "string",
            "enum": [
              "a825d66693b00e1169b893bc92fc1b39de05a36e3daa66c11727b751a1d2cb93"
            ]
          },
          "claim_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "article_path",
                "claim_text",
                "independent_evidence_ids"
              ],
              "properties": {
                "article_path": {
                  "type": "string",
                  "pattern": "^article(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[\\d+\\])+$"
                },
                "claim_text": {
                  "type": "string",
                  "minLength": 1
                },
                "independent_evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "support_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "transcription_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "observed_literal",
          "pixel_reason"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "ziyuan-2012:75C5:cb48ac5062a1"
            ]
          },
          "observed_literal": {
            "type": [
              "string",
              "null"
            ]
          },
          "pixel_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
