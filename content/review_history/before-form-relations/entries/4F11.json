{
  "character": "休",
  "summary": {
    "text": "休, “rest,” combines a person with a tree: someone pauses against the trunk in its shade. In the modern form the person is written 亻 beside 木. Both parts contribute to this scene; neither needs to be treated as a pronunciation cue.",
    "evidence_ids": [
      "E1",
      "E2",
      "E3",
      "X1"
    ]
  },
  "formation": {
    "type": "semantic",
    "text": "Person and tree jointly express resting.",
    "evidence_ids": [
      "E2",
      "E3"
    ]
  },
  "components": [
    {
      "form": "亻",
      "origin_form": "人",
      "roles": [
        "pictorial"
      ],
      "form_status": "variant",
      "text": "亻 is the left-side person form. It identifies the person resting beside the tree.",
      "evidence_ids": [
        "E1",
        "E2",
        "E3"
      ]
    },
    {
      "form": "木",
      "origin_form": "木",
      "roles": [
        "pictorial"
      ],
      "form_status": "preserved",
      "text": "木 supplies the tree and its shade. An early bent-top variant can resemble 禾, but remains the tree component.",
      "evidence_ids": [
        "X1"
      ]
    }
  ],
  "history": [
    {
      "text": "Early versions place the person’s back toward the trunk. Sometimes the tree’s upper stroke bends over the person, emphasizing the shelter of its shade. The scene is therefore more specific than two unrelated objects placed side by side.",
      "evidence_ids": [
        "X1"
      ]
    }
  ],
