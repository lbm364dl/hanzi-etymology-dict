{
  "character": "木",
  "summary": {
    "text": "木 means “tree” or “wood.” It began as a drawing of a whole tree, with branches spreading above and roots below. The modern strokes retain that outline in a more regular form; the character is best understood as one picture.",
    "evidence_ids": [
      "E2",
      "E4",
      "E6"
    ]
  },
  "formation": {
    "type": "pictographic",
    "text": "A whole-tree pictograph, without a separate sound component.",
    "evidence_ids": [
      "E2",
      "E4"
    ]
  },
  "components": [
    {
      "form": "木",
      "origin_form": "木",
      "roles": [
        "pictorial"
      ],
      "form_status": "stylized",
      "text": "The branching top and spreading roots belong to a single tree outline. They are parts of the drawing, not independently meaningful characters.",
      "evidence_ids": [
        "E4",
        "X1"
      ]
    }
  ],
  "history": [
    {
      "text": "An older analysis splits off the upper part as 屮, a plant shoot. That division mistakes a similar shape for a separate component: the early tree drawing is complete in itself.",
      "evidence_ids": [
        "E3",
        "X1"
      ]
    }
  ],
