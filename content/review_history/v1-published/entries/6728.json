{
  "character": "木",
  "summary": {
    "text": "木 means “tree” or “wood” and is explained as a picture of a tree. Its strokes preserve a compact outline: branches above and roots below. Thinking of the whole shape as a tree gives a direct connection between the written form and its meaning.",
    "evidence_ids": [
      "E1",
      "E2",
      "E4",
      "E6"
    ]
  },
  "history": [
    {
      "text": "Wiktionary describes the branches and roots as easier to recognize in earlier forms. The Shuowen also identifies the lower part with roots. Together these accounts explain why the lower spreading strokes belong to the tree picture rather than to a separate component.",
      "evidence_ids": [
        "E3",
        "E4"
      ]
    }
  ],
  "uncertainties": [],
