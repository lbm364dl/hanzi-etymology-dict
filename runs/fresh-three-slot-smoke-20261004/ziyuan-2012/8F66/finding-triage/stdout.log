lot-smoke-20261004/ziyuan-2012/8F66/initial-followup/dossier.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/initial-followup/glyph_candidates.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/finding-triage/schema.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/finding-triage/meta.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/finding-triage/stderr.log\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/finding-triage/prompt.txt\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/finding-triage/agent-schema.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/finding-triage/stdout.log\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/schema.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/prompt.txt\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/meta.json\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/stderr.log\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/stdout.log\nruns/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/agent-schema.json\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66')\nfor n in ['dossier.json','source_dossier.json','source_findings.json','source_audit.json','refine_input_dossier.json','source_article.json','refine_input_article.json','status.json','source_feedback.json']:\n d=json.loads((p/n).read_text())\n print('\\\\n###',n)\n if n in ['dossier.json','source_dossier.json','refine_input_dossier.json']:\n  print('keys',d.keys()); print(json.dumps(d,ensure_ascii=False,indent=2)[:12000])\n else: print(json.dumps(d,ensure_ascii=False,indent=2)[:5000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66')\nfor n in ['dossier.json','source_dossier.json','source_findings.json','source_audit.json','refine_input_dossier.json','source_article.json','refine_input_article.json','status.json','source_feedback.json']:\n d=json.loads((p/n).read_text())\n print('\\\\n###',n)\n if n in ['dossier.json','source_dossier.json','refine_input_dossier.json']:\n  print('keys',d.keys()); print(json.dumps(d,ensure_ascii=False,indent=2)[:12000])\n else: print(json.dumps(d,ensure_ascii=False,indent=2)[:5000])\nPY\"","aggregated_output":"\n### dossier.json\nkeys dict_keys(['character', 'evidence', 'context', 'external_research', 'glyph_research', 'glyph_assets'])\n{\n  \"character\": \"车\",\n  \"evidence\": [\n    {\n      \"id\": \"E1\",\n      \"source\": \"makemeahanzi\",\n      \"field\": \"hanzi.etymology_notes[0]\",\n      \"text\": \"Simplified form of 車, a cart with two wheels, seen from above\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E2\",\n      \"source\": \"dong_chinese\",\n      \"field\": \"hanzi.etymology_notes[1]\",\n      \"text\": \"Pictograph of a chariot. The simplified character 车 was adapted from the cursive form of the traditional character 車.\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E3\",\n      \"source\": \"wiktionary\",\n      \"field\": \"hanzi.etymology_notes[2]\",\n      \"text\": \"From cursive script of 車; compare 東 → 东.\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E4\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.definitions\",\n      \"text\": \"cart, vehicle; carry in cart\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E5\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.readings\",\n      \"text\": \"{\\\"cantonese\\\": \\\"ce1\\\", \\\"mandarin\\\": \\\"chē\\\"}\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E6\",\n      \"source\": \"makemeahanzi\",\n      \"field\": \"hanzi.etymology_notes[0]\",\n      \"text\": \"A cart with two wheels, seen from above\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E7\",\n      \"source\": \"dong_chinese\",\n      \"field\": \"hanzi.etymology_notes[1]\",\n      \"text\": \"Pictograph of a chariot.\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E8\",\n      \"source\": \"shuowen_jiezi\",\n      \"field\": \"hanzi.etymology_notes[2]\",\n      \"text\": \"輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E9\",\n      \"source\": \"wiktionary\",\n      \"field\": \"hanzi.etymology_notes[3]\",\n      \"text\": \"]\\nPictogram (象形) – originally a carriage seen from above. In the oracle bone script, there were large wheels on both sides and a central shaft at the front.\\nUnrelated to 倝 and 朝.\\nPerhaps a loan from an Indo-European language because the horse and chariot were introduced into China around 1200 BC from Inner Asia; compare Tocharian A kukäl, Tocharian B kokale (“wagon; cart”) (Mair, 1990, Bauer, 1994), from Proto-Tocharian *kuk(ä)le, from Proto-Indo-European *kʷékʷlos, a form of *kʷel- (“to turn”). Cognate with English wheel, Ancient Greek κύκλος (kúklos), Lithuanian kaklas (“neck”), etc.\\nSagart and Baxter (2025) specifically pinpoint descent from some reflex of Proto-Indo-Iranian *čakrám and update their 2014 reconstructions to *t.[qʰ]rA > chē and *[C.q]ra > jū. They also suppose that the variation of pronunciations could be attributed to separate borrowing events from Indo-Aryan and Iranian.\\nAn older variant survives in Mandarin 軲轆／轱辘 (gūlu, “wheel”) (Bauer, 1994). Alternatively, the word is a derivation by k-prefix from 舁 (OC *la, “to lift”) (Baxter and Sagart, 1998); compare the semantic parallel in Tibetan ཐེག་པ (theg pa, “vehicle; carriage”) (OC *kʰljaʔ, *kʰljas) and 居 (OC *kas) (Schuessler, 2007). Pronunciation 2 is traditionally regarded as the older pronunciation.\\nThe sense of lewd content is derived from 老司機 /老司机 (lǎosījī).\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E10\",\n      \"source\": \"shuowen_jiezi\",\n      \"field\": \"hanzi.shuowen.explanation\",\n      \"text\": \"輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E11\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.definitions\",\n      \"text\": \"cart, vehicle; carry in a cart; Kangxi radical 159\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E12\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.readings\",\n      \"text\": \"{\\\"cantonese\\\": \\\"ce1\\\", \\\"japanese_kun\\\": \\\"KURUMA\\\", \\\"japanese_on\\\": \\\"SHA KYO\\\", \\\"korean\\\": \\\"CHA KE\\\", \\\"mandarin\\\": \\\"chē\\\", \\\"tang\\\": \\\"*giu chia\\\", \\\"vietnamese\\\": \\\"xa\\\"}\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E13\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.historical_phonology\",\n      \"text\": \"[{\\\"gloss\\\": \\\"chariot\\\", \\\"gsr\\\": \\\"0074a\\\", \\\"middle_chinese\\\": \\\"tsyhae\\\", \\\"old_chinese\\\": \\\"*[t.qʰ](r)A\\\"}, {\\\"gloss\\\": \\\"chariot\\\", \\\"gsr\\\": \\\"0074a\\\", \\\"middle_chinese\\\": \\\"kjo\\\", \\\"old_chinese\\\": \\\"*C.q(r)a\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"*kʰlja\\\", \\\"source\\\": \\\"zhengzhang_wikt\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"*kla\\\", \\\"source\\\": \\\"zhengzhang_wikt\\\"}, {\\\"fanqie\\\": \\\"九魚\\\", \\\"middle_chinese_guangyun\\\": \\\"見開三C魚平\\\", \\\"source\\\": \\\"guangyun\\\"}, {\\\"fanqie\\\": \\\"尺遮\\\", \\\"middle_chinese_guangyun\\\": \\\"昌開三麻平\\\", \\\"source\\\": \\\"guangyun\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"kʰlja\\\", \\\"rhyme_group\\\": \\\"魚\\\", \\\"source\\\": \\\"zhengzhang\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"kla\\\", \\\"rhyme_group\\\": \\\"魚\\\", \\\"source\\\": \\\"zhengzhang\\\"}]\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E14\",\n      \"source\": \"kanjidic2_via_build_kanji\",\n      \"field\": \"kanji.definition\",\n      \"text\": \"Car\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E15\",\n      \"source\": \"kanjidic2_via_build_kanji\",\n      \"field\": \"kanji.readings\",\n      \"text\": \"{\\\"japanese_kun\\\": \\\"くるま\\\", \\\"japanese_on\\\": \\\"シャ\\\"}\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E16\",\n      \"source\": \"ids_analysis\",\n      \"field\": \"kanji.etymology_notes[4]\",\n      \"text\": \"Etymological analysis: pictographic\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"X-5c0577b71d57f19a425e\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"traditional 車 graphic history\",\n      \"text\": \"The database describes Shang oracle-bone forms as variable, sometimes depicting wheels, carriage body, axle, yoke, pole and crossbar; later forms retain selected features, producing the regular 車 form. It lists oracle-bone, bronze, Chu manuscript and seal-script evidence. This supports a pictorial graph, with reduction and stylization over time.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://chardb.iis.sinica.edu.tw/evolution.jsp?cid=23348\",\n      \"title\": \"漢字「車」：字形演變\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-c8c3bfc393ea59ebb382\",\n      \"source\": \"Chinese University of Hong Kong, Multi-function Chinese Character Database\",\n      \"field\": \"traditional 車 forms and early uses\",\n      \"text\": \"The database says oracle-bone and bronze forms vary and may depict the vehicle’s wheels, body, axle, yoke, pole and crossbar. It reports an oracle-bone use for a vehicle in Heji 11452 (“six vehicles”), another in Heji 11450 (“vehicles and horses”), and a place-name use in Heji 584. Bronze inscriptions use 車 for vehicles and also for war chariots. These are source-reported inscription readings; the supplied page does not give calendar dates for each quoted inscription.\",\n      \"record_character\": \"車\",\n      \"kind\": \"primary_evidence_report\",\n      \"url\": \"https://humanum.arts.cuhk.edu.hk/Lexis/lexi-mf/oraclePiece.php?piece=%E8%BB%8A&sub=1\",\n      \"title\": \"漢語多功能字庫 — 車\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-f19b5bd85c060e5423c3\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"traditional 車 graphic history\",\n      \"text\": \"The page distinguishes complex and simplified variants already present in Shang and Western Zhou writing, including complex and simpler forms in adjacent columns of the same Western Zhou inscription. It says the simpler 車 form had become the sole common form by the Eastern Zhou. This is a historical account of graphic variants, distinct from the much later modern simplified character 车.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://mdw.bnu.edu.cn/xsjl/xwgg/d77a2deba32b49d49b9a446b634844ad.htm\",\n      \"title\": \"从单个字符形体的简化看字形与繁简关系\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-7ef1e98e72d456939698\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"modern simplified 车 history\",\n      \"text\": \"The author identifies 车 as a cursive form of 車, attested by the Sui dynasty at the latest and continuing in later cursive writing, but says it did not become generally used as a standard character until adoption in the first simplified-character list. The formal 1956 reform resolution states that the first table of 230 simplified characters was to be used from 1 February 1956; the 1964 table lists 车 as a simplified component corresponding to 車. These records support the relationship, but do not show the calligraphic exemplars themselves on the inspected page.\",\n      \"record_character\": \"车\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://mdw.bnu.edu.cn/xsjl/xwgg/d77a2deba32b49d49b9a446b634844ad.htm\",\n      \"title\": \"从单个字符形体的简化看字形与繁简关系\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-466d0ff32f6ad74b285e\",\n      \"source\": \"Shuowen.org, online 說文解字\",\n      \"field\": \"traditional 車 definition and historical account\",\n      \"text\": \"The entry defines 車 as the general name for carriage body and wheels, calls it pictographic, and repeats the traditional claim that Xi Zhong made it in the Xia period. Duan Yucai’s annotation explains the graph as depicting a body, two wheels and an axle, while challenging the claim that Xi Zhong was the first inventor. Treat the Xia attribution as a transmitted historical account, not independent confirmation.\",\n      \"record_character\": \"車\",\n      \"kind\": \"historical_dictionary\",\n      \"url\": \"https://www.shuowen.org/view/9465\",\n      \"title\": \"說文解字「車」\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-d628f651812de6cc0343\",\n      \"source\": \"Taiwan Ministry of Education, Dictionary of Chinese Character Variants\",\n      \"field\": \"modern and historical senses; readings\",\n      \"text\": \"The dictionary records chē (ㄔㄜ) and jū (ㄐㄩ). It cites the basic vehicle sense and later extensions to wheeled machines, transporting by cart, a measure for cartloads, and the chess rook reading. It quotes examples from the Han shu, Nan shi, Tang, Song, Ming and Qing texts; these establish cited later uses, not the chronology of every semantic extension. Its entry gives 尺遮切 from Shuowen and lists Guangyun and Jiyun materials, including separate fish- and ma-rhyme entries.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://dict.variants.moe.edu.tw/dictView.jsp?ID=44266&powerMode=2\",\n      \"title\": \"[A04061] 車 — 教育部《異體字字典》\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-244d407ba653486c9b12\",\n      \"source\": \"Taiwan Ministry of Education, Revised Mandarin Chinese Dictionary\",\n      \"field\": \"modern Mandarin senses\",\n      \"text\": \"The entry gives the standard Mandarin reading chē and describes vehicles, rotating machinery, machine sewing or cutting, and a measure for cartloads; it also lists jū as another reading. This is modern lexicographic evidence, not a dated account of when each sense arose.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://dict.concised.moe.edu.tw/dictView.jsp?ID=31626&la=0&powerMode=0\",\n      \"title\": \"《國語辭典簡編本》：車\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-f3dead1c5135199c4bf6\",\n      \"source\": \"Wiktionary, citing Baxter–Sagart historical phonology data\",\n      \"field\": \"traditional 車 readings and reconstructions\",\n      \"text\": \"For the two readings, the page reports Mandarin chē with Middle Chinese tsyhae and Baxter–Sagart Old Chinese *[t.qʰ](r)A, and Mandarin jū with Middle Chi\n\n### source_dossier.json\nkeys dict_keys(['character', 'evidence', 'context', 'external_research', 'glyph_research', 'glyph_assets'])\n{\n  \"character\": \"车\",\n  \"evidence\": [\n    {\n      \"id\": \"E1\",\n      \"source\": \"makemeahanzi\",\n      \"field\": \"hanzi.etymology_notes[0]\",\n      \"text\": \"Simplified form of 車, a cart with two wheels, seen from above\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E2\",\n      \"source\": \"dong_chinese\",\n      \"field\": \"hanzi.etymology_notes[1]\",\n      \"text\": \"Pictograph of a chariot. The simplified character 车 was adapted from the cursive form of the traditional character 車.\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E3\",\n      \"source\": \"wiktionary\",\n      \"field\": \"hanzi.etymology_notes[2]\",\n      \"text\": \"From cursive script of 車; compare 東 → 东.\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E4\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.definitions\",\n      \"text\": \"cart, vehicle; carry in cart\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E5\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.readings\",\n      \"text\": \"{\\\"cantonese\\\": \\\"ce1\\\", \\\"mandarin\\\": \\\"chē\\\"}\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E6\",\n      \"source\": \"makemeahanzi\",\n      \"field\": \"hanzi.etymology_notes[0]\",\n      \"text\": \"A cart with two wheels, seen from above\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E7\",\n      \"source\": \"dong_chinese\",\n      \"field\": \"hanzi.etymology_notes[1]\",\n      \"text\": \"Pictograph of a chariot.\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E8\",\n      \"source\": \"shuowen_jiezi\",\n      \"field\": \"hanzi.etymology_notes[2]\",\n      \"text\": \"輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E9\",\n      \"source\": \"wiktionary\",\n      \"field\": \"hanzi.etymology_notes[3]\",\n      \"text\": \"]\\nPictogram (象形) – originally a carriage seen from above. In the oracle bone script, there were large wheels on both sides and a central shaft at the front.\\nUnrelated to 倝 and 朝.\\nPerhaps a loan from an Indo-European language because the horse and chariot were introduced into China around 1200 BC from Inner Asia; compare Tocharian A kukäl, Tocharian B kokale (“wagon; cart”) (Mair, 1990, Bauer, 1994), from Proto-Tocharian *kuk(ä)le, from Proto-Indo-European *kʷékʷlos, a form of *kʷel- (“to turn”). Cognate with English wheel, Ancient Greek κύκλος (kúklos), Lithuanian kaklas (“neck”), etc.\\nSagart and Baxter (2025) specifically pinpoint descent from some reflex of Proto-Indo-Iranian *čakrám and update their 2014 reconstructions to *t.[qʰ]rA > chē and *[C.q]ra > jū. They also suppose that the variation of pronunciations could be attributed to separate borrowing events from Indo-Aryan and Iranian.\\nAn older variant survives in Mandarin 軲轆／轱辘 (gūlu, “wheel”) (Bauer, 1994). Alternatively, the word is a derivation by k-prefix from 舁 (OC *la, “to lift”) (Baxter and Sagart, 1998); compare the semantic parallel in Tibetan ཐེག་པ (theg pa, “vehicle; carriage”) (OC *kʰljaʔ, *kʰljas) and 居 (OC *kas) (Schuessler, 2007). Pronunciation 2 is traditionally regarded as the older pronunciation.\\nThe sense of lewd content is derived from 老司機 /老司机 (lǎosījī).\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E10\",\n      \"source\": \"shuowen_jiezi\",\n      \"field\": \"hanzi.shuowen.explanation\",\n      \"text\": \"輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E11\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.definitions\",\n      \"text\": \"cart, vehicle; carry in a cart; Kangxi radical 159\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E12\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.readings\",\n      \"text\": \"{\\\"cantonese\\\": \\\"ce1\\\", \\\"japanese_kun\\\": \\\"KURUMA\\\", \\\"japanese_on\\\": \\\"SHA KYO\\\", \\\"korean\\\": \\\"CHA KE\\\", \\\"mandarin\\\": \\\"chē\\\", \\\"tang\\\": \\\"*giu chia\\\", \\\"vietnamese\\\": \\\"xa\\\"}\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E13\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.historical_phonology\",\n      \"text\": \"[{\\\"gloss\\\": \\\"chariot\\\", \\\"gsr\\\": \\\"0074a\\\", \\\"middle_chinese\\\": \\\"tsyhae\\\", \\\"old_chinese\\\": \\\"*[t.qʰ](r)A\\\"}, {\\\"gloss\\\": \\\"chariot\\\", \\\"gsr\\\": \\\"0074a\\\", \\\"middle_chinese\\\": \\\"kjo\\\", \\\"old_chinese\\\": \\\"*C.q(r)a\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"*kʰlja\\\", \\\"source\\\": \\\"zhengzhang_wikt\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"*kla\\\", \\\"source\\\": \\\"zhengzhang_wikt\\\"}, {\\\"fanqie\\\": \\\"九魚\\\", \\\"middle_chinese_guangyun\\\": \\\"見開三C魚平\\\", \\\"source\\\": \\\"guangyun\\\"}, {\\\"fanqie\\\": \\\"尺遮\\\", \\\"middle_chinese_guangyun\\\": \\\"昌開三麻平\\\", \\\"source\\\": \\\"guangyun\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"kʰlja\\\", \\\"rhyme_group\\\": \\\"魚\\\", \\\"source\\\": \\\"zhengzhang\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"kla\\\", \\\"rhyme_group\\\": \\\"魚\\\", \\\"source\\\": \\\"zhengzhang\\\"}]\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E14\",\n      \"source\": \"kanjidic2_via_build_kanji\",\n      \"field\": \"kanji.definition\",\n      \"text\": \"Car\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E15\",\n      \"source\": \"kanjidic2_via_build_kanji\",\n      \"field\": \"kanji.readings\",\n      \"text\": \"{\\\"japanese_kun\\\": \\\"くるま\\\", \\\"japanese_on\\\": \\\"シャ\\\"}\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E16\",\n      \"source\": \"ids_analysis\",\n      \"field\": \"kanji.etymology_notes[4]\",\n      \"text\": \"Etymological analysis: pictographic\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"X-5c0577b71d57f19a425e\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"traditional 車 graphic history\",\n      \"text\": \"The database describes Shang oracle-bone forms as variable, sometimes depicting wheels, carriage body, axle, yoke, pole and crossbar; later forms retain selected features, producing the regular 車 form. It lists oracle-bone, bronze, Chu manuscript and seal-script evidence. This supports a pictorial graph, with reduction and stylization over time.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://chardb.iis.sinica.edu.tw/evolution.jsp?cid=23348\",\n      \"title\": \"漢字「車」：字形演變\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-c8c3bfc393ea59ebb382\",\n      \"source\": \"Chinese University of Hong Kong, Multi-function Chinese Character Database\",\n      \"field\": \"traditional 車 forms and early uses\",\n      \"text\": \"The database says oracle-bone and bronze forms vary and may depict the vehicle’s wheels, body, axle, yoke, pole and crossbar. It reports an oracle-bone use for a vehicle in Heji 11452 (“six vehicles”), another in Heji 11450 (“vehicles and horses”), and a place-name use in Heji 584. Bronze inscriptions use 車 for vehicles and also for war chariots. These are source-reported inscription readings; the supplied page does not give calendar dates for each quoted inscription.\",\n      \"record_character\": \"車\",\n      \"kind\": \"primary_evidence_report\",\n      \"url\": \"https://humanum.arts.cuhk.edu.hk/Lexis/lexi-mf/oraclePiece.php?piece=%E8%BB%8A&sub=1\",\n      \"title\": \"漢語多功能字庫 — 車\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-f19b5bd85c060e5423c3\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"traditional 車 graphic history\",\n      \"text\": \"The page distinguishes complex and simplified variants already present in Shang and Western Zhou writing, including complex and simpler forms in adjacent columns of the same Western Zhou inscription. It says the simpler 車 form had become the sole common form by the Eastern Zhou. This is a historical account of graphic variants, distinct from the much later modern simplified character 车.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://mdw.bnu.edu.cn/xsjl/xwgg/d77a2deba32b49d49b9a446b634844ad.htm\",\n      \"title\": \"从单个字符形体的简化看字形与繁简关系\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-7ef1e98e72d456939698\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"modern simplified 车 history\",\n      \"text\": \"The author identifies 车 as a cursive form of 車, attested by the Sui dynasty at the latest and continuing in later cursive writing, but says it did not become generally used as a standard character until adoption in the first simplified-character list. The formal 1956 reform resolution states that the first table of 230 simplified characters was to be used from 1 February 1956; the 1964 table lists 车 as a simplified component corresponding to 車. These records support the relationship, but do not show the calligraphic exemplars themselves on the inspected page.\",\n      \"record_character\": \"车\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://mdw.bnu.edu.cn/xsjl/xwgg/d77a2deba32b49d49b9a446b634844ad.htm\",\n      \"title\": \"从单个字符形体的简化看字形与繁简关系\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-466d0ff32f6ad74b285e\",\n      \"source\": \"Shuowen.org, online 說文解字\",\n      \"field\": \"traditional 車 definition and historical account\",\n      \"text\": \"The entry defines 車 as the general name for carriage body and wheels, calls it pictographic, and repeats the traditional claim that Xi Zhong made it in the Xia period. Duan Yucai’s annotation explains the graph as depicting a body, two wheels and an axle, while challenging the claim that Xi Zhong was the first inventor. Treat the Xia attribution as a transmitted historical account, not independent confirmation.\",\n      \"record_character\": \"車\",\n      \"kind\": \"historical_dictionary\",\n      \"url\": \"https://www.shuowen.org/view/9465\",\n      \"title\": \"說文解字「車」\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-d628f651812de6cc0343\",\n      \"source\": \"Taiwan Ministry of Education, Dictionary of Chinese Character Variants\",\n      \"field\": \"modern and historical senses; readings\",\n      \"text\": \"The dictionary records chē (ㄔㄜ) and jū (ㄐㄩ). It cites the basic vehicle sense and later extensions to wheeled machines, transporting by cart, a measure for cartloads, and the chess rook reading. It quotes examples from the Han shu, Nan shi, Tang, Song, Ming and Qing texts; these establish cited later uses, not the chronology of every semantic extension. Its entry gives 尺遮切 from Shuowen and lists Guangyun and Jiyun materials, including separate fish- and ma-rhyme entries.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://dict.variants.moe.edu.tw/dictView.jsp?ID=44266&powerMode=2\",\n      \"title\": \"[A04061] 車 — 教育部《異體字字典》\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-244d407ba653486c9b12\",\n      \"source\": \"Taiwan Ministry of Education, Revised Mandarin Chinese Dictionary\",\n      \"field\": \"modern Mandarin senses\",\n      \"text\": \"The entry gives the standard Mandarin reading chē and describes vehicles, rotating machinery, machine sewing or cutting, and a measure for cartloads; it also lists jū as another reading. This is modern lexicographic evidence, not a dated account of when each sense arose.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://dict.concised.moe.edu.tw/dictView.jsp?ID=31626&la=0&powerMode=0\",\n      \"title\": \"《國語辭典簡編本》：車\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-f3dead1c5135199c4bf6\",\n      \"source\": \"Wiktionary, citing Baxter–Sagart historical phonology data\",\n      \"field\": \"traditional 車 readings and reconstructions\",\n      \"text\": \"For the two readings, the page reports Mandarin chē with Middle Chinese tsyhae and Baxter–Sagart Old Chinese *[t.qʰ](r)A, and Mandarin jū with Middle Chi\n\n### source_findings.json\n{\n  \"source_id\": \"ziyuan-2012\",\n  \"tracking_issue_url\": \"https://github.com/lbm364dl/hanzi-etymology-dict/issues/344\",\n  \"requires_coordinator_verification\": true,\n  \"findings\": [\n    {\n      \"key\": \"ziyuan-2012:8F66:869956813d6e\",\n      \"kind\": \"ocr\",\n      \"title\": \"Verify 字源 scan finding for 8F66\",\n      \"details\": \"[SCAN VERIFICATION REQUIRED] 字源 PDF p.1260, printed p.1245, quoted occurrence beginning 郭沫若《卜辞通纂》：“二车字一作…”. The book scan visibly contains embedded rare glyph drawings in this quotation; their exact scalar identities cannot be established from the typography/OCR. The quotation’s surrounding discussion is legible, but do not replace the drawings with guessed Unicode.\",\n      \"verification\": \"Check the identified printed page and exact scan span; correct source-bound OCR or record an unresolved glyph identity.\",\n      \"evidence\": [\n        \"Source job: /home/catalin/hanzi-etymology-dict/runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66\",\n        \"Research output: initial-followup/research/result.json\"\n      ]\n    }\n  ]\n}\n\n### source_audit.json\n{\n  \"source_id\": \"ziyuan-2012\",\n  \"source_hash\": \"5d04edff24c3919be47596b6a79a61a85ce0a9637edc6fe35cfa1f612918a0fc\",\n  \"verified\": false,\n  \"citations\": [],\n  \"consulted_citations\": [\n    {\n      \"research_output\": \"initial-followup/research/result.json\",\n      \"research_receipt_hash\": \"37d207bd6ddf0af0ace56a81495c63ee9a33cc32c00db32f673d5fd1b2d79aec\",\n      \"research_result_hash\": \"868d40bb4be3d91bb2a4f7ba09f0485a6c8ecaf0f6dd4910164aa65b3ef9888e\",\n      \"source\": \"李學勤主編《字源》, 天津古籍出版社／遼寧人民出版社, 2012\",\n      \"field\": \"車部 entry; PDF p.1260, printed p.1245; scan /home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1260/source.png; inspected original pixels, including the 車 headword, historical-form rows, and paragraph\",\n      \"text\": \"The entry is headed 車(车), gives the readings chē and a traditional phonological classification, and labels 車 a 形聲字. It quotes 說文’s account of 車 as the collective name for vehicle body and wheels and as pictographic, then discusses changing depictions: some oracle-bone and late Shang/early Zhou bronze forms omit features, and a reduced form is analyzed as a wheel-and-axle depiction. Its forms row includes oracle-bone, bronze, 說文 small-seal, regular 車, and regular 车. The book’s account is a distinct, more detailed analysis than a simple uniformly pictographic description; retain attribution and the book’s stated uncertainty around individual forms.\",\n      \"evidence_ids\": [\n        \"X-5eed7aacb173bf712b8d\"\n      ]\n    }\n  ]\n}\n\n### refine_input_dossier.json\nkeys dict_keys(['character', 'evidence', 'context', 'external_research', 'glyph_research', 'glyph_assets'])\n{\n  \"character\": \"车\",\n  \"evidence\": [\n    {\n      \"id\": \"E1\",\n      \"source\": \"makemeahanzi\",\n      \"field\": \"hanzi.etymology_notes[0]\",\n      \"text\": \"Simplified form of 車, a cart with two wheels, seen from above\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E2\",\n      \"source\": \"dong_chinese\",\n      \"field\": \"hanzi.etymology_notes[1]\",\n      \"text\": \"Pictograph of a chariot. The simplified character 车 was adapted from the cursive form of the traditional character 車.\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E3\",\n      \"source\": \"wiktionary\",\n      \"field\": \"hanzi.etymology_notes[2]\",\n      \"text\": \"From cursive script of 車; compare 東 → 东.\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E4\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.definitions\",\n      \"text\": \"cart, vehicle; carry in cart\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E5\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.readings\",\n      \"text\": \"{\\\"cantonese\\\": \\\"ce1\\\", \\\"mandarin\\\": \\\"chē\\\"}\",\n      \"record_character\": \"车\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E6\",\n      \"source\": \"makemeahanzi\",\n      \"field\": \"hanzi.etymology_notes[0]\",\n      \"text\": \"A cart with two wheels, seen from above\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E7\",\n      \"source\": \"dong_chinese\",\n      \"field\": \"hanzi.etymology_notes[1]\",\n      \"text\": \"Pictograph of a chariot.\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E8\",\n      \"source\": \"shuowen_jiezi\",\n      \"field\": \"hanzi.etymology_notes[2]\",\n      \"text\": \"輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E9\",\n      \"source\": \"wiktionary\",\n      \"field\": \"hanzi.etymology_notes[3]\",\n      \"text\": \"]\\nPictogram (象形) – originally a carriage seen from above. In the oracle bone script, there were large wheels on both sides and a central shaft at the front.\\nUnrelated to 倝 and 朝.\\nPerhaps a loan from an Indo-European language because the horse and chariot were introduced into China around 1200 BC from Inner Asia; compare Tocharian A kukäl, Tocharian B kokale (“wagon; cart”) (Mair, 1990, Bauer, 1994), from Proto-Tocharian *kuk(ä)le, from Proto-Indo-European *kʷékʷlos, a form of *kʷel- (“to turn”). Cognate with English wheel, Ancient Greek κύκλος (kúklos), Lithuanian kaklas (“neck”), etc.\\nSagart and Baxter (2025) specifically pinpoint descent from some reflex of Proto-Indo-Iranian *čakrám and update their 2014 reconstructions to *t.[qʰ]rA > chē and *[C.q]ra > jū. They also suppose that the variation of pronunciations could be attributed to separate borrowing events from Indo-Aryan and Iranian.\\nAn older variant survives in Mandarin 軲轆／轱辘 (gūlu, “wheel”) (Bauer, 1994). Alternatively, the word is a derivation by k-prefix from 舁 (OC *la, “to lift”) (Baxter and Sagart, 1998); compare the semantic parallel in Tibetan ཐེག་པ (theg pa, “vehicle; carriage”) (OC *kʰljaʔ, *kʰljas) and 居 (OC *kas) (Schuessler, 2007). Pronunciation 2 is traditionally regarded as the older pronunciation.\\nThe sense of lewd content is derived from 老司機 /老司机 (lǎosījī).\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E10\",\n      \"source\": \"shuowen_jiezi\",\n      \"field\": \"hanzi.shuowen.explanation\",\n      \"text\": \"輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"E11\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.definitions\",\n      \"text\": \"cart, vehicle; carry in a cart; Kangxi radical 159\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E12\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.readings\",\n      \"text\": \"{\\\"cantonese\\\": \\\"ce1\\\", \\\"japanese_kun\\\": \\\"KURUMA\\\", \\\"japanese_on\\\": \\\"SHA KYO\\\", \\\"korean\\\": \\\"CHA KE\\\", \\\"mandarin\\\": \\\"chē\\\", \\\"tang\\\": \\\"*giu chia\\\", \\\"vietnamese\\\": \\\"xa\\\"}\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E13\",\n      \"source\": \"merged_record\",\n      \"field\": \"hanzi.historical_phonology\",\n      \"text\": \"[{\\\"gloss\\\": \\\"chariot\\\", \\\"gsr\\\": \\\"0074a\\\", \\\"middle_chinese\\\": \\\"tsyhae\\\", \\\"old_chinese\\\": \\\"*[t.qʰ](r)A\\\"}, {\\\"gloss\\\": \\\"chariot\\\", \\\"gsr\\\": \\\"0074a\\\", \\\"middle_chinese\\\": \\\"kjo\\\", \\\"old_chinese\\\": \\\"*C.q(r)a\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"*kʰlja\\\", \\\"source\\\": \\\"zhengzhang_wikt\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"*kla\\\", \\\"source\\\": \\\"zhengzhang_wikt\\\"}, {\\\"fanqie\\\": \\\"九魚\\\", \\\"middle_chinese_guangyun\\\": \\\"見開三C魚平\\\", \\\"source\\\": \\\"guangyun\\\"}, {\\\"fanqie\\\": \\\"尺遮\\\", \\\"middle_chinese_guangyun\\\": \\\"昌開三麻平\\\", \\\"source\\\": \\\"guangyun\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"kʰlja\\\", \\\"rhyme_group\\\": \\\"魚\\\", \\\"source\\\": \\\"zhengzhang\\\"}, {\\\"old_chinese_zhengzhang\\\": \\\"kla\\\", \\\"rhyme_group\\\": \\\"魚\\\", \\\"source\\\": \\\"zhengzhang\\\"}]\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E14\",\n      \"source\": \"kanjidic2_via_build_kanji\",\n      \"field\": \"kanji.definition\",\n      \"text\": \"Car\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E15\",\n      \"source\": \"kanjidic2_via_build_kanji\",\n      \"field\": \"kanji.readings\",\n      \"text\": \"{\\\"japanese_kun\\\": \\\"くるま\\\", \\\"japanese_on\\\": \\\"シャ\\\"}\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_metadata\"\n    },\n    {\n      \"id\": \"E16\",\n      \"source\": \"ids_analysis\",\n      \"field\": \"kanji.etymology_notes[4]\",\n      \"text\": \"Etymological analysis: pictographic\",\n      \"record_character\": \"車\",\n      \"kind\": \"imported_excerpt\"\n    },\n    {\n      \"id\": \"X-5c0577b71d57f19a425e\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"traditional 車 graphic history\",\n      \"text\": \"The database describes Shang oracle-bone forms as variable, sometimes depicting wheels, carriage body, axle, yoke, pole and crossbar; later forms retain selected features, producing the regular 車 form. It lists oracle-bone, bronze, Chu manuscript and seal-script evidence. This supports a pictorial graph, with reduction and stylization over time.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://chardb.iis.sinica.edu.tw/evolution.jsp?cid=23348\",\n      \"title\": \"漢字「車」：字形演變\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-c8c3bfc393ea59ebb382\",\n      \"source\": \"Chinese University of Hong Kong, Multi-function Chinese Character Database\",\n      \"field\": \"traditional 車 forms and early uses\",\n      \"text\": \"The database says oracle-bone and bronze forms vary and may depict the vehicle’s wheels, body, axle, yoke, pole and crossbar. It reports an oracle-bone use for a vehicle in Heji 11452 (“six vehicles”), another in Heji 11450 (“vehicles and horses”), and a place-name use in Heji 584. Bronze inscriptions use 車 for vehicles and also for war chariots. These are source-reported inscription readings; the supplied page does not give calendar dates for each quoted inscription.\",\n      \"record_character\": \"車\",\n      \"kind\": \"primary_evidence_report\",\n      \"url\": \"https://humanum.arts.cuhk.edu.hk/Lexis/lexi-mf/oraclePiece.php?piece=%E8%BB%8A&sub=1\",\n      \"title\": \"漢語多功能字庫 — 車\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-f19b5bd85c060e5423c3\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"traditional 車 graphic history\",\n      \"text\": \"The page distinguishes complex and simplified variants already present in Shang and Western Zhou writing, including complex and simpler forms in adjacent columns of the same Western Zhou inscription. It says the simpler 車 form had become the sole common form by the Eastern Zhou. This is a historical account of graphic variants, distinct from the much later modern simplified character 车.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://mdw.bnu.edu.cn/xsjl/xwgg/d77a2deba32b49d49b9a446b634844ad.htm\",\n      \"title\": \"从单个字符形体的简化看字形与繁简关系\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-7ef1e98e72d456939698\",\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"modern simplified 车 history\",\n      \"text\": \"The author identifies 车 as a cursive form of 車, attested by the Sui dynasty at the latest and continuing in later cursive writing, but says it did not become generally used as a standard character until adoption in the first simplified-character list. The formal 1956 reform resolution states that the first table of 230 simplified characters was to be used from 1 February 1956; the 1964 table lists 车 as a simplified component corresponding to 車. These records support the relationship, but do not show the calligraphic exemplars themselves on the inspected page.\",\n      \"record_character\": \"车\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://mdw.bnu.edu.cn/xsjl/xwgg/d77a2deba32b49d49b9a446b634844ad.htm\",\n      \"title\": \"从单个字符形体的简化看字形与繁简关系\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-466d0ff32f6ad74b285e\",\n      \"source\": \"Shuowen.org, online 說文解字\",\n      \"field\": \"traditional 車 definition and historical account\",\n      \"text\": \"The entry defines 車 as the general name for carriage body and wheels, calls it pictographic, and repeats the traditional claim that Xi Zhong made it in the Xia period. Duan Yucai’s annotation explains the graph as depicting a body, two wheels and an axle, while challenging the claim that Xi Zhong was the first inventor. Treat the Xia attribution as a transmitted historical account, not independent confirmation.\",\n      \"record_character\": \"車\",\n      \"kind\": \"historical_dictionary\",\n      \"url\": \"https://www.shuowen.org/view/9465\",\n      \"title\": \"說文解字「車」\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-d628f651812de6cc0343\",\n      \"source\": \"Taiwan Ministry of Education, Dictionary of Chinese Character Variants\",\n      \"field\": \"modern and historical senses; readings\",\n      \"text\": \"The dictionary records chē (ㄔㄜ) and jū (ㄐㄩ). It cites the basic vehicle sense and later extensions to wheeled machines, transporting by cart, a measure for cartloads, and the chess rook reading. It quotes examples from the Han shu, Nan shi, Tang, Song, Ming and Qing texts; these establish cited later uses, not the chronology of every semantic extension. Its entry gives 尺遮切 from Shuowen and lists Guangyun and Jiyun materials, including separate fish- and ma-rhyme entries.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://dict.variants.moe.edu.tw/dictView.jsp?ID=44266&powerMode=2\",\n      \"title\": \"[A04061] 車 — 教育部《異體字字典》\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-244d407ba653486c9b12\",\n      \"source\": \"Taiwan Ministry of Education, Revised Mandarin Chinese Dictionary\",\n      \"field\": \"modern Mandarin senses\",\n      \"text\": \"The entry gives the standard Mandarin reading chē and describes vehicles, rotating machinery, machine sewing or cutting, and a measure for cartloads; it also lists jū as another reading. This is modern lexicographic evidence, not a dated account of when each sense arose.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://dict.concised.moe.edu.tw/dictView.jsp?ID=31626&la=0&powerMode=0\",\n      \"title\": \"《國語辭典簡編本》：車\",\n      \"accessed_at\": \"2026-09-26\"\n    },\n    {\n      \"id\": \"X-f3dead1c5135199c4bf6\",\n      \"source\": \"Wiktionary, citing Baxter–Sagart historical phonology data\",\n      \"field\": \"traditional 車 readings and reconstructions\",\n      \"text\": \"For the two readings, the page reports Mandarin chē with Middle Chinese tsyhae and Baxter–Sagart Old Chinese *[t.qʰ](r)A, and Mandarin jū with Middle Chi\n\n### source_article.json\n{\n  \"character\": \"车\",\n  \"summary\": {\n    \"text\": \"车 is a modern simplified form of 車, a pictograph of a wheeled vehicle. Its shape derives from the traditional graph’s cursive form.\",\n    \"evidence_ids\": [\n      \"X-7ef1e98e72d456939698\",\n      \"X-2fac4f5cdbbc22291c44\"\n    ]\n  },\n  \"formation\": {\n    \"text\": \"The traditional graph 車 pictures a vehicle as a whole. Early forms varied in the features shown; later forms selected and regularized some of them. The modern graph 车 derives from cursive 車.\",\n    \"evidence_ids\": [\n      \"X-5c0577b71d57f19a425e\",\n      \"X-7ef1e98e72d456939698\",\n      \"X-2fac4f5cdbbc22291c44\"\n    ],\n    \"type\": \"pictographic\"\n  },\n  \"components\": [],\n  \"history\": [\n    {\n      \"text\": \"Early oracle-bone and bronze forms of 車 varied in the vehicle features shown. Later forms selected and regularized some features. The curated oracle-bone, Western Zhou bronze, and seal-script examples illustrate different presentations; they are modern redrawings, not artifact photographs.\",\n      \"evidence_ids\": [\n        \"X-2fac4f5cdbbc22291c44\",\n        \"X-f251f574912023578809\",\n        \"X-2daf74220d5e73d4d9b7\",\n        \"X-cb4cf22db1b120ed3a22\"\n      ]\n    },\n    {\n      \"text\": \"The modern simplified form 车 derives from cursive 車, attested by the Sui dynasty at the latest. It became a standard character in 1956. This change is distinct from earlier variation within 車.\",\n      \"evidence_ids\": [\n        \"X-f19b5bd85c060e5423c3\",\n        \"X-7ef1e98e72d456939698\",\n        \"X-7f9f75f8cde670dfc8e7\"\n      ]\n    }\n  ],\n  \"uncertainties\": [\n    {\n      \"text\": \"Early forms varied, and the curated images are modern redrawings. Individual vehicle features in any one drawing should therefore be interpreted cautiously.\",\n      \"evidence_ids\": [\n        \"X-2fac4f5cdbbc22291c44\",\n        \"X-f251f574912023578809\",\n        \"X-2daf74220d5e73d4d9b7\",\n        \"X-cb4cf22db1b120ed3a22\"\n      ]\n    },\n    {\n      \"text\": \"Early vehicle uses are identified by inscription references, but the cited evidence gives neither calendar dates for those inscriptions nor a precise earliest date for the graph.\",\n      \"evidence_ids\": [\n        \"X-c8c3bfc393ea59ebb382\",\n        \"X-b80d69d439096a59a187\"\n      ]\n    }\n  ],\n  \"schema_version\": 2,\n  \"meaning_history\": {\n    \"senses\": [\n      {\n        \"id\": \"车:vehicle\",\n        \"gloss\": \"vehicle; cart or chariot\",\n        \"period\": \"Early inscriptions; individual dates unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"earliest_attested\",\n        \"text\": \"Oracle-bone examples use 車 for vehicles, and bronze examples include vehicles and war chariots. These attest early vehicle-related use but do not establish a calendar-dated first occurrence.\",\n        \"evidence_ids\": [\n          \"X-c8c3bfc393ea59ebb382\",\n          \"X-b80d69d439096a59a187\"\n        ]\n      },\n      {\n        \"id\": \"车:place_name\",\n        \"gloss\": \"place name\",\n        \"period\": \"Early inscriptions; dating unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"historical\",\n        \"text\": \"An oracle-bone example is identified as a place-name use. Its meaning and any connection to the vehicle sense are unresolved.\",\n        \"evidence_ids\": [\n          \"X-c8c3bfc393ea59ebb382\",\n          \"X-b80d69d439096a59a187\"\n        ]\n      },\n      {\n        \"id\": \"车:extended_uses\",\n        \"gloss\": \"wheeled machines; transporting by cart; cartload measure\",\n        \"period\": \"Later textual uses; chronology unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"historical\",\n        \"text\": \"Later dictionaries record these uses, but the evidence does not date their emergence or establish a continuous development from the vehicle sense.\",\n        \"evidence_ids\": [\n          \"X-d628f651812de6cc0343\",\n          \"X-244d407ba653486c9b12\"\n        ]\n      },\n      {\n        \"id\": \"车:current_vehicle\",\n        \"gloss\": \"vehicle; car\",\n        \"period\": \"Modern\",\n        \"certainty\": \"established\",\n        \"status\": \"current\",\n        \"text\": \"The common modern meaning includes vehicle and car.\",\n        \"evidence_ids\": [\n          \"E4\",\n          \"E14\",\n          \"X-244d407ba653486c9b12\"\n        ]\n      }\n    ],\n    \"developments\": [],\n    \"limitations\": [\n      {\n        \"text\": \"The chronology and semantic links among later machinery, transport, and measure senses are unresolved, so no chain of development is proposed.\",\n        \"evidence_ids\": [\n          \"X-d628f651812de6cc0343\",\n          \"X-244d407ba653486c9b12\"\n        ]\n      },\n      {\n        \"text\": \"Some proposals treat the spoken word written 車 as borrowed from Indo-Iranian words for “wheel” or “chariot.” In that account, the graph was reused for another word because the words sounded alike or similar; the vehicle picture did not develop into that word’s meaning. The depicted vehicle’s spoken name is not independently established, so the proposed sound match remains disputed.\",\n        \"evidence_ids\": [\n          \"X-89d71d67cb807736af10\",\n       \n\n### refine_input_article.json\n{\n  \"character\": \"车\",\n  \"summary\": {\n    \"text\": \"车 is a modern simplified form of 車, a pictograph of a wheeled vehicle. Its shape derives from the traditional graph’s cursive form.\",\n    \"evidence_ids\": [\n      \"X-7ef1e98e72d456939698\",\n      \"X-2fac4f5cdbbc22291c44\"\n    ]\n  },\n  \"formation\": {\n    \"text\": \"The traditional graph 車 pictures a vehicle as a whole. Early forms varied in the features shown; later forms selected and regularized some of them. The modern graph 车 derives from cursive 車.\",\n    \"evidence_ids\": [\n      \"X-5c0577b71d57f19a425e\",\n      \"X-7ef1e98e72d456939698\",\n      \"X-2fac4f5cdbbc22291c44\"\n    ],\n    \"type\": \"pictographic\"\n  },\n  \"components\": [],\n  \"history\": [\n    {\n      \"text\": \"Early oracle-bone and bronze forms of 車 varied in the vehicle features shown. Later forms selected and regularized some features. The curated oracle-bone, Western Zhou bronze, and seal-script examples illustrate different presentations; they are modern redrawings, not artifact photographs.\",\n      \"evidence_ids\": [\n        \"X-2fac4f5cdbbc22291c44\",\n        \"X-f251f574912023578809\",\n        \"X-2daf74220d5e73d4d9b7\",\n        \"X-cb4cf22db1b120ed3a22\"\n      ]\n    },\n    {\n      \"text\": \"The modern simplified form 车 derives from cursive 車, attested by the Sui dynasty at the latest. It became a standard character in 1956. This change is distinct from earlier variation within 車.\",\n      \"evidence_ids\": [\n        \"X-f19b5bd85c060e5423c3\",\n        \"X-7ef1e98e72d456939698\",\n        \"X-7f9f75f8cde670dfc8e7\"\n      ]\n    }\n  ],\n  \"uncertainties\": [\n    {\n      \"text\": \"Early forms varied, and the curated images are modern redrawings. Individual vehicle features in any one drawing should therefore be interpreted cautiously.\",\n      \"evidence_ids\": [\n        \"X-2fac4f5cdbbc22291c44\",\n        \"X-f251f574912023578809\",\n        \"X-2daf74220d5e73d4d9b7\",\n        \"X-cb4cf22db1b120ed3a22\"\n      ]\n    },\n    {\n      \"text\": \"Early vehicle uses are identified by inscription references, but the cited evidence gives neither calendar dates for those inscriptions nor a precise earliest date for the graph.\",\n      \"evidence_ids\": [\n        \"X-c8c3bfc393ea59ebb382\",\n        \"X-b80d69d439096a59a187\"\n      ]\n    }\n  ],\n  \"schema_version\": 2,\n  \"meaning_history\": {\n    \"senses\": [\n      {\n        \"id\": \"车:vehicle\",\n        \"gloss\": \"vehicle; cart or chariot\",\n        \"period\": \"Early inscriptions; individual dates unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"earliest_attested\",\n        \"text\": \"Oracle-bone examples use 車 for vehicles, and bronze examples include vehicles and war chariots. These attest early vehicle-related use but do not establish a calendar-dated first occurrence.\",\n        \"evidence_ids\": [\n          \"X-c8c3bfc393ea59ebb382\",\n          \"X-b80d69d439096a59a187\"\n        ]\n      },\n      {\n        \"id\": \"车:place_name\",\n        \"gloss\": \"place name\",\n        \"period\": \"Early inscriptions; dating unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"historical\",\n        \"text\": \"An oracle-bone example is identified as a place-name use. Its meaning and any connection to the vehicle sense are unresolved.\",\n        \"evidence_ids\": [\n          \"X-c8c3bfc393ea59ebb382\",\n          \"X-b80d69d439096a59a187\"\n        ]\n      },\n      {\n        \"id\": \"车:extended_uses\",\n        \"gloss\": \"wheeled machines; transporting by cart; cartload measure\",\n        \"period\": \"Later textual uses; chronology unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"historical\",\n        \"text\": \"Later dictionaries record these uses, but the evidence does not date their emergence or establish a continuous development from the vehicle sense.\",\n        \"evidence_ids\": [\n          \"X-d628f651812de6cc0343\",\n          \"X-244d407ba653486c9b12\"\n        ]\n      },\n      {\n        \"id\": \"车:current_vehicle\",\n        \"gloss\": \"vehicle; car\",\n        \"period\": \"Modern\",\n        \"certainty\": \"established\",\n        \"status\": \"current\",\n        \"text\": \"The common modern meaning includes vehicle and car.\",\n        \"evidence_ids\": [\n          \"E4\",\n          \"E14\",\n          \"X-244d407ba653486c9b12\"\n        ]\n      }\n    ],\n    \"developments\": [],\n    \"limitations\": [\n      {\n        \"text\": \"The chronology and semantic links among later machinery, transport, and measure senses are unresolved, so no chain of development is proposed.\",\n        \"evidence_ids\": [\n          \"X-d628f651812de6cc0343\",\n          \"X-244d407ba653486c9b12\"\n        ]\n      },\n      {\n        \"text\": \"Some proposals treat the spoken word written 車 as borrowed from Indo-Iranian words for “wheel” or “chariot.” In that account, the graph was reused for another word because the words sounded alike or similar; the vehicle picture did not develop into that word’s meaning. The depicted vehicle’s spoken name is not independently established, so the proposed sound match remains disputed.\",\n        \"evidence_ids\": [\n          \"X-89d71d67cb807736af10\",\n       \n\n### status.json\n{\n  \"character\": \"车\",\n  \"status\": \"failed\",\n  \"mode\": \"refine\",\n  \"dossier_hash\": \"fc245076b069ab90cef53051cad014cb8f5266d20daab4297ffab8a1b65fa450\",\n  \"source_article_hash\": \"c0e1fac42428624d6caf1b15d982508627f8bbbbbdb915c5cc398a2e87e16ce6\",\n  \"initial_research\": true,\n  \"revision_limit\": 2,\n  \"error\": \"Command '['codex', '--search', 'exec', '--json', '--ephemeral', '-s', 'danger-full-access', '-c', 'approval_policy=\\\"never\\\"', '-m', 'gpt-6-luna', '-c', 'model_reasoning_effort=\\\"low\\\"', '--output-schema', '/home/catalin/hanzi-etymology-dict/runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/agent-schema.json', '-o', '/home/catalin/hanzi-etymology-dict/runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/round-0/editor/result.json', '-']' timed out after 599.9449561419897 seconds\"\n}\n\n### source_feedback.json\n{\n  \"reuse_existing_glyph_candidates\": true,\n  \"source_enrichment\": {\n    \"source\": {\n      \"id\": \"ziyuan-2012\",\n      \"title\": \"字源\",\n      \"bibliography\": \"李學勤主編《字源》, 天津古籍出版社 / 遼寧人民出版社, 2012, ISBN 9787552800692\",\n      \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\",\n      \"corpus_path\": \"/home/catalin/hanzi-etymology-books/source-corpus/ziyuan-pages.jsonl\",\n      \"producer_root\": \"/home/catalin/hanzi-etymology-books\",\n      \"availability\": \"provisional_ocr\",\n      \"instructions\": \"Search simplified and traditional forms; verify every used passage against source scans. Report exact scan-verified OCR errors for source-bound correction. Preserve competing scholarly analyses and unresolved printed glyph identities. Other acquired books are not digitised consumer sources yet.\"\n    },\n    \"corpus_instructions\": \"Search this supplied corpus directly; verify candidate passages against source scans where possible.\",\n    \"preserve_existing_evidence\": true,\n    \"record_ocr_uncertainty\": \"Do not guess OCR corrections. Report the exact suspect page/span and why it needs scan verification in the research gaps; do not silently normalize it.\"\n  },\n  \"task\": \"Research this already published character with the supplied local scholarly source. Search and inspect the supplied corpus, verify the actual headword and relevant passage against scan images when available, and compare the book with other authoritative references. Preserve existing supported evidence and article content unless a precise source-backed improvement is warranted. Keep uncertainty scoped and glyph assets intact. Cite at least one relevant finding from the named book with its exact page; In the authored article, cite the retained book evidence ID on the specific supported claim; placing a new book record only in the dossier is not article enrichment. Use evidence_ids arrays, never inline labels. If the book corroborates existing prose, preserve that prose and add only the supported citation before fresh reviews. if no relevant claim can be established, record a source-specific access or relevance gap. For each unresolved OCR or scan identity issue, add a gap beginning exactly [SCAN VERIFICATION REQUIRED] or [OCR CORRECTION REQUIRED] and state page, span, and reason.\",\n  \"source_leads\": [\n    {\n      \"source_id\": \"ziyuan-2012\",\n      \"title\": \"字源\",\n      \"bibliography\": \"李學勤主編《字源》, 天津古籍出版社 / 遼寧人民出版社, 2012, ISBN 9787552800692\",\n      \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\",\n      \"search_forms\": [\n        \"车\",\n        \"車\"\n      ],\n      \"corpus_path\": \"/home/catalin/hanzi-etymology-books/source-corpus/ziyuan-pages.jsonl\",\n      \"candidates\": [\n        {\n          \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001260\",\n          \"pdf_page_1based\": 1260,\n          \"printed_page\": null,\n          \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1260/source.png\",\n          \"source_sha256\": \"7c02c6ce3bc7b71a85178af5e2a1e2fac1b3a09012a730f0777ad09f792c2c09\",\n          \"evidence_sha256\": \"4110973cee425056c099b5f76281a069c23a96f404857a1035a8eff4e55c76ce\",\n          \"ocr_review_status\": \"unreviewed\",\n          \"match_type\": \"unverified_headword_line\",\n          \"headword_lines\": [\n            \"車(车) chē 昌组、鱼韵;昌组、麻韵、尺遮切。\"\n          ],\n          \"excerpt\": \"《释名·释兵》：“矛，冒也，刃下冒矜也。”《方言》九：“矛，其柄谓之矜”皆与许书合。后世专用矜为矜恤，矜夸字，因别造欚字为棘矜之矜。……汉碑多从令作矜，乃隶书之增笔，自不可据隶以正篆。”汉初马王堆汉墓帛书矜字从令，如此可知，从令，非隶书之增笔，当为二字声近，故从今声从令声皆可。（周宝宏）\\n\\n車部\\n\\n車(车) chē 昌组、鱼韵;昌组、麻韵、尺遮切。\\n[glyph:g014] [glyph:g015] [glyph:g016] [glyph:g017] [glyph:g018] [glyph:g019] [glyph:g020] [glyph:g021] [glyph:g022] [glyph:g023] [glyph:g024] [glyph:g025] [glyph:g026] [glyph:g027] [glyph:g028] [glyph:g029] [glyph:g030] 車 車 车\\n商 商 商 商 商 商 商 商 商 商 商 西周 西周 西周 西周 西周 西周 《说文》小篆 楷书 楷书\\n1-8、12-17《金文编》929~931页。9、10、11《甲文编》531~532页。18《说文》301页。\\n形声字。《说文》：“車，舆轮之总名。夏后时奚仲所造，象形。凡车之属皆从车。”郭沫若《卜辞通纂》：“二车字一作[glyph:g031]，一作[glyph:g032]。前者象双轮一辕，辕端有衡。亦有作[glyph:g033]者，于衡之两端更有二轭，所以叉马颈者也。观此可证殷人一车只驾二马。后者象两轮之间有箱，均为车之繁文。金文中车字及从车之肇字，多如是作。”甲骨文和殷末周初金文中的全体象形的车字，有车箱、两轮、两键、一辕、一衡、两轭，但在殷末周初金文中已有省略车箱的车字，在甲骨文中更有省略车箱的车字，省略车辕和双轭一横的车字，只剩两轮一箱，更有只剩两轮一轴的车字。西周早期至中期车字仍继承繁体全形车字形体，但多省车箱，更有省一轮一箱而剩一轮作[glyph:g034]者，如果此形省掉一辕一衡双轭，则作車，正与西周中晚期及春秋战国以后的车字同形了。在西周中晚期的师同鼎铭文中有全形的车和省形“車”字。省形的“車”字形体从西周金文[glyph:g035]省为[glyph:g036]看，“車”当为一轴一轮两键（或两毂）形。（周宝宏）\\n\\n軒(轩) xuān 晓组、元部;晓组、元韵、虚言切。\\n[glyph:g037] [glyph:g038] [glyph:g039] [glyph:g040] [glyph:g041] [glyph:g042] 軒 轩\\n战国 战国 战国 《说文》小篆 汉 汉 楷体 楷体\\n1、2、3《战文编》931页。4《说文》301页。\\n1245\"\n        },\n        {\n          \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001261\",\n          \"pdf_page_1based\": 1261,\n          \"printed_page\": null,\n          \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1261/source.png\",\n          \"source_sha256\": \"96647dcec2ab5f1bad41b0a3796a456e2f78ffa8a36d184b70e801e64e0fc857\",\n          \"evidence_sha256\": \"4de06f2\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json\np='runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/'\nfor f in ['refine_input_dossier.json','source_dossier.json','source_findings.json','source_audit.json','initial-followup/research/result.json','source_article.json']:\n d=json.load(open(p+f)); print('\\\\n',f)\n if f.endswith('dossier.json'):\n  for e in d.get('evidence',[]):\n   print(e['id'],e.get('source'),e.get('field'),e.get('text','')[:450].replace('\\\\n',' '))\n  print('glyph research',json.dumps(d.get('glyph_research'),ensure_ascii=False)[:1500])\n elif 'result.json' in f: print(json.dumps(d,ensure_ascii=False,indent=2)[:5500])\n else: print(json.dumps(d,ensure_ascii=False,indent=2)[:3000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json\np='runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66/'\nfor f in ['refine_input_dossier.json','source_dossier.json','source_findings.json','source_audit.json','initial-followup/research/result.json','source_article.json']:\n d=json.load(open(p+f)); print('\\\\n',f)\n if f.endswith('dossier.json'):\n  for e in d.get('evidence',[]):\n   print(e['id'],e.get('source'),e.get('field'),e.get('text','')[:450].replace('\\\\n',' '))\n  print('glyph research',json.dumps(d.get('glyph_research'),ensure_ascii=False)[:1500])\n elif 'result.json' in f: print(json.dumps(d,ensure_ascii=False,indent=2)[:5500])\n else: print(json.dumps(d,ensure_ascii=False,indent=2)[:3000])\nPY\"","aggregated_output":"\n refine_input_dossier.json\nE1 makemeahanzi hanzi.etymology_notes[0] Simplified form of 車, a cart with two wheels, seen from above\nE2 dong_chinese hanzi.etymology_notes[1] Pictograph of a chariot. The simplified character 车 was adapted from the cursive form of the traditional character 車.\nE3 wiktionary hanzi.etymology_notes[2] From cursive script of 車; compare 東 → 东.\nE4 merged_record hanzi.definitions cart, vehicle; carry in cart\nE5 merged_record hanzi.readings {\"cantonese\": \"ce1\", \"mandarin\": \"chē\"}\nE6 makemeahanzi hanzi.etymology_notes[0] A cart with two wheels, seen from above\nE7 dong_chinese hanzi.etymology_notes[1] Pictograph of a chariot.\nE8 shuowen_jiezi hanzi.etymology_notes[2] 輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\nE9 wiktionary hanzi.etymology_notes[3] ] Pictogram (象形) – originally a carriage seen from above. In the oracle bone script, there were large wheels on both sides and a central shaft at the front. Unrelated to 倝 and 朝. Perhaps a loan from an Indo-European language because the horse and chariot were introduced into China around 1200 BC from Inner Asia; compare Tocharian A kukäl, Tocharian B kokale (“wagon; cart”) (Mair, 1990, Bauer, 1994), from Proto-Tocharian *kuk(ä)le, from Proto-Indo\nE10 shuowen_jiezi hanzi.shuowen.explanation 輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\nE11 merged_record hanzi.definitions cart, vehicle; carry in a cart; Kangxi radical 159\nE12 merged_record hanzi.readings {\"cantonese\": \"ce1\", \"japanese_kun\": \"KURUMA\", \"japanese_on\": \"SHA KYO\", \"korean\": \"CHA KE\", \"mandarin\": \"chē\", \"tang\": \"*giu chia\", \"vietnamese\": \"xa\"}\nE13 merged_record hanzi.historical_phonology [{\"gloss\": \"chariot\", \"gsr\": \"0074a\", \"middle_chinese\": \"tsyhae\", \"old_chinese\": \"*[t.qʰ](r)A\"}, {\"gloss\": \"chariot\", \"gsr\": \"0074a\", \"middle_chinese\": \"kjo\", \"old_chinese\": \"*C.q(r)a\"}, {\"old_chinese_zhengzhang\": \"*kʰlja\", \"source\": \"zhengzhang_wikt\"}, {\"old_chinese_zhengzhang\": \"*kla\", \"source\": \"zhengzhang_wikt\"}, {\"fanqie\": \"九魚\", \"middle_chinese_guangyun\": \"見開三C魚平\", \"source\": \"guangyun\"}, {\"fanqie\": \"尺遮\", \"middle_chinese_guangyun\": \"昌開三麻平\", \"\nE14 kanjidic2_via_build_kanji kanji.definition Car\nE15 kanjidic2_via_build_kanji kanji.readings {\"japanese_kun\": \"くるま\", \"japanese_on\": \"シャ\"}\nE16 ids_analysis kanji.etymology_notes[4] Etymological analysis: pictographic\nX-5c0577b71d57f19a425e Academia Sinica, Chinese Characters Database traditional 車 graphic history The database describes Shang oracle-bone forms as variable, sometimes depicting wheels, carriage body, axle, yoke, pole and crossbar; later forms retain selected features, producing the regular 車 form. It lists oracle-bone, bronze, Chu manuscript and seal-script evidence. This supports a pictorial graph, with reduction and stylization over time.\nX-c8c3bfc393ea59ebb382 Chinese University of Hong Kong, Multi-function Chinese Character Database traditional 車 forms and early uses The database says oracle-bone and bronze forms vary and may depict the vehicle’s wheels, body, axle, yoke, pole and crossbar. It reports an oracle-bone use for a vehicle in Heji 11452 (“six vehicles”), another in Heji 11450 (“vehicles and horses”), and a place-name use in Heji 584. Bronze inscriptions use 車 for vehicles and also for war chariots. These are source-reported inscription readings; the supplied page does not give calendar dates for ea\nX-f19b5bd85c060e5423c3 Academia Sinica, Chinese Characters Database traditional 車 graphic history The page distinguishes complex and simplified variants already present in Shang and Western Zhou writing, including complex and simpler forms in adjacent columns of the same Western Zhou inscription. It says the simpler 車 form had become the sole common form by the Eastern Zhou. This is a historical account of graphic variants, distinct from the much later modern simplified character 车.\nX-7ef1e98e72d456939698 Academia Sinica, Chinese Characters Database modern simplified 车 history The author identifies 车 as a cursive form of 車, attested by the Sui dynasty at the latest and continuing in later cursive writing, but says it did not become generally used as a standard character until adoption in the first simplified-character list. The formal 1956 reform resolution states that the first table of 230 simplified characters was to be used from 1 February 1956; the 1964 table lists 车 as a simplified component corresponding to 車. T\nX-466d0ff32f6ad74b285e Shuowen.org, online 說文解字 traditional 車 definition and historical account The entry defines 車 as the general name for carriage body and wheels, calls it pictographic, and repeats the traditional claim that Xi Zhong made it in the Xia period. Duan Yucai’s annotation explains the graph as depicting a body, two wheels and an axle, while challenging the claim that Xi Zhong was the first inventor. Treat the Xia attribution as a transmitted historical account, not independent confirmation.\nX-d628f651812de6cc0343 Taiwan Ministry of Education, Dictionary of Chinese Character Variants modern and historical senses; readings The dictionary records chē (ㄔㄜ) and jū (ㄐㄩ). It cites the basic vehicle sense and later extensions to wheeled machines, transporting by cart, a measure for cartloads, and the chess rook reading. It quotes examples from the Han shu, Nan shi, Tang, Song, Ming and Qing texts; these establish cited later uses, not the chronology of every semantic extension. Its entry gives 尺遮切 from Shuowen and lists Guangyun and Jiyun materials, including separate fi\nX-244d407ba653486c9b12 Taiwan Ministry of Education, Revised Mandarin Chinese Dictionary modern Mandarin senses The entry gives the standard Mandarin reading chē and describes vehicles, rotating machinery, machine sewing or cutting, and a measure for cartloads; it also lists jū as another reading. This is modern lexicographic evidence, not a dated account of when each sense arose.\nX-f3dead1c5135199c4bf6 Wiktionary, citing Baxter–Sagart historical phonology data traditional 車 readings and reconstructions For the two readings, the page reports Mandarin chē with Middle Chinese tsyhae and Baxter–Sagart Old Chinese *[t.qʰ](r)A, and Mandarin jū with Middle Chinese kjo and *C.q(r)a in the 2014 Baxter–Sagart system. Its table distinguishes two pronunciations of 車, not phonetic components within the graph. The page also reports Zhengzhang Old Chinese *kʰlja for chē and *kla for jū; these are a separate reconstruction system and should not be merged with \nX-22538951380b213dbde3 Dong Chinese modern simplified 车 and modern Mandarin readings The entry lists chē and jū and describes 车 as adapted from the cursive form of traditional 車. This is a secondary summary; the more detailed Sui-and-later chronology is reported separately by the Beijing Normal University study.\nX-ef8e35f848da3f16b4e2 Robert S. Bauer, Sino-Platonic Papers competing Old Chinese reconstructions Bauer’s 1994 comparison shows substantial variation among then-published reconstructions for the word 車, including forms around *khlja, *kalja and *k(r)ja. This reinforces that reconstructed sound forms depend on system and period; it does not establish a loan source or the original spoken name of the depicted vehicle.\nX-89d71d67cb807736af10 Encyclopaedia Iranica proposed Indo-Iranian comparison: source word and vehicle history The entry describes Indo-Iranian chariot traditions and the Iranian word čaxra- and Old Indian cakrá- for “wheel,” related to Indo-European *kʷékʷlo-. It reports datable Indo-Aryan chariot-racing terms in the Hittite Kikkuli treatise from the 14th century BCE, while noting that Avestan material cannot be precisely dated. This independently establishes relevant source-language vocabulary and chariot context, but not a borrowing into Chinese or the\nX-b1375ab9d8bbf24a5205 Victor Mair, Robert S. Bauer, and later discussion as summarized in S. V. Shaughnessy, Sino-Platonic Papers disputed whole-word loan proposals The inspected account attributes to Mair a proposal that Chinese 車 was borrowed from a Proto-Iranian form *caxra- “wheel,” and describes Bauer’s subsequent comparison of Chinese and Bodic wheel terms. A separate current Wiktionary entry reports a newer Sagart–Baxter (2025) proposal connecting Chinese readings to reflexes of Proto-Indo-Iranian *čakrám and suggests separate borrowing histories for chē and jū. These are proposals about the spoken wo\nX-7f9f75f8cde670dfc8e7 Wikisource transcription of the State Council resolution 1956 simplified-character standardization The transcribed resolution is dated 28 January 1956 and states the first table of 230 simplified characters was to be used in printed and handwritten documents from 1 February 1956. Its appendix lists 车（車） among the simplified components. This dates standardization, not the earlier cursive form’s origin.\nX-2fac4f5cdbbc22291c44 Academia Sinica, Chinese Characters Database graphic history of 車 Describes Shang oracle forms as variable, with detailed and abbreviated depictions of vehicle features including wheels, body/frame, crossbar, and yoke; says later writing selected some features to form regular 車. Its page displays oracle-bone, bronze, Chu manuscript, and seal-script categories. This supports pictographic formation and graphic reduction, without implying every version includes every named part.\nX-b80d69d439096a59a187 Chinese University of Hong Kong, Multi-function Chinese Character Database early graphic analysis and uses Reports variable oracle-bone and bronze forms depicting vehicle features, and that bronze forms are often written vertically. It identifies oracle-bone examples for vehicle use in Heji 11452 (“six vehicles”), vehicle-and-horse use in Heji 11450, and a place-name use in Heji 584. It reports bronze vehicle and war-chariot uses, and later Warring States bamboo-slip vehicle and chariot-punishment uses. These are inscription identifiers and source int\nX-15e93e2e2a80d13fceb9 Guoxuedashi character-form reference page graphic variants and dated bronze exemplars Lists oracle-bone examples by corpus references and bronze examples with period labels, including late Shang and Western Zhou. The page’s interpretation describes oracle forms with differing combinations of canopy, axle, wheels and vehicle body, and later verticalized forms. It classifies the graph as pictographic. This is a secondary reference and its detailed part-by-part interpretation is not independently demonstrated by the page.\nX-d7737fed17a64d5f7edf Wikimedia Commons file description Shang oracle glyph candidate and provenance The file page identifies the image as a modern SVG representation of 車 in Shang oracle script style. It names source databases and points to a specific Hanziyuan oracle image and Academia Sinica database image as references. The Commons page states CC0/public-domain dedication for the file; this is a redraw, not an artifact photograph.\nX-8440c9713ae6ceccedc3 Wikimedia Commons file description Western Zhou bronze glyph candidate and provenance The file page identifies the image as a modern SVG representation in Western Zhou bronze script style, citing the Hanziyuan image B19579 and Academia Sinica image 34.E39B (noted as 同卣, mid-Western Zhou). The Commons page states CC0/public-domain dedication for the redraw; it is not a photograph or direct scan of the bronze artifact.\nX-92557da0666ab03e988b Wikimedia Commons file description Shuowen seal glyph candidate and provenance The page identifies a modern SVG redraw of 車 in Shuowen seal-script style and cites Hanziyuan image s10685. It states the representation is public domain. This candidate can illustrate the later standardized seal-script shape, not an ancient artifact photograph.\nX-4b89657a402b48652637 Wikimedia Commons license deed CC0 reuse rights The Commons glyph pages identify CC0 1.0 Universal Public Domain Dedication. The license deed permits copying, modification, distribution, and commercial use without requesting permission, to the extent allowed by law.\nX-f251f574912023578809 Wikimedia Commons file description Shang oracle glyph identity and source Identifies this as a modern vector drawing of 車 in Shang oracle script style. The description cites a specific Hanziyuan image (J29288) and Academia Sinica image (43.F452); it does not represent a photograph of an inscribed artifact.\nX-2daf74220d5e73d4d9b7 Wikimedia Commons file description Western Zhou bronze glyph identity and source Identifies this as a modern vector drawing of 車 in Western Zhou bronze script style, citing Hanziyuan image B19579 and Academia Sinica image 34.E39B, associated on the page with 同卣 (mid-Western Zhou). The drawing is not an artifact photograph.\nX-cb4cf22db1b120ed3a22 Wikimedia Commons file description Shuowen seal glyph identity and source Identifies a modern vector drawing of 車 in Shuowen seal script style, citing Hanziyuan image s10685; the page history also says a later version was taken from Academia Sinica. This is a script representation, not an ancient artifact photograph.\nX-b087ee465f607263eb40 Wikimedia Commons file descriptions reuse rights The opened descriptions state that the vector representations are released under CC0/public-domain terms. The descriptions permit copying and reuse without requesting permission, to the extent allowed by law.\nX-a2ef5de8962249795356 Wikimedia Commons file description exact original image URL for Shang oracle candidate The page’s Original file link resolved to https://upload.wikimedia.org/wikipedia/commons/1/15/%E8%BB%8A-oracle.svg. The web viewer could not render the SVG content type, but the direct URL was obtained from the actual page link, not guessed.\nX-5dd5e9544541000b352b Wikimedia Commons file description exact original image URL for Western Zhou bronze candidate The page’s Original file link resolved to https://upload.wikimedia.org/wikipedia/commons/2/25/%E8%BB%8A-bronze-5.svg. The direct fetch returned a cache miss in the web viewer; URL is copied from the page link and not inferred from a hash pattern.\nX-7bbf929191ab97357884 Wikimedia Commons file description exact original image URL for Shuowen seal candidate The page’s Original file link resolved to https://upload.wikimedia.org/wikipedia/commons/a/a7/%E8%BB%8A-seal.svg. The web viewer could not render the SVG content type; the direct URL was taken from the linked file page.\nglyph research {\"historical_glyphs\": {\"items\": [{\"id\": \"車-oracle\", \"image_url\": \"https://upload.wikimedia.org/wikipedia/commons/1/15/%E8%BB%8A-oracle.svg\", \"source_url\": \"https://commons.wikimedia.org/wiki/File:%E8%BB%8A-oracle.svg\", \"source_title\": \"File:車-oracle.svg — Wikimedia Commons\", \"period\": \"Shang dynasty, oracle-bone script style\", \"tradition\": \"Chinese oracle-bone script; modern vector redraw based on cited Hanziyuan and Academia Sinica character images\", \"caption\": \"An oracle-bone style form of 車 has a long central shaft crossed by a bar, with a vehicle body and wheel-like shapes below. Early forms varied in which vehicle features they showed.\", \"alt\": \"Black oracle-bone style character with a vertical central stroke, a broad crossbar, and a lower section containing several openings.\", \"selection_reason\": \"Provides a clear early pictorial example consistent with descriptions of variable vehicle features in oracle-bone forms.\", \"rights\": \"CC0 / public-domain dedication stated on the Commons page.\", \"rights_url\": \"https://creativecommons.org/publicdomain/zero/1.0/deed.en\", \"evidence_ids\": [\"X-2fac4f5cdbbc22291c44\", \"X-f251f574912023578809\"]}, {\"id\": \"車-bronze-western\", \"image_url\": \"https://upload.wikimedia.org/wikipedia/commons/2/25/%E8%BB%8A-bronze-5.svg\", \"source_url\": \"https://commons.wikimedia.org/wiki/File:%E8%BB%8A-bronze-5.svg\", \"source_title\": \"File:車-bronze-5.svg — Wikimedia Commons\", \"period\": \"Mid-Western Zhou, bronze-script style\", \"tradition\": \"Chinese bronze-inscrip\n\n source_dossier.json\nE1 makemeahanzi hanzi.etymology_notes[0] Simplified form of 車, a cart with two wheels, seen from above\nE2 dong_chinese hanzi.etymology_notes[1] Pictograph of a chariot. The simplified character 车 was adapted from the cursive form of the traditional character 車.\nE3 wiktionary hanzi.etymology_notes[2] From cursive script of 車; compare 東 → 东.\nE4 merged_record hanzi.definitions cart, vehicle; carry in cart\nE5 merged_record hanzi.readings {\"cantonese\": \"ce1\", \"mandarin\": \"chē\"}\nE6 makemeahanzi hanzi.etymology_notes[0] A cart with two wheels, seen from above\nE7 dong_chinese hanzi.etymology_notes[1] Pictograph of a chariot.\nE8 shuowen_jiezi hanzi.etymology_notes[2] 輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\nE9 wiktionary hanzi.etymology_notes[3] ] Pictogram (象形) – originally a carriage seen from above. In the oracle bone script, there were large wheels on both sides and a central shaft at the front. Unrelated to 倝 and 朝. Perhaps a loan from an Indo-European language because the horse and chariot were introduced into China around 1200 BC from Inner Asia; compare Tocharian A kukäl, Tocharian B kokale (“wagon; cart”) (Mair, 1990, Bauer, 1994), from Proto-Tocharian *kuk(ä)le, from Proto-Indo\nE10 shuowen_jiezi hanzi.shuowen.explanation 輿輪之緫名。夏后時奚仲所造。象形。凡車之屬皆从車。\nE11 merged_record hanzi.definitions cart, vehicle; carry in a cart; Kangxi radical 159\nE12 merged_record hanzi.readings {\"cantonese\": \"ce1\", \"japanese_kun\": \"KURUMA\", \"japanese_on\": \"SHA KYO\", \"korean\": \"CHA KE\", \"mandarin\": \"chē\", \"tang\": \"*giu chia\", \"vietnamese\": \"xa\"}\nE13 merged_record hanzi.historical_phonology [{\"gloss\": \"chariot\", \"gsr\": \"0074a\", \"middle_chinese\": \"tsyhae\", \"old_chinese\": \"*[t.qʰ](r)A\"}, {\"gloss\": \"chariot\", \"gsr\": \"0074a\", \"middle_chinese\": \"kjo\", \"old_chinese\": \"*C.q(r)a\"}, {\"old_chinese_zhengzhang\": \"*kʰlja\", \"source\": \"zhengzhang_wikt\"}, {\"old_chinese_zhengzhang\": \"*kla\", \"source\": \"zhengzhang_wikt\"}, {\"fanqie\": \"九魚\", \"middle_chinese_guangyun\": \"見開三C魚平\", \"source\": \"guangyun\"}, {\"fanqie\": \"尺遮\", \"middle_chinese_guangyun\": \"昌開三麻平\", \"\nE14 kanjidic2_via_build_kanji kanji.definition Car\nE15 kanjidic2_via_build_kanji kanji.readings {\"japanese_kun\": \"くるま\", \"japanese_on\": \"シャ\"}\nE16 ids_analysis kanji.etymology_notes[4] Etymological analysis: pictographic\nX-5c0577b71d57f19a425e Academia Sinica, Chinese Characters Database traditional 車 graphic history The database describes Shang oracle-bone forms as variable, sometimes depicting wheels, carriage body, axle, yoke, pole and crossbar; later forms retain selected features, producing the regular 車 form. It lists oracle-bone, bronze, Chu manuscript and seal-script evidence. This supports a pictorial graph, with reduction and stylization over time.\nX-c8c3bfc393ea59ebb382 Chinese University of Hong Kong, Multi-function Chinese Character Database traditional 車 forms and early uses The database says oracle-bone and bronze forms vary and may depict the vehicle’s wheels, body, axle, yoke, pole and crossbar. It reports an oracle-bone use for a vehicle in Heji 11452 (“six vehicles”), another in Heji 11450 (“vehicles and horses”), and a place-name use in Heji 584. Bronze inscriptions use 車 for vehicles and also for war chariots. These are source-reported inscription readings; the supplied page does not give calendar dates for ea\nX-f19b5bd85c060e5423c3 Academia Sinica, Chinese Characters Database traditional 車 graphic history The page distinguishes complex and simplified variants already present in Shang and Western Zhou writing, including complex and simpler forms in adjacent columns of the same Western Zhou inscription. It says the simpler 車 form had become the sole common form by the Eastern Zhou. This is a historical account of graphic variants, distinct from the much later modern simplified character 车.\nX-7ef1e98e72d456939698 Academia Sinica, Chinese Characters Database modern simplified 车 history The author identifies 车 as a cursive form of 車, attested by the Sui dynasty at the latest and continuing in later cursive writing, but says it did not become generally used as a standard character until adoption in the first simplified-character list. The formal 1956 reform resolution states that the first table of 230 simplified characters was to be used from 1 February 1956; the 1964 table lists 车 as a simplified component corresponding to 車. T\nX-466d0ff32f6ad74b285e Shuowen.org, online 說文解字 traditional 車 definition and historical account The entry defines 車 as the general name for carriage body and wheels, calls it pictographic, and repeats the traditional claim that Xi Zhong made it in the Xia period. Duan Yucai’s annotation explains the graph as depicting a body, two wheels and an axle, while challenging the claim that Xi Zhong was the first inventor. Treat the Xia attribution as a transmitted historical account, not independent confirmation.\nX-d628f651812de6cc0343 Taiwan Ministry of Education, Dictionary of Chinese Character Variants modern and historical senses; readings The dictionary records chē (ㄔㄜ) and jū (ㄐㄩ). It cites the basic vehicle sense and later extensions to wheeled machines, transporting by cart, a measure for cartloads, and the chess rook reading. It quotes examples from the Han shu, Nan shi, Tang, Song, Ming and Qing texts; these establish cited later uses, not the chronology of every semantic extension. Its entry gives 尺遮切 from Shuowen and lists Guangyun and Jiyun materials, including separate fi\nX-244d407ba653486c9b12 Taiwan Ministry of Education, Revised Mandarin Chinese Dictionary modern Mandarin senses The entry gives the standard Mandarin reading chē and describes vehicles, rotating machinery, machine sewing or cutting, and a measure for cartloads; it also lists jū as another reading. This is modern lexicographic evidence, not a dated account of when each sense arose.\nX-f3dead1c5135199c4bf6 Wiktionary, citing Baxter–Sagart historical phonology data traditional 車 readings and reconstructions For the two readings, the page reports Mandarin chē with Middle Chinese tsyhae and Baxter–Sagart Old Chinese *[t.qʰ](r)A, and Mandarin jū with Middle Chinese kjo and *C.q(r)a in the 2014 Baxter–Sagart system. Its table distinguishes two pronunciations of 車, not phonetic components within the graph. The page also reports Zhengzhang Old Chinese *kʰlja for chē and *kla for jū; these are a separate reconstruction system and should not be merged with \nX-22538951380b213dbde3 Dong Chinese modern simplified 车 and modern Mandarin readings The entry lists chē and jū and describes 车 as adapted from the cursive form of traditional 車. This is a secondary summary; the more detailed Sui-and-later chronology is reported separately by the Beijing Normal University study.\nX-ef8e35f848da3f16b4e2 Robert S. Bauer, Sino-Platonic Papers competing Old Chinese reconstructions Bauer’s 1994 comparison shows substantial variation among then-published reconstructions for the word 車, including forms around *khlja, *kalja and *k(r)ja. This reinforces that reconstructed sound forms depend on system and period; it does not establish a loan source or the original spoken name of the depicted vehicle.\nX-89d71d67cb807736af10 Encyclopaedia Iranica proposed Indo-Iranian comparison: source word and vehicle history The entry describes Indo-Iranian chariot traditions and the Iranian word čaxra- and Old Indian cakrá- for “wheel,” related to Indo-European *kʷékʷlo-. It reports datable Indo-Aryan chariot-racing terms in the Hittite Kikkuli treatise from the 14th century BCE, while noting that Avestan material cannot be precisely dated. This independently establishes relevant source-language vocabulary and chariot context, but not a borrowing into Chinese or the\nX-b1375ab9d8bbf24a5205 Victor Mair, Robert S. Bauer, and later discussion as summarized in S. V. Shaughnessy, Sino-Platonic Papers disputed whole-word loan proposals The inspected account attributes to Mair a proposal that Chinese 車 was borrowed from a Proto-Iranian form *caxra- “wheel,” and describes Bauer’s subsequent comparison of Chinese and Bodic wheel terms. A separate current Wiktionary entry reports a newer Sagart–Baxter (2025) proposal connecting Chinese readings to reflexes of Proto-Indo-Iranian *čakrám and suggests separate borrowing histories for chē and jū. These are proposals about the spoken wo\nX-7f9f75f8cde670dfc8e7 Wikisource transcription of the State Council resolution 1956 simplified-character standardization The transcribed resolution is dated 28 January 1956 and states the first table of 230 simplified characters was to be used in printed and handwritten documents from 1 February 1956. Its appendix lists 车（車） among the simplified components. This dates standardization, not the earlier cursive form’s origin.\nX-2fac4f5cdbbc22291c44 Academia Sinica, Chinese Characters Database graphic history of 車 Describes Shang oracle forms as variable, with detailed and abbreviated depictions of vehicle features including wheels, body/frame, crossbar, and yoke; says later writing selected some features to form regular 車. Its page displays oracle-bone, bronze, Chu manuscript, and seal-script categories. This supports pictographic formation and graphic reduction, without implying every version includes every named part.\nX-b80d69d439096a59a187 Chinese University of Hong Kong, Multi-function Chinese Character Database early graphic analysis and uses Reports variable oracle-bone and bronze forms depicting vehicle features, and that bronze forms are often written vertically. It identifies oracle-bone examples for vehicle use in Heji 11452 (“six vehicles”), vehicle-and-horse use in Heji 11450, and a place-name use in Heji 584. It reports bronze vehicle and war-chariot uses, and later Warring States bamboo-slip vehicle and chariot-punishment uses. These are inscription identifiers and source int\nX-15e93e2e2a80d13fceb9 Guoxuedashi character-form reference page graphic variants and dated bronze exemplars Lists oracle-bone examples by corpus references and bronze examples with period labels, including late Shang and Western Zhou. The page’s interpretation describes oracle forms with differing combinations of canopy, axle, wheels and vehicle body, and later verticalized forms. It classifies the graph as pictographic. This is a secondary reference and its detailed part-by-part interpretation is not independently demonstrated by the page.\nX-d7737fed17a64d5f7edf Wikimedia Commons file description Shang oracle glyph candidate and provenance The file page identifies the image as a modern SVG representation of 車 in Shang oracle script style. It names source databases and points to a specific Hanziyuan oracle image and Academia Sinica database image as references. The Commons page states CC0/public-domain dedication for the file; this is a redraw, not an artifact photograph.\nX-8440c9713ae6ceccedc3 Wikimedia Commons file description Western Zhou bronze glyph candidate and provenance The file page identifies the image as a modern SVG representation in Western Zhou bronze script style, citing the Hanziyuan image B19579 and Academia Sinica image 34.E39B (noted as 同卣, mid-Western Zhou). The Commons page states CC0/public-domain dedication for the redraw; it is not a photograph or direct scan of the bronze artifact.\nX-92557da0666ab03e988b Wikimedia Commons file description Shuowen seal glyph candidate and provenance The page identifies a modern SVG redraw of 車 in Shuowen seal-script style and cites Hanziyuan image s10685. It states the representation is public domain. This candidate can illustrate the later standardized seal-script shape, not an ancient artifact photograph.\nX-4b89657a402b48652637 Wikimedia Commons license deed CC0 reuse rights The Commons glyph pages identify CC0 1.0 Universal Public Domain Dedication. The license deed permits copying, modification, distribution, and commercial use without requesting permission, to the extent allowed by law.\nX-f251f574912023578809 Wikimedia Commons file description Shang oracle glyph identity and source Identifies this as a modern vector drawing of 車 in Shang oracle script style. The description cites a specific Hanziyuan image (J29288) and Academia Sinica image (43.F452); it does not represent a photograph of an inscribed artifact.\nX-2daf74220d5e73d4d9b7 Wikimedia Commons file description Western Zhou bronze glyph identity and source Identifies this as a modern vector drawing of 車 in Western Zhou bronze script style, citing Hanziyuan image B19579 and Academia Sinica image 34.E39B, associated on the page with 同卣 (mid-Western Zhou). The drawing is not an artifact photograph.\nX-cb4cf22db1b120ed3a22 Wikimedia Commons file description Shuowen seal glyph identity and source Identifies a modern vector drawing of 車 in Shuowen seal script style, citing Hanziyuan image s10685; the page history also says a later version was taken from Academia Sinica. This is a script representation, not an ancient artifact photograph.\nX-b087ee465f607263eb40 Wikimedia Commons file descriptions reuse rights The opened descriptions state that the vector representations are released under CC0/public-domain terms. The descriptions permit copying and reuse without requesting permission, to the extent allowed by law.\nX-a2ef5de8962249795356 Wikimedia Commons file description exact original image URL for Shang oracle candidate The page’s Original file link resolved to https://upload.wikimedia.org/wikipedia/commons/1/15/%E8%BB%8A-oracle.svg. The web viewer could not render the SVG content type, but the direct URL was obtained from the actual page link, not guessed.\nX-5dd5e9544541000b352b Wikimedia Commons file description exact original image URL for Western Zhou bronze candidate The page’s Original file link resolved to https://upload.wikimedia.org/wikipedia/commons/2/25/%E8%BB%8A-bronze-5.svg. The direct fetch returned a cache miss in the web viewer; URL is copied from the page link and not inferred from a hash pattern.\nX-7bbf929191ab97357884 Wikimedia Commons file description exact original image URL for Shuowen seal candidate The page’s Original file link resolved to https://upload.wikimedia.org/wikipedia/commons/a/a7/%E8%BB%8A-seal.svg. The web viewer could not render the SVG content type; the direct URL was taken from the linked file page.\nglyph research {\"historical_glyphs\": {\"items\": [{\"id\": \"車-oracle\", \"image_url\": \"https://upload.wikimedia.org/wikipedia/commons/1/15/%E8%BB%8A-oracle.svg\", \"source_url\": \"https://commons.wikimedia.org/wiki/File:%E8%BB%8A-oracle.svg\", \"source_title\": \"File:車-oracle.svg — Wikimedia Commons\", \"period\": \"Shang dynasty, oracle-bone script style\", \"tradition\": \"Chinese oracle-bone script; modern vector redraw based on cited Hanziyuan and Academia Sinica character images\", \"caption\": \"An oracle-bone style form of 車 has a long central shaft crossed by a bar, with a vehicle body and wheel-like shapes below. Early forms varied in which vehicle features they showed.\", \"alt\": \"Black oracle-bone style character with a vertical central stroke, a broad crossbar, and a lower section containing several openings.\", \"selection_reason\": \"Provides a clear early pictorial example consistent with descriptions of variable vehicle features in oracle-bone forms.\", \"rights\": \"CC0 / public-domain dedication stated on the Commons page.\", \"rights_url\": \"https://creativecommons.org/publicdomain/zero/1.0/deed.en\", \"evidence_ids\": [\"X-2fac4f5cdbbc22291c44\", \"X-f251f574912023578809\"]}, {\"id\": \"車-bronze-western\", \"image_url\": \"https://upload.wikimedia.org/wikipedia/commons/2/25/%E8%BB%8A-bronze-5.svg\", \"source_url\": \"https://commons.wikimedia.org/wiki/File:%E8%BB%8A-bronze-5.svg\", \"source_title\": \"File:車-bronze-5.svg — Wikimedia Commons\", \"period\": \"Mid-Western Zhou, bronze-script style\", \"tradition\": \"Chinese bronze-inscrip\n\n source_findings.json\n{\n  \"source_id\": \"ziyuan-2012\",\n  \"tracking_issue_url\": \"https://github.com/lbm364dl/hanzi-etymology-dict/issues/344\",\n  \"requires_coordinator_verification\": true,\n  \"findings\": [\n    {\n      \"key\": \"ziyuan-2012:8F66:869956813d6e\",\n      \"kind\": \"ocr\",\n      \"title\": \"Verify 字源 scan finding for 8F66\",\n      \"details\": \"[SCAN VERIFICATION REQUIRED] 字源 PDF p.1260, printed p.1245, quoted occurrence beginning 郭沫若《卜辞通纂》：“二车字一作…”. The book scan visibly contains embedded rare glyph drawings in this quotation; their exact scalar identities cannot be established from the typography/OCR. The quotation’s surrounding discussion is legible, but do not replace the drawings with guessed Unicode.\",\n      \"verification\": \"Check the identified printed page and exact scan span; correct source-bound OCR or record an unresolved glyph identity.\",\n      \"evidence\": [\n        \"Source job: /home/catalin/hanzi-etymology-dict/runs/fresh-three-slot-smoke-20261004/ziyuan-2012/8F66\",\n        \"Research output: initial-followup/research/result.json\"\n      ]\n    }\n  ]\n}\n\n source_audit.json\n{\n  \"source_id\": \"ziyuan-2012\",\n  \"source_hash\": \"5d04edff24c3919be47596b6a79a61a85ce0a9637edc6fe35cfa1f612918a0fc\",\n  \"verified\": false,\n  \"citations\": [],\n  \"consulted_citations\": [\n    {\n      \"research_output\": \"initial-followup/research/result.json\",\n      \"research_receipt_hash\": \"37d207bd6ddf0af0ace56a81495c63ee9a33cc32c00db32f673d5fd1b2d79aec\",\n      \"research_result_hash\": \"868d40bb4be3d91bb2a4f7ba09f0485a6c8ecaf0f6dd4910164aa65b3ef9888e\",\n      \"source\": \"李學勤主編《字源》, 天津古籍出版社／遼寧人民出版社, 2012\",\n      \"field\": \"車部 entry; PDF p.1260, printed p.1245; scan /home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1260/source.png; inspected original pixels, including the 車 headword, historical-form rows, and paragraph\",\n      \"text\": \"The entry is headed 車(车), gives the readings chē and a traditional phonological classification, and labels 車 a 形聲字. It quotes 說文’s account of 車 as the collective name for vehicle body and wheels and as pictographic, then discusses changing depictions: some oracle-bone and late Shang/early Zhou bronze forms omit features, and a reduced form is analyzed as a wheel-and-axle depiction. Its forms row includes oracle-bone, bronze, 說文 small-seal, regular 車, and regular 车. The book’s account is a distinct, more detailed analysis than a simple uniformly pictographic description; retain attribution and the book’s stated uncertainty around individual forms.\",\n      \"evidence_ids\": [\n        \"X-5eed7aacb173bf712b8d\"\n      ]\n    }\n  ]\n}\n\n initial-followup/research/result.json\n{\n  \"evidence\": [\n    {\n      \"source\": \"李學勤主編《字源》, 天津古籍出版社／遼寧人民出版社, 2012\",\n      \"field\": \"車部 entry; PDF p.1260, printed p.1245; scan /home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1260/source.png; inspected original pixels, including the 車 headword, historical-form rows, and paragraph\",\n      \"text\": \"The entry is headed 車(车), gives the readings chē and a traditional phonological classification, and labels 車 a 形聲字. It quotes 說文’s account of 車 as the collective name for vehicle body and wheels and as pictographic, then discusses changing depictions: some oracle-bone and late Shang/early Zhou bronze forms omit features, and a reduced form is analyzed as a wheel-and-axle depiction. Its forms row includes oracle-bone, bronze, 說文 small-seal, regular 車, and regular 车. The book’s account is a distinct, more detailed analysis than a simple uniformly pictographic description; retain attribution and the book’s stated uncertainty around individual forms.\",\n      \"record_character\": \"車\",\n      \"kind\": \"local_book_scan\",\n      \"url\": \"https://www.worldcat.org/search?q=9787552800692\",\n      \"title\": \"字源 (2012 edition; inspected PDF page 1260, printed page 1245)\",\n      \"accessed_at\": \"2026-10-04\"\n    },\n    {\n      \"source\": \"Academia Sinica, Chinese Characters Database\",\n      \"field\": \"車 graphic history\",\n      \"text\": \"The database describes oracle forms of 車 as variable depictions of vehicle features, including wheels, body/framework, crossbar and yoke; later forms select features and develop toward regular 車. This supports a pictographic graphic history, though the book’s more specific account of a reduced form as wheel-and-axle is not independently established by this summary.\",\n      \"record_character\": \"車\",\n      \"kind\": \"external_dictionary\",\n      \"url\": \"https://chardb.iis.sinica.edu.tw/evolution.jsp?cid=23348\",\n      \"title\": \"漢字「車」：字形演變\",\n      \"accessed_at\": \"2026-10-04\"\n    },\n    {\n      \"source\": \"Chinese University of Hong Kong, Multi-function Chinese Character Database\",\n      \"field\": \"oracle-bone and bronze uses; graphic description\",\n      \"text\": \"The database describes variable oracle and bronze forms that may show wheels, body, axle, yoke, pole and crossbar. It identifies oracle-bone examples Heji 11452 for vehicles (“six vehicles”), Heji 11450 for 車馬, and Heji 584 as a place-name use; bronze examples include vehicle and war-chariot uses. These are the database’s readings of cited inscriptions; it does not give calendar dates for those individual examples.\",\n      \"record_character\": \"車\",\n      \"kind\": \"primary_evidence_report\",\n      \"url\": \"https://humanum.arts.cuhk.edu.hk/Lexis/lexi-mf/oraclePiece.php?piece=%E8%BB%8A&sub=1\",\n      \"title\": \"漢語多功能字庫 — 車\",\n      \"accessed_at\": \"2026-10-04\"\n    },\n    {\n      \"source\": \"Taiwan Ministry of Education, Concised Mandarin Chinese Dictionary\",\n      \"field\": \"車 current Mandarin reading and senses\",\n      \"text\": \"The inspected entry gives chē and lists vehicle, machinery using rotating axles, machine sewing/cutting, and a cartload measure without marking these senses obsolete or restricting them to historical quotations. This supports current lexicographic status for these senses, but does not date their semantic development.\",\n      \"record_character\": \"車\",\n      \"kind\": \"current_dictionary\",\n      \"url\": \"https://dict.concised.moe.edu.tw/dictView.jsp?ID=31626&la=1&powerMode=0\",\n      \"title\": \"《國語辭典簡編本》：車\",\n      \"accessed_at\": \"2026-10-04\"\n    },\n    {\n      \"source\": \"Unicode Consortium, Unihan Database\",\n      \"field\": \"車 readings and simplified variant\",\n      \"text\": \"The official Unihan record for U+8ECA lists kMandarin chē, kHanyuPinyin chē,jū, and simplified variant 车. This is current character metadata, not evidence for an ancient sound relationship or a historical explanation of simplification.\",\n      \"record_character\": \"車\",\n      \"kind\": \"official_character_metadata\",\n      \"url\": \"https://www.unicode.org/cgi-bin/GetUnihanData.pl?codepoint=8ECA\",\n      \"title\": \"Unihan data for U+8ECA\",\n      \"accessed_at\": \"2026-10-04\"\n    },\n    {\n      \"source\": \"Local HSK1 Unihan extract\",\n      \"field\": \"pipeline/data/unihan-kmandarin-hsk1.tsv; exact local row for 车\",\n      \"text\": \"The supplied local row lists kMandarin for 车 as chē. This corroborates the current reading only; it does not establish historical sound relationships. The official Unihan record for the traditional counterpart is cited separately.\",\n      \"record_character\": \"车\",\n      \"kind\": \"local_reading_row\",\n      \"url\": \"https://www.unicode.org/cgi-bin/GetUnihanData.pl?codepoint=8F66\",\n      \"title\": \"Unihan data for U+8F66\",\n      \"accessed_at\": \"2026-10-04\"\n    },\n    {\n      \"source\": \"国务院《汉字简化方案》, transcribed at Wikisource\",\n      \"field\": \"1956 resolution and first simplified-character table\",\n      \"text\": \"The resolution states the first table of 230 simplified characters was to be used in printed and handwritten documents from 1 February 1956. This supports the standardization date, not the origin of the earlier cursive form. The official Ministry page was located in search but opening it failed with a redirect loop; the inspected text here is the Wikisource transcription.\",\n      \"record_character\": \"车\",\n      \"kind\": \"primary_document_transcription\",\n      \"url\": \"https://zh.wikisource.org/zh-hans/%E6%BC%A2%E5%AD%97%E7%B0%A1%E5%8C%96%E6%96%B9%E6%A1%88\",\n      \"title\": \"汉字简化方案 — 国务院关于公布汉字简化方案的决议\",\n      \"accessed_at\": \"2026-10-04\"\n    }\n  ],\n\n source_article.json\n{\n  \"character\": \"车\",\n  \"summary\": {\n    \"text\": \"车 is a modern simplified form of 車, a pictograph of a wheeled vehicle. Its shape derives from the traditional graph’s cursive form.\",\n    \"evidence_ids\": [\n      \"X-7ef1e98e72d456939698\",\n      \"X-2fac4f5cdbbc22291c44\"\n    ]\n  },\n  \"formation\": {\n    \"text\": \"The traditional graph 車 pictures a vehicle as a whole. Early forms varied in the features shown; later forms selected and regularized some of them. The modern graph 车 derives from cursive 車.\",\n    \"evidence_ids\": [\n      \"X-5c0577b71d57f19a425e\",\n      \"X-7ef1e98e72d456939698\",\n      \"X-2fac4f5cdbbc22291c44\"\n    ],\n    \"type\": \"pictographic\"\n  },\n  \"components\": [],\n  \"history\": [\n    {\n      \"text\": \"Early oracle-bone and bronze forms of 車 varied in the vehicle features shown. Later forms selected and regularized some features. The curated oracle-bone, Western Zhou bronze, and seal-script examples illustrate different presentations; they are modern redrawings, not artifact photographs.\",\n      \"evidence_ids\": [\n        \"X-2fac4f5cdbbc22291c44\",\n        \"X-f251f574912023578809\",\n        \"X-2daf74220d5e73d4d9b7\",\n        \"X-cb4cf22db1b120ed3a22\"\n      ]\n    },\n    {\n      \"text\": \"The modern simplified form 车 derives from cursive 車, attested by the Sui dynasty at the latest. It became a standard character in 1956. This change is distinct from earlier variation within 車.\",\n      \"evidence_ids\": [\n        \"X-f19b5bd85c060e5423c3\",\n        \"X-7ef1e98e72d456939698\",\n        \"X-7f9f75f8cde670dfc8e7\"\n      ]\n    }\n  ],\n  \"uncertainties\": [\n    {\n      \"text\": \"Early forms varied, and the curated images are modern redrawings. Individual vehicle features in any one drawing should therefore be interpreted cautiously.\",\n      \"evidence_ids\": [\n        \"X-2fac4f5cdbbc22291c44\",\n        \"X-f251f574912023578809\",\n        \"X-2daf74220d5e73d4d9b7\",\n        \"X-cb4cf22db1b120ed3a22\"\n      ]\n    },\n    {\n      \"text\": \"Early vehicle uses are identified by inscription references, but the cited evidence gives neither calendar dates for those inscriptions nor a precise earliest date for the graph.\",\n      \"evidence_ids\": [\n        \"X-c8c3bfc393ea59ebb382\",\n        \"X-b80d69d439096a59a187\"\n      ]\n    }\n  ],\n  \"schema_version\": 2,\n  \"meaning_history\": {\n    \"senses\": [\n      {\n        \"id\": \"车:vehicle\",\n        \"gloss\": \"vehicle; cart or chariot\",\n        \"period\": \"Early inscriptions; individual dates unresolved\",\n        \"certainty\": \"established\",\n        \"status\": \"earliest_attested\",\n        \"text\": \"Oracle-bone examples use 車 for vehicles, and bronze examples include vehicles and war chariots. These attest early vehicle-related use but do not establish a calendar-dated first occurrence.\",\n        \"evidence_ids\": [\n          \"X-c8c3bfc393ea59ebb382\",\n          \"X-b80d69d439096a59a187\"\n        ]\n      },\n      {\n        \"id\": \"车:place_name\",\n        \"gloss\": \"place name\",\n        \"period\": \"Early inscriptions; dating unresolved\",\n        \"certainty\": \"establish\n","exit_code":0,"status":"completed"}}
