{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"{\"edits\":[{\"path\":\"meaning_history/senses/0/status\",\"value_json\":\"\\\"current\\\"\"},{\"path\":\"meaning_history/senses/0/period\",\"value_json\":\"Late Warring States evidence reported; current use\"},{\"path\":\"meaning_history/senses/0/text\",\"value_json\":\"The character is used for “ask” or “inquire.” Its use in that sense is reported in late Warring States Qin slips as the earliest clear graph for the word in the evidence discussed. This does not establish that asking was the word’s original meaning.\"},{\"path\":\"meaning_history/senses/0/evidence_ids\",\"value_json\":\"[\\\"ref029\\\",\\\"ref054\\\",\\\"ref056\\\"]\"},{\"path\":\"meaning_history/senses/2\",\"value_json\":\"{\\\"id\\\":\\\"问:current_ask\\\",\\\"gloss\\\":\\\"ask about; inquire after\\\",\\\"period\\\":\\\"Modern\\\",\\\"certainty\\\":\\\"established\\\",\\\"status\\\":\\\"current\\\",\\\"text\\\":\\\"Present-day definitions include “ask about” and “inquire after.”\\\",\\\"evidence_ids\\\":[\\\"ref004\\\",\\\"ref011\\\",\\\"ref056\\\"]}\"}]}"}}
