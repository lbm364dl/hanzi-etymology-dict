", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g024\", \"description\": \"战国古文上字形体2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g025\", \"description\": \"战国古文上字形体3\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g026\", \"description\": \"战国楚系文字上字形体4（从是）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g027\", \"description\": \"战国文字上字形体5（从辵）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g028\", \"description\": \"战国楚系文字上字形体6（从止）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g029\", \"description\": \"《说文》小篆上字形体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g030\", \"description\": \"汉代隶书上字形体1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0014/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g031\", \"description\": \"汉代隶书上字形体2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-