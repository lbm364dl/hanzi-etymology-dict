ce_bbox_xyxy\": null}, {\"id\": \"g029\", \"description\": \"Small seal form of 祇 (从示氏声)\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0017/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g030\", \"description\": \"Han clerical form of 祇\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0017/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g031\", \"description\": \"Ancient form for 抵/祇 (showing hands/ram horns meeting)\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0017/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g032\", \"description\": \"Ancient form for 抵/祇\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0017/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g033\", \"description\": \"Ancient form for 抵/祇\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0017/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g034\", \"description\": \"Ancient form component (ram/sheep horns/head symbol)\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0017/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n19:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000019\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 19, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"2120f89f04c5944780123e0f53eaad0489fcd2d44eb738eae498932af86c022a\", \"evidence_sha256\": \"d065594380a447734a338ce18500a96dbc3e6ccd33b76687792d51a89e586696\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"禔 神 祇 祕 齋 裡 祭 祀 柴 襯\\n\\n1、2《金文编》11页。3、4《说文》8页。5《篆隶表》10页。\\n形声字。从示，覀声。本义是指一种祭名。古人升烟以祭天，先烧柴升烟，再加牲体及玉帛于柴上焚烧，因烟气上达以致精诚。《周礼·春官·大宗伯》：“以裡祀祀昊天上帝。”郑玄注：“裡之言烟，周人尚臭，烟，气之臭闻者……三祀皆积柴实牲体焉，或有玉帛，燔燎而升烟，所以报阳也。”墙盘：“乂其裡祀。”嘉鼎：“是唯哀成叔之鼎，永用裡祀。”“裡”字即用此义。引申之也泛指虔诚的祭祀。《说文》：“裡，洁祀也。一日精意以享为裡。”蔡侯盘：“裡享是以。”“裡”字即用此义。西周文字中“裡”字从宀、从示、从火，西声；或从宀，煙(烟)声。春秋文字则演变为从示西声。战国文字继承春秋文字，但仍保留西周文字中的“宀”旁，秦代及秦代以后的“裡”字则是春秋“裡”字的延续，虽书体有变化，但字形结构未变。（白于蓝）\\n\\n祭 jì 精纽、月部；精纽、祭韵、子例切。\\nzhài 精纽、月部；庄纽、怪韵、侧界切。\\n[glyph:g001] 商\\n[glyph:g002] 商\\n[glyph:g003] 西周\\n[glyph:g004] 春秋\\n[glyph:g005] 春秋\\n[glyph:g006] 战国\\n[glyph:g007] 战国\\n[glyph:g008] 《说文》小篆\\n[glyph:g009] 汉\\n祭 楷书\\n\\n1、2《甲文编》8页。3-6《金文编》11页。7《楚系简帛》21页。8《说文》8页。9《篆隶表》11页。\\n会意字。从示，从又，从肉。始见于甲骨文。本义是指祭祀。《说文》：“祭，祭祀也。”《合集》22692：“丁卯卜，即贞：王宾报丁，祭，亡尤？”（丁卯这一天占卜，由即这个人贞问：商王若迎导报丁的神灵，举行祭祀，不会有灾祸吗？）金文栾书缶：“以祭我皇祖。”这种用法的“祭”今天读jì。甲骨文中早期的“祭”字作“[glyph:g010]”，从又、从肉，会以手持肉祭祀之意，上下小点表示血滴。晚期甲骨文追加“示”旁，并将“肉”旁变为“口”形。西周金文承袭甲骨文晚期的写法，但将“肉”旁变为“[glyph:g011]”形。春秋、战国、秦代以及汉代文字中基本沿袭西周文字的写法。但在春秋、战国时期，“祭”字所从的“又”旁或可写作“[glyph:g012]”、“[glyph:g013]”，乃“攴”字。这是因为古文字中，“又”、“攴”、“殳”等字在用作表意偏旁时常可互换的缘故。现代文字基本沿袭汉代“祭”字的写法，只是将“又”旁省变为“又”形。春秋时期，在今天河南郑州东北有一个祭国，“祭国”之“祭”今天读zhài。（白于蓝）\\n\\n祀 sì 邪纽、之部；邪纽、止韵、详里切。\\n[glyph:g014] 商\\n[glyph:g015] 商\\n[glyph:g016] 西周\\n[glyph:g017] 西周\\n[glyph:g018] 春秋\\n[glyph:g019] 战国\\n[glyph:g020] 战国\\n[glyph:g021] 《说文》小篆\\n[glyph:g022] 《说文》或体\\n[glyph:g023] 汉\\n祀 楷书\\n\\n1、2《甲文编》8页。3《金文编》11页。4、5《类编》174页。6、7《古字典》64页。8、9《说文》8页。10《篆隶表》11页。\\n形声字。从示，巳声。始见于甲骨文。本义是指永久祭祀。《说文》：“祀，祭无已也。”徐锴系传：“《老子》曰：‘子孙祭祀不辍’是也。”智鼎：“智其万(年)用祀。”“祀”字即用此义。引申之则泛指祭祀。《国语·周语上》：“夫祀，国之大节也。”甲骨文《殷契佚存》：“其祀多先祖。”金文天亡簋：“王祀于天室。”“祀”即指祭祀而言。“祀”字历代字形一脉相承，变化不是很大，只是在西周和战国文字中有在声旁“巳”字上加“[glyph:g024]”和“[glyph:g025]”为饰笔。在秦代文字中，“祀”字还出现了“[glyph:g026]”这种异体。甲骨文中“祀”与“巳”有时可以通用。《小屯·殷墟文字乙编》2587：“庚寅卜，争贞：极其祀于河。”《战后南北所见甲骨录·南北坊间所见甲骨录》3.35：“贞：巳河。”“祀”字可能是“巳”字之孳乳分化字。关于“巳”字之字形演变，参见“巳”字条。（白于蓝）\\n\\n柴 chái 崇纽、支部；崇纽、佳韵、士佳切。\\n[glyph:g027] 《说文》古文\\n[glyph:g028] 《说文》小篆\\n柴 楷书\\n\\n1、2《说文》8页。\\n形声字。从示，此声。本义是指焚柴祭天，也作“柴”。《说文》：“柴，烧柴焚燎以祭天神。”《集韵·佳韵》：“柴，通作柴。”《史记·五帝本纪》：“东巡守，至于岱宗，柴。”裴骃集解引郑玄曰：“柴，燎也。”《说文》古文“柴”字“从隋省”声。“隋”、“此”古音相近，故“柴”或可从“隋”声作。（白于蓝）\\n\\n衬 fù 并纽、侯部；奉纽、遇韵、符遇切。\\n[glyph:g029] 《说文》小篆\\n[glyph:g030] 汉\\n衬 楷书\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"甲骨文‘祭’字字形，商代\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"甲骨文‘祭’字字形，商代，带示部\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"金文‘祭’字字形，西周\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"金文‘祭’字字形，春秋\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"春秋‘祭’字异体字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"战国‘祭’字字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"战国‘祭’字异体字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"《说文》小篆‘祭’字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0019/source.png\", \"sourc