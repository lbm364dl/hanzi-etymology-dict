": [{\"id\": \"p001\", \"description\": \"Uncommon Chinese printed character in title '中山王[?]器文字编', composed of left component 璺/斲-like or 爨/璺-related, appearing as 𪚥 or 爨 variant (cuàn/xī) often referring to King of Zhongshan's vessels.\", \"kind\": \"unidentified_printed_character\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0010/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [\"Character in '中山王[glyph:p001]器文字编' is printed with a complex ideograph (often transcribed as 璺, 𪚥, or related Zhongshan King vessel name); represented as [glyph:p001].\"], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n11:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000011\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f