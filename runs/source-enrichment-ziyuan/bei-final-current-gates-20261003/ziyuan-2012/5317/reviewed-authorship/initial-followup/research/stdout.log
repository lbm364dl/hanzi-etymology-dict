0\", \"description\": \"楷书“辫”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"战国文字“绷”形一\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"战国文字“绷”形二\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"战国文字“绷”形三\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"战国文字“绷”形四\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"《说文》小篆“繃”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"楷书“繃”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g017\", \"description\": \"楷书“绷”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1151/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g018\", \"description\": \"战国文字“结”形一\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/