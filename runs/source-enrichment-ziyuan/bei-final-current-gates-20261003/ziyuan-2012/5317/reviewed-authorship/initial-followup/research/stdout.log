home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"Han dynasty form of 迸 1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"Han dynasty form of 迸 2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g017\", \"description\": \"Han dynasty form of 迸 3\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g018\", \"description\": \"Kaishu form of 迸 with full 并\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g019\", \"description\": \"Oracle/bronze script form showing two people standing side by side with connecting horizontal strokes\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g020\", \"description\": \"Small seal script form of 并\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g021\", \"description\": \"Seal character of 透 from Shuowen Xinfa\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0147/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g022\", \"description\": \"Seal character of 邐 from Shuowen