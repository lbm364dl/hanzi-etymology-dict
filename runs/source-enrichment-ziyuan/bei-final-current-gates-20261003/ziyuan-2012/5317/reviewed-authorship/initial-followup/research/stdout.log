1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"战国文字“坡”字形2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"《说文》小篆“坡”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"汉代“坡”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"睡虎地秦简中“皮”的构件/字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"战国文字“坪”字形1，从土从平\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"战国文字“坪”字形2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"《说文系传》上下结构“坪”字小篆\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"战国文字“坪”字形3\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g017\", \"description\": \"《说文》小篆“坪”字形5，左右结构\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1194/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n1198:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001198\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 1198, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"e7e94dd4832ab5a7c2da587cbe589faf13df6bbe977641fc7f2ec06b53bbfa1a\", \"evidence_sha256\": \"2466d5f24d10d9b10685f053289741fe73b243285b54bd28b66a57c38b83118a\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"基 垣 圪 堵 壁 埒 堪 堂 垛\\n\\n壁\\nbì 帮组、锡部；帮组、锡韵、北激切。\\n[glyph:g001]¹——[glyph:g002]²——[glyph:g003]³——[glyph:g004]⁴——[glyph:g005]⁵——壁\\n战国 《说文》小篆 秦 汉 汉 楷书\\n1《包山》202页。2《说文》287页。3《睡甲》201页。4、5《甲金篆》941页。\\n形声字。从土，辟声。战国文字声符“辟”左下从两圆圈，“辛”旁写法也有异，当是繁构。字形3、4、5整字大致呈左右结构，字形4、5声符“辟”之右边“辛”字多一横笔，这些都是隶书的常见变化。“壁”的本义是墙壁。《说文》：“壁，垣也。”《仪礼·特牲馈食礼》：“饎爨在西壁。”引申为营垒、陡峭的山崖等。又为二十八宿之一，北方玄武七宿(斗、牛、女、虚、危、室、壁)的最后一宿。有星两颗，又称“东壁”。(林志强)\\n\\n埒\\nliè 来组、月部；来组、薛韵、力辍切。\\n[glyph:g006]¹——埒\\n《说文》小篆 楷书\\n1《说文》287页。\\n形声字。从土，爫声。本义指矮围墙。《说文》：“埒，卑垣也。”《世说新语·汰侈》：“于时人多地贵，(王)济好马射，买地作埒，编钱匝地，竞埒，时人号曰金沟。”引申为田塍、涯际、界限等。(林志强)\\n\\n堪\\nkān 溪组、侵部；溪组、覃韵、口念切。\\n[glyph:g007]¹——[glyph:g008]²——[glyph:g009]³——[glyph:g010]⁴——堪\\n战国 《说文》小篆 秦 汉 楷书\\n1、4《甲金篆》941页。2《说文》287页。3《睡甲》201页。\\n形声字。从土，甚声。字形1为三体石经古文，声符“甚”所从之“甘”近似“日”字，所从之“匹”则有点像“正”。字形4“匹”旁也近似“正”字。写法均稍有变化。“堪”的本义是地面突起处。《说文》：“堪，地突也。”睡虎地秦墓竹简《封诊式·经死》：“权(椽)大一围，袤三尺，西去堪二尺，堪上可道终索。”引申指陈放东西的壁坎或石室，后专指供奉神像的石室或柜子。在这个意义上，“堪”同“龛”。再引申为堪载、承受、经得起、胜任等。通“戡”。杀。《墨子·非攻下》：“天乃命汤于镳宫，用受夏之大命。夏德大乱，予既卒其命于天矣，往而诛之，必使汝堪之。”毕沅注：“堪，《文选》注，《艺文类聚》引作戡。”(林志强)\\n\\n堂\\ntáng 定组、阳部；定组、唐韵、徒郎切。\\n[glyph:g011]¹——[glyph:g012]²——[glyph:g013]³——[glyph:g014]⁴——[glyph:g015]⁵——[glyph:g016]⁶——[glyph:g017]⁷——[glyph:g018]⁸——[glyph:g019]⁹——堂\\n战国 《说文》古文 楷书\\n西周 《说文》籀文 战国 《说文》小篆 汉 汉 楷书\\n战国 战国\\n1《金文编》884页。2、6、7《说文》287页。3《中山》41页。4、5《古玺》319页。8、9《甲金篆》942页。10《郭店》184页。\\n形声字。从土，尚声。西周文字从“高”省，声符“尚”字不从“口”，“土”旁也稍异。此字中“高”、“土”都是意符，从“高”表示殿堂之高，从“土”表示建筑殿堂的材料。《说文》籀文承之，从“高”省，但声符“尚”为全形。战国文字主要有三种写法：一从“土”，从省“口”之“尚”，如字形3；一从“立”，也从省“口”之“尚”，如字形5、10，字形10“立”字上下有短横，当为饰笔；一从“土”，“尚”不省，如字形4。最后这种写法发展成为现代汉字。“堂”的本义是坛，即人工筑成的方形土台或屋基。《书·大诰》：“若考作室，既底(zhǐ)法，厥子乃弗肯堂，矧肯构。”孔传：“子乃不肯为堂基，况肯构立屋乎？”清俞樾《群经平议·尚书三》：“古人封土而高之，其形四方，即谓之堂。”引申指建于台基之上的正屋、厅堂，如殿堂、明堂、礼堂、公堂、课堂等。正屋、厅堂是公开议事的地方，也是装饰华丽的地方，因此堂又有明亮、显耀等意义。叠音词“堂堂”用于形容阵容盛大、气魄宏大、容貌伟俊出众等，当也与此意义有关。旧时尊称他人的母亲也叫堂，如令堂、萱堂。同祖父的亲属也称堂，如堂兄、堂叔。作量词，用于成套家具、分节的课程等，如一堂家具、一堂课。(林志强)\\n\\n垛\\nduǒ duò 端组、歌部；端组、戈韵、丁戈切。\\n[glyph:g020]¹——[glyph:g021]²——垛\\n《说文》小篆 汉 楷书\\n1《说文》287页。2《甲金篆》942页。\\n形声字。从土，朵声。楷书或作“垛”，上部写作“乃”，是隶变的不同写法。“垛”指古代门堂两侧的房间。《说文》：“垛，堂塾也。”后俗称墙两侧或上头伸出的部分为垛。如城垛子。《水浒续集》第三十三回：“共涛依言，令\\n1183\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"战国文字“壁”字形，左“辟”右“土”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"《说文》小篆“壁”字形，上“辟”下“土”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"秦代简牍文字“壁”字形，左右结构\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"汉代隶书“壁”字形，左右结构\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"汉代隶书“壁”字形，左右结构\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1198/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"《说文》小篆“埒”字形，左“土”右“爫”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/h