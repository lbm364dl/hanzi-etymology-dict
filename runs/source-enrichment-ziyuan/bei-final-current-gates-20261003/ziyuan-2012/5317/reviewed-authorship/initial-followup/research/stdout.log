箪 395\\n筚(筚) 405\\n畀 409\\n冨 479\\n枇 496\\n椑 523\\n柲 527\\n柽 532\\n賁(贲) 566\\n費(费) 574\\n郯 588\\n馥 644\\n痹 676\\n瘴 676\\n幣(币) 688\\n敝 696\\n敝 697\\n毖 725\\n裨 735\\n襞 736\\n髮 792\\n卸 797\\n迎 797\\n辟 800\\n劈 800\\n癖(壁) 824\\n庇 827\\n弊(毙) 880\\n煇(烨) 888\\n幅 929\\n泌 976\\n澤(泲) 1022\\n閥(阏) 1042\\n閉(闭) 1043\\n婢 1092\\n檗 1098\\n彈 1126\\n弼 1127\\n璧 1183\\n埤 1189\\n陂 1257\\n陛 1262\\n1376\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1391/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1391/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1391/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n","exit_code":0,"status":"completed"}}
