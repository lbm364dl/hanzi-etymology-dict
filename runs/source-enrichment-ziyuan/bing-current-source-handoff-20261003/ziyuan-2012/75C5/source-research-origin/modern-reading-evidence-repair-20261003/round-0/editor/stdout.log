{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"{\"edits\":[{\"path\":\"components/1/sound\",\"value_json\":\"[{\\\"text\\\":\\\"The reconstructed forms share the rhyme and much segmental material, with differences in initial and Old Chinese suffix; both values are reconstructions.\\\",\\\"evidence_ids\\\":[\\\"ref016\\\",\\\"ref022\\\"],\\\"component_form\\\":\\\"丙\\\",\\\"component_reading\\\":\\\"*pqraŋʔ\\\",\\\"character_reading\\\":\\\"*braŋs\\\",\\\"system\\\":\\\"Zhengzhang Old Chinese (2003)\\\"},{\\\"text\\\":\\\"The reconstructed forms share the rhyme and much segmental material, with differences in initial and suffix; these are not directly attested speech forms.\\\",\\\"evidence_ids\\\":[\\\"ref015\\\",\\\"ref016\\\",\\\"ref020\\\"],\\\"component_form\\\":\\\"丙\\\",\\\"component_reading\\\":\\\"*praŋʔ\\\",\\\"character_reading\\\":\\\"*[b]raŋ-s\\\",\\\"system\\\":\\\"Baxter–Sagart Old Chinese (2014)\\\"},{\\\"text\\\":\\\"The current Mandarin readings are bǐng for 丙 and bìng for 病. This modern comparison does not by itself establish their historical phonetic relationship.\\\",\\\"evidence_ids\\\":[\\\"ref042\\\",\\\"ref052\\\",\\\"ref053\\\"],\\\"component_form\\\":\\\"丙\\\",\\\"component_reading\\\":\\\"bǐng\\\",\\\"character_reading\\\":\\\"bìng\\\",\\\"system\\\":\\\"Modern Mandarin\\\"}]\"},{\"path\":\"components/1/evidence_ids\",\"value_json\":\"[\\\"ref003\\\",\\\"ref015\\\",\\\"ref016\\\",\\\"ref022\\\",\\\"ref038\\\",\\\"ref042\\\",\\\"ref052\\\",\\\"ref053\\\"]\"}]}"}}
