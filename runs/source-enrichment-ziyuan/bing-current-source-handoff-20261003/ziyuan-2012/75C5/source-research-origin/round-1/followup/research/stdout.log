-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g022\", \"description\": \"战国文字“彝”字字形22\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g023\", \"description\": \"三体石经古文“彝”字字形23\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g024\", \"description\": \"《说文》古文“彝”字字形24\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g025\", \"description\": \"《说文》古文“彝”字字形25\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g026\", \"description\": \"《说文》小篆“彝”字字形26\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g027\", \"description\": \"汉代隶书“彝”字字形27\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g028\", \"description\": \"楷书“彝”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g029\", \"description\": \"正文中提到的双手形部件或构件\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g030\", \"description\": \"正文中提到的无头俘虏被缚形部件\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g031\", \"description\": \"正文中提到的金文偏旁“彳”形变体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g032\", \"description\": \"正文中提到的金文偏旁“辵/走”形变体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g033\", \"description\": \"正文中提到的“攵”形或手持扑击部件\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g034\", \"description\": \"正文中提到的反缚两手之形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g035\", \"description\": \"正文中提到的上部讹变之形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g036\", \"description\": \"正文中提到的三体石经古文上部讹变形体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g037\", \"description\": \"《说文》小篆“緻”字字形1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g038\", \"description\": \"楷书“緻”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g039\", \"description\": \"《说文》新附“緋”字字形1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g040\", \"description\": \"楷书“緋”繁体字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g041\", \"description\": \"楷书“绯”简化字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g042\", \"description\": \"《说文》新附“繖”字字形1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g043\", \"description\": \"楷书“繖”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g044\", \"description\": \"《说文》新附“繾”字字形1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g045\", \"description\": \"汉代隶书“繾”字字形2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g046\", \"description\": \"楷书“繾”繁体字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g047\", \"description\": \"楷书“缱”简化字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1168/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [\"包山楚简引文及周礼引文处偶有扫描模糊脱落字痕（如'通“绫”。用旄牛尾或鸟羽饰干戚。《包山楚简》270'周边），据字迹和文献常规审定。\"], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n1172:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001172\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 1172, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"8710ecc0ea6409a04f9071e363076fba13bb981978660b23a238a9d37262c42d\", \"evidence_sha256\": \"b9e5d56b7dcaebbd7d39820ab15e73a79a303eba8d3830758a0751bcf7721498\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"虫 蝮 螣 蛔 蠨 蛞 蛹 蛲 雖\\n\\n[glyph:g001]¹——蠨\\n《说文》小篆 楷书\\n\\n[glyph:g002]²——[glyph:g003]\\n《说文》或体 楷书\\n\\n1、2《说文》278页。\\n\\n形声字。“蠨”从虫,鄉声;“[glyph:g003]”从虫,向声。两者是声符不同的异体字。“鄉”、“向”声音相通,而“向”字笔画简单,故以“向”代“鄉”,符合汉字简化的趋势。“蠨”的本义是土蛹。《说文》:“蠨,知声虫也。”宋孙觌《次韵王子钦》:“蠨穿万孔萃,蛛挂千丝扰。”[glyph:g003]虫,现在方言又指浮尘子等水稻害虫。(林志强)\\n\\n蛞 diāo 端组、宵部;端组、萧韵、都聊切。\\n\\n[glyph:g004]¹——蛞\\n《说文》小篆 楷书\\n\\n1《说文》278页。\\n\\n形声字。从虫,召声。楷书异体或作“蚐”,从刀声,与“蛞”为换声符的异体字。“蛞”的本义是虫。《说文》:“蛞,虫也。”《晋书·束皙传》:“羽族翔林,螈蛞赴湿。”古书中常指蝉,蝉也称蛞蝼。《太玄·饰》:“蛞鸣喁喁,血出其口。”范望注:“蛞,蝉也。”(林志强)\\n\\n蛹 yǒng 喻组、东部;以组、肿韵、余陇切。\\n\\n[glyph:g005]¹——蛹\\n《说文》小篆 楷书\\n\\n1《说文》278页。\\n\\n形声字。从虫,甬声。“蛹”的本义是蚕蛹。《说文》:“蛹,茧虫也。”《荀子·赋篇·蚕》:“蛹以为母,蛾以为父。”泛指完全变态的昆虫由幼虫到成虫的过渡形态。幼虫生长到一定时期,就不动不食,外形变厚,形体缩短,最后变成蛹。蛹在条件合适的情况下变为成虫。(林志强)\\n\\n蛔(蛔) huí 匣组、之部;匣组、灰韵、户恢切。\\n\\n[glyph:g006]²——[glyph:g007]\\n战国 楷书\\n\\n[glyph:g008]¹——[glyph:g009]³——虫有——蛔\\n春秋 《说文》小篆 楷书 楷书\\n\\n1《金文编》873页。2《汉语字形表》508页。\\n3《说文》278页。\\n\\n形声字。从虫,有声。字形1“[glyph:g008]”从虺,友声;字形2“[glyph:g006]”从虫,尤声。从虺、从虫表意相同,友、尤二者声音相同,故[glyph:g008]、[glyph:g006]二字为声符不同的异体字。《说文》小篆改从有声,亦声符不同之异体字。楷书“虫有”字从虫,回声。回、有古音相近,故蛔、虫有也是异体关系。现在以“蛔”为正字,“虫有”、“[glyph:g007]”皆作为“蛔”的异体被合并。“虫有”的本义是蛔虫。《说文》:“虫有,腹中长虫也。”《灵枢经·邪气藏腑病形篇》:“(脾脉)微滑,为虫毒蚘蝎。”(林志强)\\n\\n蛲(蛲) náo 日组、宵部;日组、宵韵、如招切。\\n\\n[glyph:g010]¹——[glyph:g011]²——蛲——蛲\\n《说文》小篆 汉 楷书 楷书\\n\\n1《说文》279页。2《马王堆》538页。\\n\\n形声字。从虫,尭声。“尭”字简化作“尧”,“蛲”也类推简化作“蛲”。本义指一种寄生虫名,身体很小,白色,像线头。《说文》:“蛲,腹中短虫也。”《淮南子·原道》:“泽及蛘蛲。”(林志强)\\n\\n雖(虽) suī 心组、微部;心组、脂韵、息遗切。\\n\\n[glyph:g012]¹——[glyph:g013]²——[glyph:g014]³——[glyph:g015]⁴——[glyph:g016]⁵——虽——雖——虽\\n春秋 战国 《说文》小篆 秦 汉 汉 楷书 楷书\\n\\n1《金文编》873页。2《古文典》1205页。3《说文》279页。4、6《甲金篆》924页。5《马王堆》538页。\\n\\n形声字。从虫,唯声。此字自古以来,“唯”的“口”旁一直都放在“虫”的头上,因此“雖”容易被误认为是“虽”和“隹”合成的左右结构。宋元以来俗字求其简省,遂以其左边“虽”代“雖”。现把“虽”作为“雖”的简化字。“虽”的本义是一种形似蜥蜴的虫,有花纹而身体较大。《说文》:“虽,似蜥蜴而大。”此字本义罕用,主要假借为连词,表示让步或假设,意思是虽然、即使。《韩非子·说林上》:“失火而取水于海,海水虽多,火必不灭矣。”《礼记·中庸》:“果能此道矣,虽愚必明,虽柔必强。”(林志强)\\n\\n1157\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"Small seal script of 蠨, with radical 虫 and phonetic 鄉\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"Small seal script variant of 蠨, with radical 虫 and phonetic 向\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"Regular script form composed of radical 虫 and 向 (蚼/虫向)\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"Small seal script of 蛞, with radical 虫 and phonetic 召\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"Small seal script of 蛹, with radical 虫 and phonetic 甬\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"Warring States character with radical 虫 and phonetic 尤\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"Regular script form composed of radical 虫 and phonetic 尤 (蚘)\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"Spring and Autumn script composed of 虺 and 友\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"Small seal script of 蛔 (虫有), with radical 虫 and 有\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"Small seal script of 蛲, with radical 虫 and phonetic 尭\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"Han clerical script from Mawangdui silk texts of 蛲\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"Spring and Autumn bronze script of 雖\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"Warring States script of 雖\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"Small seal script of 雖\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"Qin script of 雖\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"Han script of 雖 from Mawangdui\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1172/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n1173:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001173\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 1173, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"cb750a8690cb3e7a290e208c9fbe03f1493b0502f7c1afc7c8eb04aff8aa6faf\", \"evidence_sha256\": \"b3d2daee85b1dc1e567b467db0e54c0c5cd76a525141e1afa29a153f8ef94af3\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"虫部\\n\\n虺 huǐ 晓组、微部；晓组、尾韵、许伟切。\\nhuī 晓组、微部；晓组、灰韵、呼恢切。\\n[glyph:g001]¹ 商 [glyph:g002]² 西周 [glyph:g003]³ 战国 [glyph:g004]⁴ 战国 [glyph:g005]⁵ 《说文》小篆 [glyph:g006]⁶ 汉 虺 楷书\\n1《甲文编》509页。2、3《金文编》873页。4《战文编》868页。5《说文》279页。6《甲金篆》924页。\\n形声字。从虫，兀声。本作“虫”，是象形字。初文像头呈三角形的一种毒蛇(参见“虫”字条)。战国时期变为从“兀”声的形声字。“虺”的本义是毒蛇。《诗·小雅·斯干》：“维熊维罴，维虺维蛇。”又读huī，与“聩”构成复音词“虺聩”，指疲劳生病。《诗·周南·卷耳》：“陟彼崔嵬，我马虺聩。”毛传：“虺聩，病也。”（林志强）\\n\\n蜥 xī 心组、锡部；心组、锡韵、先击切。\\n[glyph:g007]¹ 《说文》小篆 蜥 楷书\\n1《说文》279页。\\n形声字。从虫，析声。本义指蜥蜴。《说文》：“蜥，蜥蜴也。”蜥蜴是一种爬行动物，身体表面有细小鳞片，有四肢，尾巴细长，易断，能再生。生活在草丛中，捕食昆虫和其他小动物。通称四脚蛇。《汉书·东方朔传》：“(朔)乃别蓍布卦而对曰：‘臣以为龙又无角，谓之为蛇又有足。跂跂脉脉善缘壁，是非守宫(又名壁虎)即蜥蜴。’”（林志强）\\n\\n蝘 yǎn 影组、元部；影组、阮韵、於憾切。\\n[glyph:g008]¹ 《说文》小篆 蝘 楷书\\n[glyph:g009]² 《说文》或体\\n1、2《说文》279页。\\n形声字。从虫，匽声。《说文》小篆异体从虫，与从虫同意。“蝘”指蝘蜓，即壁虎，又名守宫。《说文》：“蝘，在壁曰蝘蜓，在艸曰蜥蜴。”壁虎是爬行动物，身体扁平，四肢短，能在壁上活动。捕食蚊蝇等小动物。尾易断，能再生。《荀子·赋篇》：“螭龙为蝘蜓，鸱枭为凤凰。”蝘又指蝉的一种。《诗·大雅·荡》：“如蜩如蝘，如沸如羹。”毛传：“蜩，蝘也。”陆德明释文：“蝘音偃，蝉属也。”（林志强）\\n\\n蜒 tíng 定组、耕部；定组、青韵、特丁切。\\n[glyph:g010]¹ 《说文》小篆 蜒 楷书\\n1《说文》279页。\\n形声字。从虫，廷声。指蜒蜓。《说文》：“蜒，蜒蜓也……一日蝘蜓。”又指蜓蚞，一种蝉名。《尔雅·释虫》：“蜒蚞蜎蜎。”郭璞注：“即蜎蟧也。一名蟪蛄，齐人呼螟蟪。”（林志强）\\n\\n蟣(䖦) jǐ 见组、微部；见组、尾韵、居浠切。\\nqí 群组、微部；群组、微韵、渠希切。\\n[glyph:g011]¹ 《说文》小篆 蟣 楷书 䖦 楷书\\n1《说文》279页。\\n形声字。从虫，幾声。俗字以同音代替的方法把“幾”写作“几”，因此“蟣”遂类推简写作“䖦”，与古书中“密䖦”（一种虫名）之“䖦”同形。今以“䖦”为“蟣”的简化字。本义指虱子的卵。《说文》：“蟣，虱子也。”段玉裁注：“虱，啮人虫也。子，其卵也。”宋玉《小言赋》：“烹虱胫，切䖦肝。”又喻指酒面上的浮沫。“䖦”音qí，指水蛭。《说文》：“䖦……一日齐谓蛭曰䖦。”（林志强）\\n\\n蛭 zhì 章组、质部；章组、质韵、之日切。\\n[glyph:g012]¹ 《说文》小篆 [glyph:g013]² 秦 [glyph:g014]³ 汉 蛭 楷书\\n1《说文》279页。2、3《甲金篆》924页。\\n形声字。从虫，至声。古今字形变化主要表现为线条的平直化。“蛭”的本义是蚂蟥，是一种环节动物，体一般长而扁平，前后各有一个吸盘，生活在淡水或湿润的地方，能吸人畜的血。《说文》：“蛭，䖦也。”段玉裁注：“此蒙上‘䖦’字第二义释之。”按此第二义指“一日齐谓蛭曰䖦”而言。《新书·春秋》：“楚惠王食寒菹而得蛭。”（林志强）\\n\\n蠆(虿) chài 透组、月部；彻组、夬韵、丑辖切。\\n\\n1158\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"商代甲骨文虺字，象蛇形，头部尖锐呈三角形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"西周金文虺字，象蛇形，头尖身曲\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"战国金文虺字，带偏旁分化\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"战国楚简/文字虺字，从虫兀声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"《说文》小篆虺字，从虫兀声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"汉代印章/隶释字虺字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"《说文》小篆蜥字，从虫析声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"《说文》小篆蝘字，从虫匽声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"《说文》小篆或体蝘字，上虫下匽构型\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"《说文》小篆蜒字，从虫廷声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"《说文》小篆蟣字，从虫幾声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"《说文》小篆蛭字，从虫至声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"秦代印篆/简帛蛭字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"汉代印篆蛭字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1173/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n1176:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001176\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 1176, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"eabdf04a832673a6074475fc1fcfd4c0e66612749445750af3d5481fba138ef0\", \"evidence_sha256\": \"6ad9733f3b5329929765e7ae36611e83920c6af43339dc70316de00201834258\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"蠖 蜂 螻 蛄 蛾 蝗 蝥 娘 蟥 峴 贏 蚩\\n\\n蝥(蟀) shuài 心纽、物部;生纽、质韵、所律切。\\n[glyph:g001]1 《说文》小篆 — 蝥2 楷书\\n[glyph:g002]2 汉 — 蟀 楷书\\n1《说文》280页。2《甲金篆》926页。\\n形声字。从虫,帅声,为“蟀”的异体字。“蟀”从“率”声,与“帅”声同。现以“蟀”为规范正字。“蝥”与“蟋”构成复音词“蟋蟀”,虫名。《说文》:“蝥,悉蝥也。”“悉蝥”即“蟋蟀”。《诗·七月》:“十月蟋蟀入我床下。”清宋琬《蝶恋花·旅月怀人》:“蟋蟀灯前欺病客。”(参见“蟋”字条)(林志强)\\n\\n娘(螂) liáng 来纽、阳部;来纽、阳韵、吕张切。\\nláng 来纽、阳部;来纽、唐韵、鲁当切。\\n[glyph:g003]1 《说文》小篆 — 娘 楷书 — 螂 楷书\\n1《说文》280页。\\n形声字。从虫,良声,为“螂”的异体字。“螂”从“郎”声,与“良”声同。“娘”音liáng,与“蜣”构成复音词“蜣娘”,即蜣螂,一种有甲壳和鞘翅的昆虫,黑色,常把粪滚成球形,在其中产卵,俗称“屎壳郎”。唐苏鹗《苏氏演义》卷下:“蜣娘,一名蛄蜣,一名转丸,一名弄丸,能以土包屎转而成丸。”“娘”音láng,与“螳”构成复音词“螳螂”,昆虫名。《说文》:“娘,堂娘也。”“堂娘”即螳螂。《庄子·人间世》:“汝不知夫螳娘乎?怒其臂以当车辙,不知其不胜任也。”(林志强)\\n\\n蟥 huáng 匣纽、阳部;匣纽、唐韵、胡光切。\\n[glyph:g004]1 《说文》小篆 — 蟥 楷书\\n1《说文》280页。\\n形声字。从虫,黄声。古今字形没有大的变化。“蟥”指蜞蟥,甲虫名,即金龟子。《说文》:“蟥,蜞蟥也。”(林志强)\\n\\n峴(蜆) xiàn 匣纽、元部;匣纽、铣韵、胡典切。\\n[glyph:g005]1 《说文》小篆 — [glyph:g006]2 汉 — 峴 楷书 — 蜆 楷书\\n1《说文》280页。2《甲金篆》926页。\\n形声字。从虫,見声。“見”字简化作“见”,“峴”也类推简化作“蜆”。“峴”指蝶类的幼虫。常以丝悬于草木上或屋壁间,故又名缢女或缢虫。《说文》:“峴,缢女也。”《焦氏易林·随》:“峴见不祥,祸起我乡。”又音xiǎn,指一种软体动物,产于淡水中,肉可吃。唐皮日休《答箬》:“但闻蝦峴气,欲生蘋藻衣。”(林志强)\\n\\n贏 luǒ 来纽、歌部;来纽、果韵、郎果切。\\nluó 来纽、歌部;来纽、戈韵、落戈切。\\n[glyph:g007]1 《说文》小篆 — [glyph:g008]2 汉 — 贏 楷书\\n[glyph:g009]3 秦\\n1《说文》280页。2《马王堆》538页。3《甲金篆》927页。\\n形声字。从虫,嬴声。字形2、3两种写法少一“口”符,“卂”旁与“月”旁混同。字形3还多一“贝”旁,当是受“嬴”字影响所致。“贏”读luǒ,与“蜾”构成复音词“蜾贏”。蜾贏即细腰蜂。《说文》:“贏,蜾贏也。”赢读luó,同螺。《说文》:“贏,一日殷蝓。”朱骏声通训定声:“殷蝓,俗字作螺……后人别水生可食者为螺,陆生不可食者为蜗牛。”《易·说卦》:“离为赢为蚌。”(林志强)\\n\\n蚩 chī 昌纽、之部;昌纽、之韵、赤之切。\\n[glyph:g010]1 战国 — [glyph:g011]2 《说文》小篆 — [glyph:g012]3 汉 — 蚩 楷书\\n1《甲金篆》927页。2《说文》280页。3《马王堆》535页。\\n形声字。从虫,ㄓ声。战国文字本从虫,寺声。秦代文字改从虫,ㄓ声。马王堆帛书的[glyph:g012],所从之“ㄓ”少下一横画,为其省体。“蚩”的本义是虫名。《说文》:“蚩,虫也。”引申为丑陋、无知。汉赵壹《刺世疾邪赋》:“荣纳由于闪揄,孰知辨其蚩妍。”蚩蚩,敦厚的样子。《诗·卫\\n1161\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"小篆「蝥」：上「帥」下「虫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"汉隶「蟀」：左「虫」右「率」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"小篆「娘」：左「虫」右「良」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"小篆「蟥」：左「虫」右「黃」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"小篆「峴」：左「虫」右「見」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"汉隶「峴」：左「虫」右「見」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"小篆「贏」：外「𣎆」中「虫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"汉简帛字「贏」：外省「亡口」而从月贝等，中「虫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"秦简文字「贏」：从虫从嬴省\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"战国文字「蚩」：上「寺」下「虫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"小篆「蚩」：上「ㄓ」下「虫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"马王堆帛书「蚩」：上ㄓ少一横，下「虫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1176/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n1189:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001189\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 1189, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"243b842b652532de43bc0948d8499e5ad8c3d9abad50ac64c5aeac81f3bc1f42\", \"evidence_sha256\": \"e1248e1fa3ff4c696708329bfec5013dfca923e58bd6ba973cdb40a87d76566c\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"黿部 卵部 二部\\n\\n【黿】(鼋) yuán 疑纽、元部;疑纽、元韵、愚袁切。\\n[glyph:g001]¹——黿——鼋\\n《说文》小篆  楷书   楷书\\n1《说文》285页。\\n形声字。从黿,元声。“黿”简化作“鼋”,“竈”也类推简化为“鼋”。“黿”指大鳖。《说文》:“黿,大鼋也。”段玉裁注:“今日验竈与鱉同形,而但分大小之别。”《左传·宣公四年》:“楚人献竈于郑灵公。”(林志强)\\n\\n【蠅】(蝇) yíng 喻纽、蒸部;以纽、蒸韵、余陵切。\\n[glyph:g002]¹——[glyph:g003]²——[glyph:g004]³——[glyph:g005]⁴——蠅——蝇\\n战国   《说文》小篆 秦     汉      楷书   楷书\\n1上博《图版》40页。2《说文》285页。3《马王堆》543页。4《甲金篆》934页。\\n会意字。从黿,从虫。清段玉裁《说文解字注》:“虫犹蟲也。此蟲大腹,故其字从黿虫会意,谓腹大如黿之蟲也。”字形1为战国时期楚国文字,可能是从触、興省声的形声字,但此形体在后世没有得到继承。“黿”简化为“鼋”,“蠅”也类推简化为“蝇”。“蠅”为双翅目蝇科昆虫的统称,种类很多,如苍蝇、绿蝇等。能传染霍乱、伤寒等疾病。《说文》:“蠅,营营青蠅,虫之大腹者。”《诗·小雅·青蝇》:“营营青蠅,止于樊。”(林志强)\\n\\n【鼃】(蛙) wā 影纽、支部;影纽、佳韵、乌娲切。\\n[glyph:g006]¹——鼃——蛙\\n《说文》小篆  楷书   楷书\\n1《说文》285页。\\n形声字。从黿,圭声。从“黿”笔画较繁,后改从“虫”,并改上下结构为左右结构而写作“蛙”,沿用至今。本义是田鸡之类,两栖动物,捕食昆虫,对农业有益。种类很多,青蛙是常见的一种。《说文》:“鼃,虾蟆也。”段玉裁注:“竈,蝦蟆属,‘属’各本作‘也’。”《庄子·秋水》:“子独不闻乎培塿之鼃乎?”字也作“蛙”。《汉书·五行志中之下》:“元鼎五年秋,蛙与蝦蟆群斗。”通“哇”,淫邪的。三国魏曹操《与王脩书》:“孤惧有此空声冒实,淫竈乱耳。”字也作“蛙”。唐傅奕《请废佛法表》:“曲类蛙歌,听之丧本。”(林志强)\\n\\n【鼅】(蜘) zhī 端纽、支部;知纽、支韵、陟离切。\\n[glyph:g007]¹——鼅——鼅\\n《说文》小篆 楷书  楷书\\n[glyph:g008]²————————蛛\\n《说文》或体          楷书\\n1、2《说文》285页。\\n形声字。从黿,智省声。楷书作“鼅”,声符省为“知”。《说文》或体从“虫”,比从“黿”简省。现以从“虫”为正,以“知”为声符,并将上下结构改为左右结构,形成“蜘”字。“竈”与“竈”合成双音词“鼅鼄”,也作“蜘蛛”,即“蜘蛛”。节肢动物,能分泌黏液,黏液在空气中凝成细丝,用来结网捕食昆虫。生活在屋檐和草木间。《说文》:“鼅,竈竈,蝥也。”《三国志·魏书·管辂传》:“(诸葛)原自起取燕卵、蜂窠、竈竈着器中,使射覆。”(林志强)\\n\\n【鼉】(鼍) tuó 定纽、歌部;定纽、歌韵、徒河切。\\n[glyph:g009]¹——[glyph:g010]²——[glyph:g011]³——鼉——鼍\\n商    战国   《说文》小篆 楷书   楷书\\n1《甲骨文字典》1441页。2《金文编》878页。3《说文》285页。\\n形声字。从黿,單声。甲骨文声符“單”作[glyph:g012],金文以后逐渐增繁为小篆的写法。楷书声符“單”中画不透下,写成上“吅”中“田”下“一”,写法稍异。“黿”简化为“鼋”,“鼉”也类推简化为“鼍”。“鼉”指扬子鳄。也称鼍龙、猪婆龙。爬行动物,吻短,体长2米多,背部、尾部有鳞甲,力大,贪睡,穴居江河岸边。皮可以制鼓。《说文》:“鼉,水虫,似蜥易,长大。”《诗·大雅·灵台》:“鼉鼓逢逢。”(林志强)\\n\\n【鼄】(蛛) zhū 端纽、侯部;知纽、虞韵、陟输切。\\n[glyph:g013]¹——[glyph:g014]²——[glyph:g015]³——鼄\\n西周   战国  《说文》小篆 楷书\\n[glyph:g016]⁴————蛛\\n《说文》或体     楷书\\n1《金文编》879页。2《金文编》878页。3、4《说文》285页。\\n\\n1174\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"《说文》小篆“黿”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"战国文字“蠅”字形1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"《说文》小篆“蠅”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"秦代文字“蠅”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"汉代文字“蠅”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"《说文》小篆“鼃”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"《说文》小篆“鼅”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"《说文》或体“鼅”字（从虫知声）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"商代甲骨文“鼉”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"战国文字“鼉”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"《说文》小篆“鼉”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"甲骨文声符“單”之形体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"西周金文“鼄”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"战国金文“鼄”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"《说文》小篆“鼄”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"《说文》或体“鼄”字（从虫朱声）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1189/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n1238:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:001238\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 1238, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"6de737818de7bf22dfbba4cf5f02e6ec440c34462a73b194fc62e75d1f7c397e\", \"evidence_sha256\": \"ea4a86c1b9e833c41b03582baa2dc04b0c71f7f10c5fcb561dd0665702cc4fd2\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"鎬 銝 鑪 錐 鐗 鍵 鉉 瑩 鐵 錠 鐙 鑪 釦\\n\\n解字约注》：“铉字,从金,自当以鼎耳为本义。鼎耳之用,在于贯木其中以举鼎。”按鼎耳谓之铉,贯鼎耳而举之具谓铉。(周宝宏)\\n\\n[glyph:g001]（蓥）yīng 喻纽、耕部;以纽、清韵、余倾切。\\nyíng 影纽、耕部;影纽、径韵、乌定切。\\n\\n[glyph:g002]¹——[glyph:g003]²——[glyph:g004]——蓥\\n西周 《说文》小篆 楷书 楷书\\n1《金文编》913页。2《说文》295页。\\n形声字。《说文》：“瑩,器也。从金,熒省声。”段玉裁注：“谓摩锃之器也,以金为之。”张舜徽约注：“瑩之言瑩也,谓磨之瑩然有光也。《广雅·释诂三》：‘瑩,磨也。’”(周宝宏)\\n\\n鐵 jiān 精纽、谈部; 精纽、盐韵、子廉切。\\n\\n[glyph:g005]¹——鐵\\n《说文》小篆 楷书\\n＼\\n 尖\\n 楷书\\n1《说文》295页。\\n形声字。《说文》：“鐵,铁器也。一日鐫。从金,鐵声。”段玉裁注：“盖锐利之器,郭注《尔雅》:用为今之尖字。”《玉篇》：“尖,小细也。”又：“尖,锐也。”尖字大约产生于魏晋时代。张舜徽《说文解字约注》：“锐利之器谓之鐵,犹木之锐者谓之檄,竹之锐者谓之箴耳。”(周宝宏)\\n\\n錠（锭）dìng 端纽、耕部;端纽、径韵、丁定切。\\n\\n[glyph:g006]¹——[glyph:g007]²——[glyph:g008]³——錠——锭\\n《说文》小篆 汉 汉 楷书 楷书\\n1《说文》295页。2、3《篆隶表》1002页。\\n形声字。《说文》：“錠,鐙也。从金,定声。”徐灏段注笺：“《楚辞·招魂》云:兰膏明烛华镫错些。王注:言镫锭尽雕琢错缕。《急就篇》:锻铸铅锡鐙锭鏢。颜注:鐙所以盛膏夜然燎者也,其形若杆而中施釭,有柎者曰鐙,无柎者曰錠。谓下施足也。”(周宝宏)\\n\\n鐙（镫）dēng 端纽、蒸部;端纽、嶝韵、都邓切。\\n\\n[glyph:g009]¹——[glyph:g010]²——[glyph:g011]³——[glyph:g012]⁴——鐙——镫\\n《说文》小篆 汉 汉 汉 楷书 楷书\\n1《说文》295页。2、3、4《篆隶表》1002页。\\n形声字。《说文》：“鐙,錠也。从金,登声。”徐铉：“锭中置烛故谓之鐙,今俗别作燈,非是。”张舜徽约注：“是鐙即今俗所用燈盏也。”(周宝宏)\\n\\n鑪（炉）lú 来纽、鱼部;来纽、模韵、落胡切。\\n\\n[glyph:g013]¹——[glyph:g014]²——[glyph:g015]³——[glyph:g016]⁴——[glyph:g017]⁵——爐——炉\\n春秋 春秋 春秋 《说文》小篆 汉 楷书 楷书\\n1、2、3《金文编》913~914页。4《说文》295页。5《篆隶表》1002页。\\n形声字。从金,卢声。清王筠《说文解字句读》：“玄应曰:凡盛火之器曰鑪。”徐铉：“今俗别作爐,非是。”按:春秋金文习见鑪字,多用为金属名称,未见用为火炉之鑪者,据此可知,鑪之本义非火鑪,而是金属原料之称。(周宝宏)\\n\\n釦（钮）kòu 溪纽、侯部;溪纽、厚韵、苦后切。\\n\\n[glyph:g018]¹——[glyph:g019]²——[glyph:g020]³——釦——钮\\n《说文》小篆 汉 汉 楷书 楷书\\n1《说文》295页。2、3《马王堆》564页。\\n形声字。《说文》：“釦,金饰器口。从金、从口,口亦声。”段玉裁注：“谓以金涂器口,许所谓错金,今俗所谓镀金也。《汉旧仪》:大官尚食用黄金釦器,中官私官尚食用白银釦器。”《后汉书·皇后纪上·和熹邓皇后》：“其蜀汉釦器九带佩刀,并不复调。”李贤注：“釦,以金银缘器也。”釦字未见于先秦古文字资料,见于先秦文献《国语》,是借用为“叩”,当是秦汉以后传抄时所写。釦字见于马王堆汉墓帛书的《五十二病方》和《养生方》,但不用为本义,而是借用为别的词义。张舜徽《说文解字约注》认为《说文》原本“釦”字不是会意字,而是从金、口声的形声字。(周宝宏)\\n\\n1223\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1238/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1238/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1238/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"Printed headword for 蓥, upper part two 炏 above 冖, lower part 金\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1238/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"Western Zhou bronze form for 蓥\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-1238/source.png\", \"source_bbox_xyxy\": null}, {\"id\"