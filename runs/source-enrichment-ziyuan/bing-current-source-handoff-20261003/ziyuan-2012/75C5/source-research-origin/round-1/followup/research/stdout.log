 \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"战国文字臧字异体，从臣从爿\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"战国文字臧字异体，从臣从爿带饰笔\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"战国文字臧字异体，从臣从口从戈\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"战国文字臧字，从臣从戕\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"战国文字臧字，从臣戕声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"战国文字臧字，从臣从戈从口\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"战国文字臧字，从臣从戈等\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0248/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"《说文》小篆臧字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-fu