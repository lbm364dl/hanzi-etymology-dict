{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"{\"edits\":[{\"path\":\"meaning_history\",\"value_json\":\"{\\\"senses\\\":[{\\\"id\\\":\\\"杯:vessel\\\",\\\"gloss\\\":\\\"cup or drinking vessel\\\",\\\"period\\\":\\\"attested in the received Mencius passage; manuscript date unresolved\\\",\\\"certainty\\\":\\\"established\\\",\\\"status\\\":\\\"historical\\\",\\\"text\\\":\\\"In the received Mencius passage, 一杯水 means “a cup of water,” an early textual use of 杯 for a vessel. The citation does not date the surviving physical witness or establish the word’s earliest occurrence.\\\",\\\"evidence_ids\\\":[\\\"ref011\\\"]},{\\\"id\\\":\\\"杯:classifier\\\",\\\"gloss\\\":\\\"classifier for cupfuls\\\",\\\"period\\\":\\\"historical; chronology unresolved\\\",\\\"certainty\\\":\\\"established\\\",\\\"status\\\":\\\"historical\\\",\\\"text\\\":\\\"杯 is used as a classifier for cupfuls in examples cited from Mencius and later works. These attestations do not establish when this use developed relative to the vessel sense or establish present-day Chinese use.\\\",\\\"evidence_ids\\\":[\\\"ref008\\\",\\\"ref011\\\"]},{\\\"id\\\":\\\"杯:trophy\\\",\\\"gloss\\\":\\\"award or trophy, especially in the form 盃\\\",\\\"period\\\":\\\"current; chronology of development unresolved\\\",\\\"certainty\\\":\\\"established\\\",\\\"status\\\":\\\"current\\\",\\\"text\\\":\\\"杯 is currently used for a cup-shaped competition prize, including in 獎杯; one dictionary notes that 盃 is more common in this context. The chronology of this use is unresolved.\\\",\\\"evidence_ids\\\":[\\\"ref008\\\",\\\"ref012\\\",\\\"ref040\\\",\\\"ref041\\\",\\\"ref043\\\",\\\"ref045\\\",\\\"ref046\\\"]}],\\\"developments\\\":[],\\\"limitations\\\":[{\\\"text\\\":\\\"The Mencius citation supports the vessel sense but does not date the surviving manuscript or establish the earliest physical witness. The evidence does not show when classifier or trophy uses arose relative to the vessel sense.\\\",\\\"evidence_ids\\\":[\\\"ref011\\\",\\\"ref012\\\",\\\"ref008\\\"]}]}\"},{\"path\":\"relationships\",\"value_json\":\"[{\\\"id\\\":\\\"杯:木:semantic\\\",\\\"subject\\\":{\\\"kind\\\":\\\"component\\\",\\\"id\\\":\\\"木\\\"},\\\"object\\\":{\\\"kind\\\":\\\"character\\\",\\\"id\\\":\\\"杯\\\"},\\\"predicate\\\":\\\"semantic_component_of\\\",\\\"context_character\\\":\\\"杯\\\",\\\"certainty\\\":\\\"probable\\\",\\\"text\\\":\\\"In the proposed 木 + 不 analysis of 杯, 木 is identified as the meaning component; the Warring States account describes it as the meaning side, without specifying its contribution to the vessel.\\\",\\\"evidence_ids\\\":[\\\"ref002\\\",\\\"ref014\\\",\\\"ref030\\\",\\\"ref034\\\"]},{\\\"id\\\":\\\"杯:不:phonetic\\\",\\\"subject\\\":{\\\"kind\\\":\\\"component\\\",\\\"id\\\":\\\"不\\\"},\\\"object\\\":{\\\"kind\\\":\\\"character\\\",\\\"id\\\":\\\"杯\\\"},\\\"predicate\\\":\\\"phonetic_component_of\\\",\\\"context_character\\\":\\\"杯\\\",\\\"certainty\\\":\\\"disputed\\\",\\\"text\\\":\\\"The Warring States analysis identifies 不 as the sound element in those forms. A distinct scholarly proposal interprets 不 as a remnant of a felled tree in a hollowed-tree vessel; the competing accounts do not settle the earliest form or 不’s role there.\\\",\\\"evidence_ids\\\":[\\\"ref013\\\",\\\"ref014\\\",\\\"ref017\\\",\\\"ref020\\\",\\\"ref030\\\",\\\"ref035\\\",\\\"ref037\\\",\\\"ref047\\\"]},{\\\"id\\\":\\\"杯:桮\\\",\\\"subject\\\":{\\\"kind\\\":\\\"character\\\",\\\"id\\\":\\\"桮\\\"},\\\"object\\\":{\\\"kind\\\":\\\"character\\\",\\\"id\\\":\\\"杯\\\"},\\\"predicate\\\":\\\"variant_of\\\",\\\"context_character\\\":\\\"杯\\\",\\\"certainty\\\":\\\"probable\\\",\\\"text\\\":\\\"The received Shuowen account concerns 桮, while 杯 later became standard; their exact graphic sequence is unresolved.\\\",\\\"evidence_ids\\\":[\\\"ref010\\\",\\\"ref019\\\"]},{\\\"id\\\":\\\"桮:否:phonetic\\\",\\\"subject\\\":{\\\"kind\\\":\\\"component\\\",\\\"id\\\":\\\"否\\\"},\\\"object\\\":{\\\"kind\\\":\\\"character\\\",\\\"id\\\":\\\"桮\\\"},\\\"predicate\\\":\\\"phonetic_component_of\\\",\\\"context_character\\\":\\\"杯\\\",\\\"certainty\\\":\\\"probable\\\",\\\"text\\\":\\\"The received account identifies 否 as the sound component in 桮, without establishing it as a component of modern 杯.\\\",\\\"evidence_ids\\\":[\\\"ref010\\\",\\\"ref019\\\",\\\"ref025\\\"]}]\"}]}"}}
