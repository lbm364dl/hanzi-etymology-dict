id\": \"g028\", \"description\": \"战国文字“下”字形体2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g029\", \"description\": \"战国文字“下”字形体3\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g030\", \"description\": \"《说文》古文“下”字形体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g031\", \"description\": \"《说文》小篆“下”字形体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g032\", \"description\": \"汉代“下”字形体1\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g033\", \"description\": \"汉代“下”字形体2\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g034\", \"description\": \"行文中引商代甲骨文“下”二横形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g035\", \"description\": \"行文中引商代甲骨文“下”弧线下横形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0015/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g036\", \"description\": \"行文中引金文“下”二横形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catal