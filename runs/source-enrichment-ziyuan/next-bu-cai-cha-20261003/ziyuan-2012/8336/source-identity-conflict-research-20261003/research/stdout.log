\": \"g009\", \"description\": \"小篆“禦”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"汉代隶书“禦”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"文中引述甲骨文字形“卸/禦”其一\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"文中引述甲骨文字形“卸/禦”其二\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"文中引述甲骨文字形“卩”像人跪拜之形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"文中引述甲骨文“午”字形其一\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"文中引述甲骨文“午”字形其二\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"文中引述西周“午”字形变\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g017\", \"description\": \"文中引述西周“禦”字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g018\", \"description\": \"秦代文字“禦”所从御旁中的辵/彳形小篆或古文字偏旁\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g019\", \"description\": \"汉代文字中讹变出的偏旁形体\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g020\", \"description\": \"小篆“栝/祑”字，左示右昏\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g021\", \"description\": \"楷书异体字，左示右昏（祑）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g022\", \"description\": \"小篆“禖”字，左示右某\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g023\", \"description\": \"小篆“挀/𥛱”字，左示右辰\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g024\", \"description\": \"楷书异体字，左示右辰（𥛱）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0023/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n26:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000026\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 26, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"4f4ce8c96008ba812b1269badd51a926949a57664dc4d8d5df40426387404e1e\", \"evidence_sha256\": \"1a2f45bede16c055572c7fb039db0bd21059c372ffda13be5886f6e5d57d97a4\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"王部 玉部\\n\\n王部\\n\\n王 wáng 匣组、阳部；云组、阳韵、雨方切。\\nwàng 匣组、阳部；云组、漾韵、于放切。\\n\\n[glyph:g001] 商 1 - [glyph:g002] 商 2 - [glyph:g003] 商 3 - [glyph:g004] 西周 4 - [glyph:g005] 春秋 5 - [glyph:g006] 战国 7 / [glyph:g007] 战国 6 - [glyph:g008] 《说文》小篆 8 - [glyph:g009] 汉 9 - 王 楷书\\n\\n1、2、3《甲文编》15页。4、5、7《金文编》18、20页。6《战文编》14页。8《说文》9页。9《篆隶表》15页。\\n\\n象形字。甲骨文作“[glyph:g010]”，像斧钺之形（由“[glyph:g011]”演变）。以斧钺象征王权。本义是指古代最高统治者。《说文》：“王，天下所归往也。”《尔雅·释诂上》：“王，君也。”《礼记·内则》：“后王命冢宰，降德于众兆民。”陆德明释文：“王，天子也。”这种意思的“王”今天读wáng。“王”字引申之又有统治之意。《诗·大雅·皇矣》：“王此大邦，克顺克比。”《史记·项羽本纪》：“先破秦入咸阳者王之。”即其例。这种意义的“王”今天读wàng。甲骨文早期“王”字作“[glyph:g012]”，后在其上缀加一横，作“[glyph:g013]”，至晚期则将“[glyph:g014]”所从之“[glyph:g015]”省减为一“[glyph:g016]”，“王”字构形便与我们今天楷书中的“王”字一样了。春秋战国时期，南方楚国及吴越地区的“王”字上或缀加鸟形，这种书体过去称为“鸟虫书”，所加鸟形乃装饰性符号，纯粹为了美观，并无实在意义。秦代小篆中“王”字和“玉”字的形体十分接近（“玉”字作“王”），但仍有区分，“王”字中间一横略微靠上，“玉”字则中间一横处于正中位置，参“玉”字条。（白于蓝）\\n\\n閏（闰） rùn 日组、真部；日组、稕韵、如顺切。\\n\\n[glyph:g017] 战国 1 - [glyph:g018] 《说文》小篆 2 - [glyph:g019] 汉 3 - 閏 楷书 - 闰 楷书\\n\\n1《楚系简帛》41页。2《说文》9页。3《篆隶表》15页。\\n\\n会意字。从王在门中以表示“闰月”之“闰”。《说文》：“闰，余分之月，五岁再闰。告朔之礼，天子居宗庙，闰月居门中。从王在门中。《周礼》曰：‘闰月，王居门中，终月也。’”本义是历法术语。农历一年与地球公转一周相比，约差十日有奇，所余的时间约三年积成一月，加在一年里，这样的办法叫做“闰”。《书·尧典》：“以闰月定四时成岁。”孔传：“一岁有余十二日，未盈三岁足得一月，则置闰焉。”《广韵·稕韵》：“闰，余也。《易》曰：‘五岁再闰。’《史记》曰：‘黄帝起消息，正闰余。’《汉书音义》曰：‘以岁之余为闰。’”（白于蓝）\\n\\n皇 huáng 匣组、阳部；匣组、唐韵、胡光切。\\n\\n[glyph:g020] 商 1 - [glyph:g021] 商 2 - [glyph:g022] 西周 3 - [glyph:g023] 春秋 4 - [glyph:g024] 战国 5 / [glyph:g025] 战国 6 - [glyph:g026] 《说文》小篆 7 - [glyph:g027] 汉 8 - 皇 楷书\\n\\n1、2《甲文编》906页。3、4、5《金文编》21~23页。6《战文编》15页。7《说文》10页。8《篆隶表》15页。\\n\\n象形字。始见于甲骨文，本像火炬光焰上腾之形，即“煌”字初文。“皇”字古有大义。《说文》：“皇，大也。”中山王鼎壶：“邵公皇工（功）。”“皇功”即“大功”。又可指天。《广韵·唐韵》：“皇，天也。”又可指君主。《尔雅·释诂上》：“皇，君也。”甲骨文“皇”字作“[glyph:g028]”，又作“[glyph:g029]”，附加音符“王”。西周金文作“[glyph:g030]”，将“王”字的一竖笔与“[glyph:g031]”下部的一竖笔连为一体，这种现象在古文字中称“借笔”或“兼笔”。春秋文字作“[glyph:g032]”，将“王”字从原形体中独立出来。战国文字承袭西周、春秋文字，但上部讹变为“[glyph:g033]”形者。秦代小篆上部又讹变为“[glyph:g034]（自）”，即《说文》所谓：“皇，大也。从自。自，始也。始皇者，三皇，大君也。自，读若鼻，今俗以始生子为鼻子。”汉代文字则将上部又讹变为“白”，一直沿袭至今。（白于蓝）\\n\\n玉部\\n\\n玉 yù 疑组、屋部；疑组、烛韵、鱼欲切。\\n\\n[glyph:g035] 商 1 - [glyph:g036] 商 2 - [glyph:g037] 西周 3 - [glyph:g038] 春秋 4 - [glyph:g039] 战国 5 / [glyph:g040] 战国 6 / [glyph:g041] 战国 7 / [glyph:g042] 战国 8 - [glyph:g043] 《说文》小篆 9 - [glyph:g044] 汉 10 / [glyph:g045] 汉 11 / [glyph:g046] 汉 12 - 玉 楷书\\n\\n14\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"甲骨文“王”字早期形体，斧钺之形，两横一竖底端为扁弧形刃\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"甲骨文“王”字，顶上加一短横，底端实心刃部\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"甲骨文“王”字晚期形体，三横一竖，底横略粗\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"西周金文“王”字，三横一竖，底横为肥笔\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"春秋金文“王”字，三横一竖，顶端加饰鸟形（鸟虫书）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"战国文字“王”字，上部带曲折装饰的鸟虫书形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"战国文字“王”字，三横一竖，两头出头或有饰笔\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"小篆“王”字，中间一横略靠上\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"汉代隶书“王”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"甲骨文“王”字形体，斧钺之形，一竖底端有弧刃\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"古文字“戉”或斧钺形，带柄与弧刃\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"甲骨文早期“王”字，一竖底横有肥刃\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"甲骨文“王”字，上方加一横\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"甲骨文“王”字早期带肥厚刃部之形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g015\", \"description\": \"斧钺刃部象形部件，横向弧形实心笔画\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g016\", \"description\": \"楷书或文字中的一横笔画\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g017\", \"description\": \"战国文字“閏”字，门内从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g018\", \"description\": \"小篆“閏”字，门内从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g019\", \"description\": \"汉隶“閏”字，门内从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g020\", \"description\": \"甲骨文“皇”字，像火炬光焰上腾之形，下有一竖柄\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g021\", \"description\": \"甲骨文“皇”字，火炬形下加音符“王”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g022\", \"description\": \"西周金文“皇”字，火炬光焰与下部“王”字共用一竖（借笔）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g023\", \"description\": \"春秋金文“皇”字，上部火炬与下部“王”字分开独立\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g024\", \"description\": \"战国文字“皇”字（一），上部光焰化作山字形/屮形，下从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g025\", \"description\": \"战国文字“皇”字（二），上从光焰，中从环形装饰，下从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g026\", \"description\": \"小篆“皇”字，上从自，下从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g027\", \"description\": \"汉隶“皇”字，上从白，下从王\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g028\", \"description\": \"甲骨文“皇”字初文，火炬光焰形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g029\", \"description\": \"甲骨文“皇”字，上火炬下加音符“王”\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g030\", \"description\": \"西周金文“皇”字借笔形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g031\", \"description\": \"火炬光焰形部件（皇之上部）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g032\", \"description\": \"春秋文字“皇”字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g033\", \"description\": \"战国文字“皇”字上部讹变之形，类似“屮”或“山”形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g034\", \"description\": \"小篆“皇”字上部“自”形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g035\", \"description\": \"甲骨文“玉”字（一），一竖串数块玉璧或玉片，两端出头有系绳纹\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g036\", \"description\": \"甲骨文“玉”字（二），一竖串三横，带系绳斜笔\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g037\", \"description\": \"西周金文“玉”字，三横一竖，等距\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g038\", \"description\": \"春秋金文“玉”字，三横一竖，横画两头微弯\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g039\", \"description\": \"战国文字“玉”字（一），带有饰笔或圆点\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g040\", \"description\": \"战国文字“玉”字（二），三横一竖\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g041\", \"description\": \"战国文字“玉”字（三），有特殊连笔饰笔\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g042\", \"description\": \"战国文字“玉”字（四），多横繁复之形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g043\", \"description\": \"小篆“玉”字，三横等距一竖贯穿\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g044\", \"description\": \"汉代文字“玉”字（一），三横一竖无点\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g045\", \"description\": \"汉代文字“玉”字（二），右下加一点\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g046\", \"description\": \"汉代文字“玉”字（三），中横与底横间加一点或短横\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0026/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n31:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000031\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 31, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"e737bb45928d0f53c6925d878cfd911299ff53d7cce29283a0d8f9b2e1b8b3b4\", \"evidence_sha256\": \"41f41f98dd011b0df809f5255204f2a392aa9124f363c652722024b6f91970aa\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"玠 暘 瑑 珽 瑁 珩 玦 瑞 珥 瑱 琫 璪 瑳 玼\\n\\n瑞\\nruì 禅纽、歌部；禅纽、寘韵、是伪切。\\n[glyph:g001]¹—[glyph:g002]²—[glyph:g003]³—瑞\\n战国 《说文》小篆 汉 楷书\\n1《楚系简帛》44页。2《说文》11页。3《篆隶表》19页。\\n形声字。从玉，耑声。本义是指古代玉制的信物，相当于后世的印信。《说文》：“瑞，以玉为信也。”王筠句读：“犹今言印信，故璧、琮、琥及《土部》‘圭’下皆云‘瑞玉’。”《玉篇·玉部》：“瑞，信节也，诸侯之珪也。”“瑞”字古又有吉祥之义。《古今韵会举要·寘韵》：“瑞，祥瑞也。”《史记·礼书》：“古者太平，万民和喜，瑞应辨至。”(白于蓝)\\n\\n珥\\něr 日纽、之部；日纽、志韵、仍吏切。\\n[glyph:g004]¹—[glyph:g005]²—[glyph:g006]³—珥\\n战国 《说文》小篆 汉 楷书\\n1《楚系简帛》44页。2《说文》11页。3《篆隶表》19页。\\n形声字。从玉，耳声。本义是指古代的珠玉耳饰，也叫“瑱”。《说文》：“珥，瑱也。”《玉篇·玉部》：“珥，珠在耳。”又指剑鼻，即剑柄上端似两耳的突出部分。《广雅·释器》：“剑珥谓之镡。”王念孙疏证：“《说文》：‘镡，剑鼻也。’……剑鼻谓之镡，镡谓之珥。”引申之还可指日、月两旁的光晕。《释名·释天》：“珥，气在日两旁之名也。珥，耳也，言似人耳之在两旁也。”《隋书·天文志下》：“月晕有两珥，白虹贯之。”(白于蓝)\\n\\n瑱\\ntiàn 透纽、真部；透纽、霰韵、他甸切。\\n[glyph:g007]¹—[glyph:g009]³—瑱\\n《说文》小篆 汉 楷书\\n[glyph:g008]²\\n《说文》或体\\n1、2《说文》11页。3《篆隶表》20页。\\n形声字。从玉，真声。本义是古代冠冕上的玉质饰件，系于冠冕，自两侧垂于耳旁，用来塞耳，故又名“充耳”。《说文》：“瑱，以玉充耳也。”《释名·释首饰》：“瑱，镇也。悬当耳傍，不欲使人妄听，自慎重也。”又可当玉名讲。《广韵·霰韵》：“瑱，玉名。”(白于蓝)\\n\\n琫\\nběng 帮纽、东部；帮纽、董韵、边孔切。\\n[glyph:g010]¹—[glyph:g011]²—琫\\n《说文》小篆 汉 楷书\\n1《说文》11页。2《篆隶表》20页。\\n形声字。从玉，奉声。本义是一种古代佩刀鞘口上的装饰。《说文》：“琫，佩刀上饰。天子以玉，诸侯以金。”《释名·释兵》：“(刀)其室曰削……室口之饰曰琫。”(白于蓝)\\n\\n璪\\nzǎo 精纽、宵部；精纽、晧韵、子晧切。\\n[glyph:g012]¹—璪\\n《说文》小篆 楷书\\n1《说文》11页。\\n形声字。从玉，喿声。本义是指雕有水藻花纹的玉饰。《说文》：“璪，玉饰如水藻之文。”又可指玉名。《广韵·晧韵》：“璪，玉名。”又可指用五彩丝绳制作的冕饰。《礼记·郊特性》：“(王)戴冕璪十有二旒。”孙希旦集解：“璪者，用五采丝为绳，垂之以为冕之旒也。”(白于蓝)\\n\\n瑳\\ncuō 清纽、歌部；清纽、歌韵、七何切。\\n[glyph:g013]¹—瑳\\n《说文》小篆 楷书\\n1《说文》11页。\\n形声字。从玉，差声。本义是指玉色鲜白。《说文》：“瑳，玉色鲜白。”引申之也可用以形容物色洁白。《正字通·玉部》：“瑳，凡物色鲜盛亦曰瑳。”又可形容人之巧笑貌。《诗·卫风·竹竿》：“巧笑之瑳，佩玉之傩。”毛传：“瑳，巧笑貌。”(白于蓝)\\n\\n玼\\ncǐ 清纽、支部；清纽、纸韵、雌氏切。\\ncī 从纽、支韵、疾移切。\\n[glyph:g014]¹—玼\\n《说文》小篆 楷书\\n1《说文》11页。\\n形声字。从玉，此声。本义是指玉色鲜明貌，读cǐ。《说文》：“玼，玉色鲜也。”又可指玉石上的斑点。《广韵·支韵》：“玼，玉病。”《正字通·玉部》：“玼，玉病，与疵通。”汉桓宽《盐铁论·晁错》：“夫以玙璠之玼而弃其\\n19\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"战国楚简帛文字「瑞」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"《说文》小篆「瑞」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"汉代隶书「瑞」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"战国楚简帛文字「珥」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"《说文》小篆「珥」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"汉代隶书「珥」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"《说文》小篆「瑱」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"《说文》或体「瑱」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"汉代隶书「瑱」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"《说文》小篆「琫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"汉代隶书「琫」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"《说文》小篆「璪」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"《说文》小篆「瑳」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"《说文》小篆「玼」\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0031/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n33:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000033\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 33, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"610231b6385dd102cc59d7146c1c3776d56db11b50e4a4f34c1c097087585c55\", \"evidence_sha256\": \"972ee7c9bf0f948efe20041fc21451b602f8c436a4479f76737db4bd4c2082e8\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"瑩 璘 瑕 琢 瑚 理 珍 玩 玲 滄 琤 瑣 珥 琚\\n\\n传·文公八年》：“书曰‘公子遂’，珍之也。”杜预注：“珍，贵也。”（白于蓝）\\n\\n玩 wán 疑组、元部；疑组、换韵、五换切。\\n[glyph:g001]¹ 战国 — [glyph:g002]² 《说文》小篆 — [glyph:g003]⁴ 汉 — 玩 楷书\\n[glyph:g004]³ 《说文》或体\\n1《楚系简帛》44页。2、3《说文》12页。4《篆隶表》21页。\\n形声字。从玉，元声。本义是指玩弄、戏弄。《说文》：“玩，弄也。”引申之又可指供赏玩之物。如古玩、珍玩。《国语·楚语下》：“若夫白珩，先王之玩也。”韦昭注：“玩，玩弄之物。”秦代文字中“玩”字又可作“貥”，从“貝(贝)”表义。（白于蓝）\\n\\n玲 líng 来组、耕部；来组、青韵、郎丁切。\\n[glyph:g005]¹ 《说文》小篆 — 玲 楷书\\n1《说文》12页。\\n形声字。从玉，令声。本义是象声词，表示金玉之声。《说文》：“玲，玉声。”桂馥义证：“玉声者。《埤苍》：‘玲珑，玉声也。’”《广雅·释诂四》：“玲珑，声也。”（白于蓝）\\n\\n滄 (沧)\\nqiāng 清组、阳部；清组、阳韵、七羊切。\\n[glyph:g006]¹ 《说文》小篆 — 滄 楷书 — 沧 楷书\\n1《说文》12页。\\n形声字。从玉，倉声。本义是指玉件相击之声。《说文》：“滄，玉声也。”《初学记》卷二十七引《逸论语》：“玲、玠、琤、瑣、瑾(徨)，玉声也。”引申之又可指乐声。《集韵·阳韵》：“沧，乐声。”《荀子·富国》：“撞钟击鼓而和，《诗》曰：‘钟鼓喤喤，管磬沧沧。’”杨倞注：“《诗·周颂·执竞》之篇，毛云：‘喤喤、沧沧，皆声和貌。’”（白于蓝）\\n\\n琤 chēng 初组、耕部；初组、耕韵、楚耕切。\\n\\n琤¹ 《说文》小篆 — 琤 楷书\\n[glyph:g007]¹\\n1《说文》12页。\\n形声字。从玉，争声。本义是指玉件相击之声。《说文》：“琤，玉声也。”引申之亦可泛指其他物件相击之声。《正字通·玉部》：“琤，凡物戛击有声皆曰琤。”（白于蓝）\\n\\n瑣 (琐) suǒ 心组、歌部；心组、果韵、苏果切。\\n[glyph:g008]¹ 《说文》小篆 — [glyph:g009]² 汉 — 瑣 楷书 — 琐 楷书\\n1《说文》12页。2《篆隶表》21页。\\n形声字。从玉，肖声。本义是指玉件相击所发出的细碎声音。也作“琐琐”。《说文》：“瑣，玉声也。”唐杜牧《送刘三复郎中赴阙》：“玉珂声琐琐，锦帐梦悠悠。”又指连环、锁链，后世作“锁”。《广雅·释诂四》：“琐，连也。”清徐灏《说文解字注笺·玉部》：“盖以玉为小连环……系人琅当，以铁为连环，其形相似，故亦谓之琐。其后因易金旁作锁。”《资治通鉴·后晋高祖天福元年》：“遂琐德钧、延寿，送归其国。”胡三省注：“琐与锁同。”（白于蓝）\\n\\n珥 bàng 並组、东部；並组、讲韵、步项切。\\n[glyph:g010]¹ 《说文》小篆 — 珥 楷书\\n1《说文》12页。\\n形声字。从玉，丰声。本义是指次于玉的石。古时制成小璧，系于带间，用以悬挂佩物。《说文》：“珥，石之次玉者，以为系璧。”段玉裁注：“系璧，盖为小璧系带间，悬左右佩物也。”亦可指玉色之珠。《龙龛手鉴·玉部》：“珥，珠而玉色也。”（白于蓝）\\n\\n琚 jū 见组、鱼部；见组、鱼韵、九鱼切。\\n[glyph:g011]¹ 《说文》小篆 — [glyph:g012]² 汉 — 琚 楷书\\n1《说文》12页。2《篆隶表》21页。\\n形声字。从玉，居声。本义是一种玉名。《说文》：“琚，琼琚。”《广韵·鱼韵》：“琚，玉名。”又可专指佩玉。《诗·卫风·木瓜》：“投我以木瓜，报之以琼琚。”毛传：“琚，佩玉名。”（白于蓝）\\n\\n21\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"战国文字“玩”字形，左玉右元\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"《说文》小篆“玩”字形，左玉右元\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"汉代隶书/篆隶“玩”字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"《说文》或体“玩”字形，左贝右元\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"《说文》小篆“玲”字形，左玉右令\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"《说文》小篆“滄”字形，左玉右倉\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"《说文》小篆“琤”字形，左玉右爭\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"《说文》小篆“瑣”字形，左玉右肖\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"汉代隶书“瑣”字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"《说文》小篆“珥”字形，左玉右丰\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"《说文》小篆“琚”字形，左玉右居\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"汉代隶书“琚”字形\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0033/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n34:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000034\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 34, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"3c099ac4a60f202329ac047fef1d3595b33935e6fab19572a6a3259469b55261\", \"evidence_sha256\": \"babe9069741c8978e608baa66c68ae86fde011d55a1756a84bb468d331742d1e\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"玉部\\n\\n玖 jiǔ 见组、之部;见组、有韵、举有切。\\n[glyph:g001]¹—玖\\n《说文》小篆 楷书\\n1《说文》12页。\\n形声字。从玉,久声。本义是指比玉稍次的黑色美玉。《说文》:“玖,石之次玉黑色者。”《诗·王风·丘中有麻》:“彼留之子,贻我佩玖。”毛传:“玖,石次玉者。”又用为数词,“九”字的大写,唐武则天时所改。《六书故·数》:“今惟财用出内之簿书,用壹贰叁肆伍陆柒捌玖拾阡陌,以防奸易。”清顾炎武《金石文字记》卷三:“凡数字作壹、贰、叁、肆、捌、玖等字,皆武后所改。”(白于蓝)\\n\\n碧 bì 帮组、铎部;帮组、昔韵、彼役切。\\n[glyph:g002]¹—[glyph:g003]²—碧\\n《说文》小篆 汉 楷书\\n1《说文》13页。2《篆隶表》22页。\\n形声字。从玉、从石,白声。本义是指青绿色之美石。《说文》:“碧,石之青美者。”段玉裁注:“从玉、石者,似玉之石也。”引申之亦可指青绿色。如碧空、碧竹、碧瓦。《广雅·释器》:“碧,青也。”《篇海类编·珍宝类·玉部》:“碧,深青色。”(白于蓝)\\n\\n琨 kūn 见组、文部;见组、魂韵、古浑切。\\n[glyph:g004]¹ ─── [glyph:g005]³ ─── 琨\\n《说文》小篆 汉 楷书\\n[glyph:g006]² ─── [glyph:g007]⁴ ─── 瑻\\n《说文》或体 汉 楷书\\n1、2《说文》13页。3、4《篆隶表》22页。\\n形声字。从玉,昆声。本义是指美石或美玉。《说文》:“琨,石之美者。”《书·禹贡》:“瑶、琨、篠簜。”孔传:“瑶、琨,皆美玉。”孔颖达疏:“美石似玉者也。玉、石,其质相类,美恶别名也。”秦代文字中“琨”字或可作“瑻”,从“贯”声。“昆”、“贯”古音相近,故用作声符可互换。“瑻”字亦沿用至现代。(白于蓝)\\n\\n珉 mín 明组、文部;明组、真韵、武巾切。\\n[glyph:g008]¹—珉\\n《说文》小篆 楷书\\n1《说文》13页。\\n形声字。从玉,民声。本义是指似玉之美石。《说文》:“珉,石之美者。”《山海经·中山经》:“岐山,其阳多赤金,其阴多白珉。”郭璞注:“石似玉者。”《荀子·法行》:“虽有珉之雕雕,不若玉之章章。”(白于蓝)\\n\\n瑶 yáo 喻组、宵部;以组、宵韵、余昭切。\\n[glyph:g009]¹—[glyph:g010]²—瑶\\n《说文》小篆 汉 楷书\\n1《说文》13页。2《篆隶表》22页。\\n形声字。从玉,䍃声。本义是指美玉。《说文》:“瑶,玉之美者。”《诗·卫风·木瓜》:“投我以木瓜,报之以琼瑶。”(白于蓝)\\n\\n珠 zhū 章组、侯部;章组、虞韵、章俱切。\\n[glyph:g011]¹—[glyph:g012]²—[glyph:g013]³—珠\\n战国 《说文》小篆 汉 楷书\\n1《战文编》17页。2《说文》13页。3《篆隶表》22页。\\n形声字。从玉,朱声。本义是指蚌壳体内所生的珍珠。《说文》:“珠,蚌之阴精也。”引申之亦可指似珠的宝石。《正字通·玉部》:“珠,历山楚水多白珠;蜀郡平泽出青珠,左思云‘青珠黄环’;西国琅玕碧珠;皆宝石名之以珠者也。”引申之又可指珠状的物品。如露珠、眼珠、汗珠等。(白于蓝)\\n\\n玚 dī 端组、药部;端组、锡韵、都历切。\\n[glyph:g014]¹—玚\\n《说文》小篆 楷书\\n1《说文》13页。\\n形声字。从玉,勺声。“玚琠”本义指明珠的光泽。《说文》:“玚,玚琠,明珠色。”沈涛古本考:“《文选·上林赋》注引:‘玚琠,明珠光也。’又《舞赋》注引:‘玚琠,珠光也。’” (白于蓝)\\n\\n22\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"《说文》小篆“玖”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"《说文》小篆“碧”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"汉代隶书/缪篆等体“碧”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"《说文》小篆“琨”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"汉代“琨”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"《说文》或体“瑻”字（从小篆）\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"汉代“瑻”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"《说文》小篆“珉”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"《说文》小篆“瑶”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"汉代“瑶”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"战国文字“珠”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"《说文》小篆“珠”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g013\", \"description\": \"汉代“珠”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g014\", \"description\": \"《说文》小篆“玚”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0034/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n35:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000035\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 35, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"78cf5f3551787293ef1a9e7fa34de90ac95adc41efb7297999796a49e6113159\", \"evidence_sha256\": \"fb125636b136d0701dcdd1e8d7beaa8693c870f5a4e3fed912b3cf6b06c65318\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"玖 碧 琨 珉 瑶 珠 珀 琛 珅 珧 玫 瑰 璣\\n\\n瓈(砾) l 来纽、药部;来纽、锡韵、郎击切。\\n[glyph:g001]1——瓈——砾\\n《说文》小篆 楷书 楷书\\n1《说文》13页。\\n形声字。从玉,樂声。“珀琛”指明珠的光泽。参“珀”字条。(白于蓝)\\n\\n珅 pín 并纽、真部;并纽、真韵、符真切。\\n[glyph:g002]1——珅\\n《说文》小篆 楷书\\n[glyph:g003]2——螭——滨\\n《说文》小篆 楷书 楷书\\n1、2《说文》13页。\\n形声字。从玉,比声。本义是指珍珠。《说文》:“珅,珠也。”《大戴礼记·保傅》:“珅珠以纳其间,琚瑀以杂之。”又可指蚌名。清段玉裁《说文解字注·玉部》:“珅,本是蚌名……韦昭曰:‘珅,蚌也。’”秦代文字中“珅”字或体作“螭(滨)”,从虫、宾声。“珅”既可指蚌名,故可从‘虫’表义。“比”、“宾”古音相近,故又可从“宾”声。(白于蓝)\\n\\n珧 yáo 喻纽、宵部;以纽、宵韵、余昭切。\\n[glyph:g004]1——珧\\n《说文》小篆 楷书\\n1《说文》13页。\\n形声字。从玉,兆声。本义是指一种海蚌,通称“江珧”。壳略呈三角形,表面苍黑色。甲壳可作饰物。《尔雅·释鱼》:“蜃,小者珧。”郭璞注:“珧,玉珧,即小蚌。”《正字通·玉部》:“江珧,形似蚌。壳中肉柱长寸许,似搔头尖,谓之江珧柱。甲可饰物。”引申之又可指蜃的甲壳,古时用作刀、弓等器物上的装饰。《说文》:“珧,蜃甲也。所以饰物也。”引申之又可专指弓名。《尔雅·释器》:“(弓)以金者谓之铣,以蜃者谓之珧,以玉者谓之主。”郭璞注:“用金、蚌、玉饰弓两头,因取其类以为名。”《楚辞·天问》:“冯珧利决,封豨是射。”王逸注:“珧,弓名。”(白于蓝)\\n\\n玫 méi 明纽、微部;明纽、灰韵、莫杯切。\\n[glyph:g005]1——玫2——玫\\n《说文》小篆 汉 楷书\\n1《说文》13页。2《篆隶表》23页。\\n形声字。从玉,文声。玫瑰,本义是指美玉名,又名火齐珠。《说文》:“玫,火齐,玫瑰也。”《文选·司马相如〈子虚赋〉》:“其石则赤玉玫瑰。”李善注引晋灼曰:“玫瑰,火齐珠也。”又可指美石名。《说文》:“玫,一日石之美者。”“玫瑰”又可指植物名,是一种落叶灌木,枝上有刺,花可制香料。唐白居易《草词毕遇芍药初开》:“菌萏泥连萼,玫瑰刺绕枝。”(白于蓝)\\n\\n瑰 guī 见纽、微部;见纽、灰韵、公回切。\\n[glyph:g006]1——[glyph:g007]2——瑰\\n《说文》小篆 汉 楷书\\n[glyph:g008]3——瓖\\n汉 楷书\\n1《说文》13页。2、3《篆隶表》23页。\\n形声字。从玉,鬼声。玫瑰,本义是指美玉。参“玫”字条。引申之又可指珍奇。《后汉书·班彪传附班固》:“因瑰材而究奇,抗应龙之虹梁。”李贤注引《埤苍》曰:“瑰玮,珍奇也。”又可指美好。《文选·傅毅〈舞赋〉》:“轶态横出,瑰姿谲起。”李善注:“瑰,美也。”汉代文字中“瑰”字有或体作“瓖”,从玉、襄声。这种或体亦沿用至现代。《集韵·灰韵》:“瑰,或作瓖。”康有为《大同书》戊第八章:“衣服壤异,无损公益。”(白于蓝)\\n\\n璣(玑) jī 见纽、微部;见纽、微韵、居依切。\\n[glyph:g009]1——[glyph:g010]2——璣——玑\\n《说文》小篆 汉 楷书 楷书\\n1《说文》13页。2《篆隶表》23页。\\n形声字。从玉,幾声。本义是指不圆的珠,或指小珠。《说文》:“玑,珠之不圜者也。”唐玄应《一切经音义》卷九引《字林》:“玑,小珠也。”又可指古代观测天象的仪器。《史记·五帝本纪》:“舜乃在璿玑玉衡,以齐七政。”张守节正义引蔡邕曰:“悬玑以象天,而以衡望之,转玑窥衡,以知星宿。”又引郑玄曰:“运转者为玑,持正者为衡。”又指星名,即北斗第三星。《史记·天官书》:“北斗七星。”司马贞索隐引《春秋运斗枢》云:“第一天枢,第二旋,第三玑……”(白于蓝)\\n\\n23\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"小篆《说文》「瓈」字，左玉右樂\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"小篆《说文》「珅」字，左玉右比\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"小篆《说文》「螭」字，左虫右宀下宾\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"小篆《说文》「珧」字，左玉右兆\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"小篆《说文》「玫」字，左玉右攴\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"小篆《说文》「瑰」字，左玉右鬼\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"汉代隶书「瑰」字，左王右鬼\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"汉代隶书「瓖」字，左王右襄\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"小篆《说文》「璣」字，左玉右幾\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"汉代隶书「璣」字，左王右幾\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0035/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n36:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000036\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 36, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"774822fd9d9a9348ede5ed938faafb7f8fc3c8e972314d234e5d90dd818b5b81\", \"evidence_sha256\": \"f91f90b183192b3aad76735b6372751b1263a5b187699691e025b50074d591b4\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"玉部\\n\\n琅 láng 来组、阳部；来组、唐韵、鲁当切。\\n[glyph:g001]¹—[glyph:g002]²—琅\\n《说文》小篆 汉 楷书\\n1《说文》13页。2《篆隶表》23页。\\n形声字。从玉,良声。琅玕,本义是指形状像珠的美玉或美石。《说文》:“琅,琅玕,似珠者。”《广韵·唐韵》:“琅,琅玕,玉名。”《书·禹贡》:“厥贡惟球、琳、琅玕。”孔传:“琅玕,石而似玉。”“琅”字又可指门环。《汉书·五行志中》:“木门仓琅根’,谓宫门铜锾。”颜师古注:“门之铺首及铜锾也。铜色青,故曰仓琅。铺首衔环,故谓之根。锾读与环同。”(白于蓝)\\n\\n瑚 hú 匣组、鱼部；匣组、模韵、户吴切。\\n[glyph:g003]¹—瑚\\n《说文》小篆 楷书\\n1《说文》13页\\n形声字。从玉,胡声。珊瑚,参“珊”字条。“瑚”字另可指古代宗庙中盛黍稷的礼器。《玉篇·玉部》:“瑚,《论语注》云:‘瑚琏,黍稷之器。夏曰瑚,殷曰琏。’或作瑚。”(白于蓝)\\n\\n珎 hàn 匣组、侵部；匣组、勘韵、胡绀切。\\n\\n珊 shān 心组、元部；心组、寒韵、苏干切。\\n[glyph:g004]¹—珊\\n《说文》小篆 楷书\\n1《说文》13页。\\n形声字,从玉,册声。珊瑚,由许多珊瑚虫分泌的石灰质骨骼聚集而成的东西,形状像树枝,多为红色,也有白色和黑色的。可供赏玩,也可作装饰品。《说文》:“珊,珊瑚,色赤,生于海,或生于山。”《史记·司马相如列传》:“玫瑰碧琳,珊瑚丛生。”张守节正义:“珊瑚生水底石边,大者树高三尺余,枝格交错,无有叶。”“珊珊”,象声词,形容玉、铃、钟、雨等发出的声音。《文选·宋玉〈神女赋〉》:“动雾縠以徐步兮,拂墀声之珊珊。”李周翰注:“珊珊,玉声也。”唐白居易《题卢秘书夏日新栽竹二十韵》:“碧笼烟幕幕,珠洒雨珊珊。”(白于蓝)\\n\\n晗¹—晗\\n《说文》小篆 楷书\\n1《说文》13页。\\n形声字。从玉,含声。本义是指古代含在死者口中的珠、玉、贝等物。经典多作“含”。《说文》:“琀,送死口中玉也。”桂馥义证:“《说苑》:口实曰晗。天子含实以珠,诸侯以玉,大夫以璧,士以贝,庶人以谷实。”《广韵·勘韵》:“晗,送死口中玉。亦作含。”《周礼·天官·玉府》:“大丧,共含玉……”(白于蓝)\\n\\n靈(灵) líng 来组、耕部；来组、青韵、郎丁切。\\n[glyph:g005]¹—[glyph:g006]²—[glyph:g007]³—[glyph:g008]⁵—靈\\n春秋 战国 《说文》小篆 汉 楷书\\n[glyph:g009]⁴—[glyph:g010]⁶—靈\\n《说文》或体 汉 楷书\\n灵\\n楷书\\n1《金文编》26页。2《战文编》17页。3、4《说文》13页。5、6《篆隶表》24页。\\n形声字。从玉,霝声。同“靈”。《说文》:“靈,靈或从巫。”邵瑛群经正字:“今经典多从或体。”本义是指古代楚人跳舞降神的巫。《说文》:“靈,靈巫,以玉事神。”《楚辞·九歌·东皇太一》:“靈偃蹇兮姣服,芳菲菲兮满堂。”王逸注:“靈,谓巫也。”王国维《宋元戏曲考·上古至五代之戏剧》:“古之所谓巫,楚人谓之靈。”引申之又可指神灵。《玉篇·巫部》:“靈,神靈也。”引申之又可指福、祐。《广雅·释言》:“靈,福也。”《玉篇·玉部》:“靈,祐也。”引申之又可指善。《广雅·释诂一》:“靈,善也。”引申之又可指聪明、通晓事理。《庄子·天地》:“大惑者终身不解,大愚者终身不靈。”陆德明释文引司马彪云:“靈,晓也。”杨树达《积微居小学述林》卷五:“靈,明慧通解之义。”引申之又可指灵活、灵巧,如灵敏、机灵、心灵手巧等。春秋文字“靈”字作“[glyph:g005]”,从示表义,与“靈”字本义本指“事神”有关。秦代文字中“靈”字已出现“靈”这一或体。当简化字作“灵”。(白于蓝)\\n\\n珈 jiā 见组、歌部；见组、麻韵、古牙切。\\n[glyph:g011]¹—[glyph:g012]²—珈\\n战国 《说文》新附 楷书\\n1《金文编》26页。2《说文》14页。\\n形声字。从玉,加声。本义是指古代妇女的一种首\\n\\n24\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"小篆“琅”字，左玉右良\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"汉代隶书“琅”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"小篆“瑚”字，左玉右胡\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g004\", \"description\": \"小篆“珊”字，左玉右册\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g005\", \"description\": \"春秋金文“靈”字，上雨下示周围若干点或口\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g006\", \"description\": \"战国文字“靈”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g007\", \"description\": \"小篆“靈”字正体，从玉霝声\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g008\", \"description\": \"汉代隶书“靈”字正体，从玉\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g009\", \"description\": \"小篆“靈”字或体，从巫，即靈\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g010\", \"description\": \"汉代隶书“靈”字或体，从巫\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g011\", \"description\": \"战国文字“珈”字\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g012\", \"description\": \"《说文》新附小篆“珈”字，左玉右加\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0036/source.png\", \"source_bbox_xyxy\": null}], \"block_anchors\": [], \"entry_metadata\": \"not_extracted\", \"uncertainties\": [\"Headword '晗' and subsequent text show variations between '晗' and '琀' (with jade radical); transcription follows visible print shapes.\"], \"review_queue\": [], \"review\": null, \"spatial_repair_warnings\": [], \"use\": \"provisional_research_lead_inspect_original_page\"}\n41:{\"schema_version\": 2, \"page_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721:000041\", \"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"book\": {\"book_id\": \"sha256:610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"pdf_sha256\": \"610f098b7383499e15005c51bf5908d327b3188e274cc7a1784089e9af80a721\", \"source_pdf_paths\": [\"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\"], \"current_source_filename\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"title\": null, \"author\": null, \"editor\": null, \"edition\": null, \"year\": null, \"publisher\": null, \"volume\": null, \"isbn\": null, \"metadata_provenance\": {}, \"total_pdf_pages\": 1435}, \"source_file\": \"字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"source_pdf\": \"/home/catalin/hanzi-etymology-books/字源 - 李学勤 - 天津古籍出版社 (3 volumes combined) -- 《字源》·李学勤·天津古籍出版社·2012_pdf -- 全三册, 2012 -- 天津：天津古籍出版社；沈阳：辽宁人民出版社 -- isbn13 9787552800692 -- 3dde16e8457f7b.pdf\", \"pdf_page_1based\": 41, \"printed_page\": null, \"metadata_provenance\": null, \"source_sha256\": \"26143acfc00f217895731808f0806be8e1370b4fb95ba498310d975d3d60d604\", \"evidence_sha256\": \"6c561e58daf0d502acd8cf8fa980b93237ae09b414e0a5a231512c750e3d8229\", \"ocr_review_status\": \"unreviewed\", \"review_dimensions\": {\"transcription\": \"unreviewed\", \"layout\": \"not_requested\", \"glyph_identification\": \"page_references_only_no_crops\"}, \"text\": \"中 屮 屯 每 毒 芬 熏 艸\\n\\n每 měi 明组、之部；明组、贿韵、武罪切。\\n\\n[glyph:g001] 商\\n[glyph:g002] 商\\n[glyph:g003] 商\\n[glyph:g004] 4 西周\\n[glyph:g005] 5 西周\\n[glyph:g006] 6 春秋\\n[glyph:g007] 7 战国\\n[glyph:g008] 8 《说文》小篆\\n[glyph:g009] 9 汉\\n每 楷书\\n\\n1、2、3《甲文编》19页。4、5《金文编》32页。6《类编》44页。7《战文编》23页。8《说文》15页。9《篆隶表》29页。\\n象形字。像女子头上笄饰。“每”字甲骨文从女或母，上部所从“[glyph:g010]”或“[glyph:g011]”像笄饰形。西周文字至秦代文字基本沿袭甲骨文的写法，唯所从女或母由原先跪坐之形演变为站立之形。汉代文字中，则将原字形上下割裂，上部演变为“[glyph:g012]”，下部作“[glyph:g013]”。现代文字基本沿袭汉代文字的写法，但上部变作“一”，下部则从“母”。“每”字古代可指草木茂盛。《说文》：“每，艸盛上出也。”又可指各个，即全体中的任何一个。《字汇·毋部》：“每，各也。”《孟子·离娄下》：“故为政者，每人而悦之，日亦不足矣。”又可指每一次，即反复动作中的任何一次。《诗·秦风·权舆》：“於，我乎！每食四簋，今也每食不饱。”又可指经常、屡次。《玉篇·中部》：“每，事屡也。”《字汇·毋部》：“每，常也，屡也，频也。”还可当虽然讲。《广韵·贿韵》：“每，虽也。”《诗·小雅·常棣》：“每有良朋，况也永叹。”金文中“每”字常假借为“敏”，如晋姜鼎：“每(敏)扬\\n\\n毒 dú 定组、觉部；定组、沃韵、徒沃切。\\n\\n[glyph:g014] 1 《说文》小篆\\n[glyph:g015] 2 汉\\n毒 楷书\\n\\n1《说文》15页。2《篆隶表》29页。\\n会意字。从屮，从毐。本义指毒草。《说文》：“毒，厚也。害人之艸，往往而生。”引申之亦可指毒物。《易·噬嗑》：“六三：噬腊肉，遇毒。”孔颖达疏：“毒者，苦恶之物也。”又可指毒害。《广韵·沃韵》：“毒，害也。”又可指苦痛。《广雅·释诂二》：“毒，痛也。”《书·汤诰》：“弗忍荼毒。”孔传：“荼毒，苦也，不能堪忍虑之甚。”又可指痛恨、憎恨。《后汉书·袁绍传》：“每念灵帝，令人愤毒。”(白于蓝)\\n\\n芬(芬) fēn 并组、文部；奉组、文韵、符分切。\\n\\n[glyph:g016] 1 《说文》小篆\\n[glyph:g017] 2 《说文》或体\\n[glyph:g018] 汉\\n芬 3 楷书\\n芬 楷书\\n\\n1、2《说文》15页。3《篆隶表》29页。\\n形声字。从屮，分声。“芬”字《说文》篆文作“[glyph:g019]”，上从“屮”；或体作“芬”，上从“艸”。“屮”、“艸”在用作形声字的表义偏旁时常可相通。汉代文字承袭《说文》或体的写法，沿袭至今。本义是指香气。《说文》：“芬，艸初生，其香分布。”引申之亦比喻美名或美德。《晋书·桓彝传论》：“扬芬千载之上，沦骨九泉之下。”(白于蓝)\\n\\n熏 xūn 晓组、文部；晓组、文韵、许云切。\\n\\n[glyph:g020] 1 西周\\n[glyph:g021] 2 战国\\n[glyph:g022] 3 《说文》小篆\\n[glyph:g023] 4 汉\\n熏 楷书\\n\\n1《金文编》33页。2《古文典》1312页。3《说文》15页。4《篆隶表》29页。\\n会意字。“熏”字西周文字作“[glyph:g024]”，会火自窗上出之意。战国文字作“[glyph:g025]”，下部变为“黑”字，盖会熏黑之意。秦代文字承袭战国文字。汉代文字则将上部之“[glyph:g026]”变为一横作“[glyph:g027]”。现代文字又在其最上端加一“一”，变作“熏”。本义即指火烟上出。《说文》：“熏，火烟上出也。”引申之又可指用火烟熏炙。《诗·豳风·七月》：“穹室熏鼠，塞向墐户。”又可指烧灼。《集韵·问韵》：“熏，灼也。”(白于蓝)\\n\\n艸部\\n\\n艸 cǎo 清组、幽部；清组、皓韵、采老切。\\n\\n[glyph:g028] 1 战国\\n[glyph:g029] 2 《说文》小篆\\n艸 楷书\\n艹 楷书\\n\\n1《汉语字形表》19页。2《说文》15页。\\n象形字。像草形。本义同“草”。《说文》：“艸，百卉也。”《广韵·皓韵》：“草，《说文》作艸，百卉也。经典相承作草。”“草”字实即在艸字下追加早声而形成的分化字。今“草”行而“艸”废，“艸”字仅在偏旁中使用，并简化作“艹”。(白于蓝)\\n\\n29\", \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0041/source.png\", \"reading_json\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0041/ocr.json\", \"manifest\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0041/ocr.json\", \"original_evidence_sha256\": null, \"correction_provenance\": null, \"glyph_assets\": [{\"id\": \"g001\", \"description\": \"甲骨文“每”字，商代形体一\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0041/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g002\", \"description\": \"甲骨文“每”字，商代形体二\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0041/source.png\", \"source_bbox_xyxy\": null}, {\"id\": \"g003\", \"description\": \"甲骨文“每”字，商代形体三\", \"kind\": \"historical_form\", \"path\": null, \"source_scan\": \"/home/catalin/hanzi-etymology-books/research-ocr/ziyuan-full/page-0041/source.png\", \"source_bbox_xyxy